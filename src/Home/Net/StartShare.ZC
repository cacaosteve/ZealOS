/* Internet Sharing: static + inject gateway MAC from Mac tcpdump.
   tcpdump showed: Reply 192.168.2.1 is-at f6:d4:88:56:fd:65
   while ZealOS RX was jammed (no rx#N ARP). Inject unblocks ICMP TX;
   new TG3 bounce should also let real ARP replies land.
*/
Cd(__DIR__);;
#include "Load"

U8 gmac[6];
U32 gw;

"==== StartShare: static + gateway ARP inject ====\n";
NetStaticConfigure("192.168.2.50", "192.168.2.1", "255.255.255.0");

gmac[0] = 0xF6;
gmac[1] = 0xD4;
gmac[2] = 0x88;
gmac[3] = 0x56;
gmac[4] = 0xFD;
gmac[5] = 0x65;
if (!IPV4AddressParse("192.168.2.1", &gw))
	"StartShare: bad gateway parse\n";
else
{
	ARPCachePut(gw, gmac);
	"ARP inject 192.168.2.1 -> %02X:%02X:%02X:%02X:%02X:%02X\n",
		gmac[0], gmac[1], gmac[2], gmac[3], gmac[4], gmac[5];
}

NetRep;
"\nPinging 192.168.2.1 (any key to stop)...\n";
"Watch for: Received reply  (and ideally TG3: rx#N ARP / ICMP)\n\n";
Ping("192.168.2.1");
