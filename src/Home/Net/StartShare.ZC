/* Internet Sharing: static + inject gateway MAC.
   Do not leave NetLog popups / stall spam stealing the keyboard.
*/
Cd(__DIR__);;
#include "Load"

U8 gmac[6];
U32 gw;

net_log_enabled = FALSE; /* kills NET HANDLER popup spam */
FlushMessages; /* drop buffered keys so Ping is not stopped instantly */

"==== StartShare: static + gateway ARP inject ====\n";
NetStaticConfigure("192.168.2.50", "192.168.2.1", "255.255.255.0");

gmac[0] = 0xF6;
gmac[1] = 0xD4;
gmac[2] = 0x88;
gmac[3] = 0x56;
gmac[4] = 0xFD;
gmac[5] = 0x65;
if (!IPV4AddressParse("192.168.2.1", &gw))
	"StartShare: bad gateway parse\n";
else
{
	ARPCachePut(gw, gmac);
	"ARP inject 192.168.2.1 -> %02X:%02X:%02X:%02X:%02X:%02X\n",
		gmac[0], gmac[1], gmac[2], gmac[3], gmac[4], gmac[5];
}

/* Re-announce ourselves ΓÇö Mac ARP for .50 stays incomplete if our RX
   never answers who-has; GARP lets replies flow for the RX test. */
ARPLocalIPV4Set(IPV4AddressGet());
Sleep(50);
ARPLocalIPV4Set(IPV4AddressGet());

NetRep;
"\nType:  Ping(\"192.168.2.1\");\n";
"Leave keyboard alone until you see Sending Ping request #...\n";
"Any key stops ping. Close NET HANDLER popups with Shift-Esc.\n";
"If Mac still has no replies: sudo arp -s 192.168.2.50 "
"38:c9:86:4e:94:cb ifscope bridge101\n";
