I64 net_queue_drain_lock = 0;

U0 IPV4Handler(CEthernetFrame *ethernet_frame)
{
	CIPV4Packet packet;

	if (IPV4PacketParse(&packet, ethernet_frame) < 0)
		return;

	ARPCachePut(packet.source_ip_address, ethernet_frame->source_address);

	switch (packet.protocol)
	{
		case IP_PROTOCOL_ICMP:
			ICMPHandler(&packet);
			break;

		case IP_PROTOCOL_TCP:
			TCPHandler(&packet);
			break;

		case IP_PROTOCOL_UDP:
			UDPHandler(&packet);
			break;

		default:
			NetErr("IPV4 HANDLER: Unrecognized protocol: 0x%X", packet.protocol);
			break;
	}
}

U0 NetQueueEntryHandle(CNetQueueEntry *entry)
{
	CEthernetFrame ethernet_frame;

	if (EthernetFrameParse(&ethernet_frame, entry->frame, entry->packet_length) < 0)
		return;

	U8 *mac = EthernetMACGet();
	Bool is_our_mac = !MemCompare(mac, ethernet_frame.destination_address, MAC_ADDRESS_LENGTH); // check the RX packet MAC against local MAC
	Bool is_broadcast = !MemCompare(ethernet_globals.ethernet_broadcast, ethernet_frame.destination_address, MAC_ADDRESS_LENGTH); // check the RX packet MAC against broadcast MAC

	if (!is_our_mac && !is_broadcast)
		return;

	switch (ethernet_frame.ethertype)
	{
		case ETHERTYPE_ARP:
			ARPHandler(&ethernet_frame);
			break;

		case ETHERTYPE_IPV4:
			IPV4Handler(&ethernet_frame);
			break;

		case ETHERTYPE_IPV6:
			break;

		default:
			break;
	}
}

U0 NetQueueDrain()
{
	CNetQueueEntry *entry;

	/* The TG3 poller and the software interrupt can arrive together.  Keep
	   protocol handlers serialized, not merely the individual queue pulls. */
	if (LBts(&net_queue_drain_lock, 0))
		return;
	PUSHFD
	CLI
	entry = NetQueuePull;
	POPFD
	while (entry != NULL)
	{
		NetQueueEntryHandle(entry);
		Free(entry);
		PUSHFD
		CLI
		entry = NetQueuePull;
		POPFD
	}
	LBtr(&net_queue_drain_lock, 0);
}

interrupt U0 NetHandler()
{
	// no per-packet NetLog: DocPrint from this IRQ faults under a flood
	NetQueueDrain;

	*(dev.uncached_alias + LAPIC_EOI)(U32*) = 0;
}

U0 NetHandlerInit()
{
	IntEntrySet(I_NETHANDLER, &NetHandler);
	net_rx_drain = &NetQueueDrain;
}

NetHandlerInit;
