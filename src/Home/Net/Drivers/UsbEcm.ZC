/*	USB CDC-ECM Ethernet driver
	Uses Kernel USB $LK,"UsbEcmSend",A="MN:UsbEcmSend"$ / $LK,"UsbEcmRecv",A="MN:UsbEcmRecv"$.
	PCI-miss fallback from $LK,"Run.ZC",A="FI:::/Home/Net/Drivers/Run.ZC"$ (TG3 wins when present).
	Exports NetDriver* + EthernetFrameAllocate/MACGet (PCNet-style; do not redefine EthernetFrameFinish).
*/

#define USB_ECM_TX_SLOTS	8

class CUsbEcmNet
{
	U8	mac_address[6];
	U8 *tx_bufs;			//uncached alias view
	U8 *tx_bufs_phys;
	I64	tx_length[USB_ECM_TX_SLOTS];
	I64	tx_next;
	Bool rx_task_running;
} usb_ecm_net;

U0 UsbEcmRxTask(I64 dummy=0)
{
	U8 *frame;
	I64	len;

	no_warn dummy;
	frame = MAlloc(ETHERNET_FRAME_SIZE);
	usb_ecm_net.rx_task_running = TRUE;
	while (UsbEcmPresent)
	{
		len = UsbEcmRecv(frame, ETHERNET_FRAME_SIZE);
		if (len > 0)
			NetQueuePush(frame, len);
		else
			Sleep(2);
	}
	usb_ecm_net.rx_task_running = FALSE;
	Free(frame);
}

I64 UsbEcmTransmitPacketAllocate(U8 **packet_buffer_out, I64 length)
{
	I64 slot = usb_ecm_net.tx_next % USB_ECM_TX_SLOTS;

	usb_ecm_net.tx_next++;
	usb_ecm_net.tx_length[slot] = length;
	*packet_buffer_out = usb_ecm_net.tx_bufs_phys + slot * ETHERNET_FRAME_SIZE;
	return slot;
}

U0 NetDriverTransmitPacketFinish(I64 de_index)
{
	I64 slot = de_index % USB_ECM_TX_SLOTS;
	I64 len = usb_ecm_net.tx_length[slot];
	U8 *frame = usb_ecm_net.tx_bufs + slot * ETHERNET_FRAME_SIZE;

	if (len > 0)
		UsbEcmSend(frame, len);
}

I64 NetDriverPacketBufferGet(I64 de_index)
{
	I64 slot = de_index % USB_ECM_TX_SLOTS;
	return usb_ecm_net.tx_bufs_phys + slot * ETHERNET_FRAME_SIZE;
}

I64 NetDriverPacketLengthGet(I64 de_index)
{
	I64 slot = de_index % USB_ECM_TX_SLOTS;
	return usb_ecm_net.tx_length[slot];
}

U8 *EthernetMACGet()
{
	return usb_ecm_net.mac_address;
}

I64 EthernetFrameAllocate(U8 **packet_buffer_out,
	U8 *source_address,
	U8 *destination_address,
	U16 ethertype,
	I64 packet_length)
{
	U8 *ethernet_frame;
	I64 de_index;

	if (packet_length < ETHERNET_MIN_FRAME_SIZE)
		packet_length = ETHERNET_MIN_FRAME_SIZE;

	de_index = UsbEcmTransmitPacketAllocate(&ethernet_frame,
		ETHERNET_MAC_HEADER_LENGTH + packet_length);
	if (de_index < 0)
	{
		NetErr("UsbEcm: EthernetFrameAllocate failed");
		return -1;
	}

	ethernet_frame += dev.uncached_alias;
	MemSet(ethernet_frame, 0, ETHERNET_FRAME_SIZE);
	MemCopy(ethernet_frame, destination_address, MAC_ADDRESS_LENGTH);
	MemCopy(ethernet_frame + MAC_ADDRESS_LENGTH, source_address, MAC_ADDRESS_LENGTH);
	ethernet_frame[ETHERNET_ETHERTYPE_OFFSET] = ethertype >> 8;
	ethernet_frame[ETHERNET_ETHERTYPE_OFFSET + 1] = ethertype & 0xFF;
	*packet_buffer_out = ethernet_frame + ETHERNET_MAC_HEADER_LENGTH;
	return de_index;
}

U0 NetStop()
{
}

U0 NetStart()
{
}

U0 UsbEcmNetInit()
{
	MemSet(&usb_ecm_net, 0, sizeof(CUsbEcmNet));

	if (!UsbEcmPresent)
	{
		NetErr("UsbEcm: no CDC-ECM NIC bound");
		return;
	}

	UsbEcmMacAddr(usb_ecm_net.mac_address);
	NetLog("UsbEcm: MAC %02X:%02X:%02X:%02X:%02X:%02X",
			usb_ecm_net.mac_address[0], usb_ecm_net.mac_address[1],
			usb_ecm_net.mac_address[2], usb_ecm_net.mac_address[3],
			usb_ecm_net.mac_address[4], usb_ecm_net.mac_address[5]);

	usb_ecm_net.tx_bufs_phys = CAllocAligned(USB_ECM_TX_SLOTS * ETHERNET_FRAME_SIZE,
			4096, Fs->code_heap);
	usb_ecm_net.tx_bufs = usb_ecm_net.tx_bufs_phys + dev.uncached_alias;

	Spawn(&UsbEcmRxTask,, "UsbEcmRx");
	NetLog("UsbEcm: RX task spawned");
}

UsbEcmNetInit;
