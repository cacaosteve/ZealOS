/*	Broadcom BCM57766 (tg3) Ethernet - Mac mini 2014 (Macmini7,1)
	Clean-room ZealC driver. Register/flow reference only from Linux tg3;
	do not paste GPL sources here.

	PCI 14e4:1686. Exports NetDriver* + EthernetFrameAllocate/MACGet
	(PCNet-style; do not redefine EthernetFrameFinish).
*/

#define TG3_CMDf_MEMEN	1
#define TG3_CMDf_BMEN	2
#define TG3_CMDF_MEMEN	(1 << TG3_CMDf_MEMEN)
