#define TG3_TX_PENDING			64

#define TG3_MODE_ENABLE			0x00000002

class CTG3TxDesc
{
	U32 addr_hi;
	U32 addr_lo;
	U32 len_flags;
	U32 vlan_tag;
};

class CTG3RxDesc
{
	U32 addr_hi;
	U32 addr_lo;
	U32 idx_len;
	U32 type_flags;
	U32 ip_tcp_csum;
	U32 err_vlan;
	U32 reserved;
	U32 opaque;
};

class CTG3
{
	CPCIDev *pci;
	U64 mmio;
	U8 mac_address[6];
	U32 chip_rev;
	U32 asic_rev;
	Bool init_ok;
	Bool firmware_loaded;
	Bool link_up;
	I64 phy_addr;

	I64 tx_prod;
	I64 tx_cons;
	I64 rx_prod;
	I64 rx_cons;
	I64 rx_std_prod;

	CTG3TxDesc *tx_ring;
	U8 *tx_ring_phys;
	CTG3RxDesc *rx_std;
	U8 *rx_std_phys;
	CTG3RxDesc *rx_ret;
	U8 *rx_ret_phys;

	U8 *tx_bufs;
	U8 *tx_bufs_phys;
	U8 *rx_bufs;
	U8 *rx_bufs_phys;

	U8 *status_phys;
	U32 *status; /* uncached view of TG3_HW_STATUS_SIZE */

	I64 tx_length[TG3_TX_PENDING];
	I64 poll_task;
} tg3;

U32 TG3Read(U32 off)
{
	U32 *mmio = tg3.mmio + off;
	return *mmio;
}

U0 TG3Write(U32 off, U32 val)
{
	U32 *mmio = tg3.mmio + off;
	*mmio = val;
}

U0 TG3WriteFlush(U32 off, U32 val)
{
	TG3Write(off, val);
	TG3Read(off);
}

U0 TG3MboxWrite(U32 mbox, U32 val)
{
	TG3Write(mbox + TG3_64BIT_LOW, val);
}

U0 TG3MboxWriteFlush(U32 mbox, U32 val)
{
	TG3Write(mbox + TG3_64BIT_LOW, val);
	TG3Read(mbox + TG3_64BIT_LOW);
}

U0 TG3MiscHostCtrl(U32 extra=0)
{/* WORD_SWAP + INDIR_ACCESS required for MEM_WIN on many tg3 parts. */
	TG3WriteFlush(TG3PCI_MISC_HOST_CTRL,
		TG3_MHC_CLEAR_INT | TG3_MHC_WORD_SWAP |
		TG3_MHC_INDIR_ACCESS | TG3_MHC_PCISTATE_RW | extra);
}

U0 TG3MemWrite(U32 addr, U32 val)
{/* Prefer PCI config MEM_WIN (Linux SRAM_USE_CONFIG). MMIO window
	readback stayed 0 on Mac mini even with MEMARB enabled. */
	I64 bus = tg3.pci->bus, dev = tg3.pci->dev, fun = tg3.pci->fun;

	PCIWriteU32(bus, dev, fun, TG3PCI_MEM_WIN_BASE_ADDR, addr);
	PCIWriteU32(bus, dev, fun, TG3PCI_MEM_WIN_DATA, val);
	PCIWriteU32(bus, dev, fun, TG3PCI_MEM_WIN_BASE_ADDR, 0);
}

U32 TG3MemRead(U32 addr)
{
	I64 bus = tg3.pci->bus, dev = tg3.pci->dev, fun = tg3.pci->fun;
	U32 val;

	PCIWriteU32(bus, dev, fun, TG3PCI_MEM_WIN_BASE_ADDR, addr);
	val = PCIReadU32(bus, dev, fun, TG3PCI_MEM_WIN_DATA);
	PCIWriteU32(bus, dev, fun, TG3PCI_MEM_WIN_BASE_ADDR, 0);
	return val;
}

Bool TG3MemWinSelfTest()
{
	U32 magic = TG3_FW_MBOX_MAGIC1, got;

	/* Do not touch FIRMWARE_MBOX ΓÇö bootcode signals ~MAGIC1 there. */
	TG3MemWrite(TG3_NIC_SRAM_MEMWIN_TEST, magic);
	got = TG3MemRead(TG3_NIC_SRAM_MEMWIN_TEST);
	NetLog("TG3: MEM_WIN selftest wrote=0x%X read=0x%X", magic, got);
	"TG3: MEM_WIN selftest read=0x%X\n", got;
	return got == magic;
}

U0 TG3MemArbEnable()
{
	U32 val = TG3Read(TG3_MEMARB_MODE);
	TG3WriteFlush(TG3_MEMARB_MODE, val | TG3_MEMARB_MODE_ENABLE);
	NetLog("TG3: MEMARB_MODE=0x%X", TG3Read(TG3_MEMARB_MODE));
}

U0 TG3PcieTxHangFix()
{/* Linux 57765_CLASS: CPMU padrng + PCIe FTSMAX ΓÇö "Fix transmit hangs". */
	U32 val, grc;

	val = TG3Read(TG3_CPMU_PADRNG_CTL);
	TG3WriteFlush(TG3_CPMU_PADRNG_CTL, val | TG3_CPMU_PADRNG_CTL_RDIV2);

	grc = TG3Read(TG3_GRC_MODE);
	TG3Write(TG3_GRC_MODE, (grc & ~(TG3_GRC_MODE_PCIE_PL_SEL | TG3_GRC_MODE_PCIE_DL_SEL)) |
		TG3_GRC_MODE_PCIE_DL_SEL);
	val = TG3Read(TG3_PCIE_TLDLPL_PORT + TG3_PCIE_DL_LO_FTSMAX);
	val = (val & ~TG3_PCIE_DL_FTSMAX_MSK) | TG3_PCIE_DL_FTSMAX_VAL;
	TG3Write(TG3_PCIE_TLDLPL_PORT + TG3_PCIE_DL_LO_FTSMAX, val);
	TG3WriteFlush(TG3_GRC_MODE, grc);

	val = TG3Read(TG3_CPMU_LSPD_10MB_CLK);
	val = (val & ~TG3_CPMU_10MB_MACCLK_MASK) | TG3_CPMU_10MB_MACCLK_6_25;
	TG3WriteFlush(TG3_CPMU_LSPD_10MB_CLK, val);
	NetLog("TG3: 57765 TX-hang workarounds applied");
}

U0 TG3BDInfoWriteMMIO(U32 base, U32 host_lo, U32 maxlen_flags, U32 nic_addr)
{
	TG3Write(base + TG3_BDINFO_HOST_ADDR + TG3_64BIT_HIGH, 0);
	TG3Write(base + TG3_BDINFO_HOST_ADDR + TG3_64BIT_LOW, host_lo);
	TG3Write(base + TG3_BDINFO_MAXLEN_FLAGS, maxlen_flags);
	if (nic_addr)
		TG3Write(base + TG3_BDINFO_NIC_ADDR, nic_addr);
}

U0 TG3BDInfoWriteSRAM(U32 sram_off, U32 host_lo, U32 maxlen_flags)
{/* 5705+ (incl 57766): do not write BDINFO_NIC_ADDR via MEM_WIN. */
	TG3MemWrite(sram_off + TG3_BDINFO_HOST_ADDR + TG3_64BIT_HIGH, 0);
	TG3MemWrite(sram_off + TG3_BDINFO_HOST_ADDR + TG3_64BIT_LOW, host_lo);
	TG3MemWrite(sram_off + TG3_BDINFO_MAXLEN_FLAGS, maxlen_flags);
}

CPCIDev *TG3PCIDevFind()
{
	return PCIDevFind(,, 0x14E4, 0x1686);
}

U0 TG3MACReadHW()
{
	U32 hi = TG3Read(TG3_MAC_ADDR_0_HIGH);
	U32 lo = TG3Read(TG3_MAC_ADDR_0_LOW);

	tg3.mac_address[0] = (hi >> 8) & 0xFF;
	tg3.mac_address[1] = hi & 0xFF;
	tg3.mac_address[2] = (lo >> 24) & 0xFF;
	tg3.mac_address[3] = (lo >> 16) & 0xFF;
	tg3.mac_address[4] = (lo >> 8) & 0xFF;
	tg3.mac_address[5] = lo & 0xFF;
}

U0 TG3MACWriteHW()
{
	U32 hi = (tg3.mac_address[0] << 8) | tg3.mac_address[1];
	U32 lo = (tg3.mac_address[2] << 24) | (tg3.mac_address[3] << 16) |
		(tg3.mac_address[4] << 8) | tg3.mac_address[5];
	I64 i;
	U32 seed;

	/* Linux programs MAC into slots 0..3. */
	for (i = 0; i < 4; i++)
	{
		TG3Write(TG3_MAC_ADDR_0_HIGH + i * 8, hi);
		TG3Write(TG3_MAC_ADDR_0_LOW + i * 8, lo);
	}
	seed = (tg3.mac_address[0] + tg3.mac_address[1] + tg3.mac_address[2] +
		tg3.mac_address[3] + tg3.mac_address[4] + tg3.mac_address[5]) &
		0x3FF;
	TG3Write(TG3_MAC_TX_BACKOFF_SEED, seed);
}

Bool TG3PhyRead(I64 phy, I64 phy_reg, U32 *val_out)
{/* "reg" is a ZealC keyword ΓÇö do not use it as an identifier. */
	U32 frame;
	I64 i;

	frame = TG3_MI_COM_CMD_READ | TG3_MI_COM_START |
		((phy & 0x1F) << TG3_MI_COM_PHY_SHIFT) |
		((phy_reg & 0x1F) << TG3_MI_COM_REG_SHIFT);
	TG3WriteFlush(TG3_MAC_MI_COM, frame);
	for (i = 0; i < 5000; i++)
	{
		frame = TG3Read(TG3_MAC_MI_COM);
		if (!(frame & TG3_MI_COM_BUSY))
		{
			*val_out = frame & TG3_MI_COM_DATA_MASK;
			return TRUE;
		}
		Busy(10);
	}
	return FALSE;
}

Bool TG3PhyWrite(I64 phy, I64 phy_reg, U32 val)
{
	U32 frame;
	I64 i;

	frame = TG3_MI_COM_CMD_WRITE | TG3_MI_COM_START |
		((phy & 0x1F) << TG3_MI_COM_PHY_SHIFT) |
		((phy_reg & 0x1F) << TG3_MI_COM_REG_SHIFT) |
		(val & TG3_MI_COM_DATA_MASK);
	TG3WriteFlush(TG3_MAC_MI_COM, frame);
	for (i = 0; i < 5000; i++)
	{
		frame = TG3Read(TG3_MAC_MI_COM);
		if (!(frame & TG3_MI_COM_BUSY))
			return TRUE;
		Busy(10);
	}
	return FALSE;
}

Bool TG3PhyInit()
{/* Reset internal copper PHY and restart autoneg. Mac mini link needs this
	after CORECLK_RESET; without it DHCP Discover never gets Offers. */
	U32 id1 = 0, id2 = 0, bmsr = 0, adv, ctrl1000;
	I64 phy, i;
	Bool ok;

	TG3WriteFlush(TG3_MAC_MI_MODE, TG3_MI_MODE_BASE);
	Busy(80);

	tg3.phy_addr = -1;
	for (phy = 1; phy >= 0; phy--)
	{
		if (TG3PhyRead(phy, TG3_MII_PHYSID1, &id1) &&
			TG3PhyRead(phy, TG3_MII_PHYSID2, &id2) &&
			id1 != 0xFFFF && id2 != 0xFFFF && (id1 | id2))
		{
			tg3.phy_addr = phy;
			break;
		}
	}
	if (tg3.phy_addr < 0)
	{
		NetErr("TG3: PHY not responding on MDIO");
		return FALSE;
	}
	NetLog("TG3: PHY addr=%d id=0x%04X%04X", tg3.phy_addr, id1, id2);
	"TG3: PHY id=0x%04X%04X addr=%d\n", id1, id2, tg3.phy_addr;

	if (!TG3PhyWrite(tg3.phy_addr, TG3_MII_BMCR, TG3_BMCR_RESET))
	{
		NetErr("TG3: PHY BMCR reset write failed");
		return FALSE;
	}
	for (i = 0; i < 1000; i++)
	{
		if (!TG3PhyRead(tg3.phy_addr, TG3_MII_BMCR, &bmsr))
			break;
		if (!(bmsr & TG3_BMCR_RESET))
			break;
		Busy(100);
	}

	adv = TG3_ADVERTISE_CSMA | TG3_ADVERTISE_10_HALF | TG3_ADVERTISE_10_FULL |
		TG3_ADVERTISE_100_HALF | TG3_ADVERTISE_100_FULL;
	ctrl1000 = TG3_ADVERTISE_1000_HALF | TG3_ADVERTISE_1000_FULL;
	TG3PhyWrite(tg3.phy_addr, TG3_MII_ADVERTISE, adv);
	TG3PhyWrite(tg3.phy_addr, TG3_MII_CTRL1000, ctrl1000);
	TG3PhyWrite(tg3.phy_addr, TG3_MII_BMCR,
		TG3_BMCR_ANENABLE | TG3_BMCR_ANRESTART);

	tg3.link_up = FALSE;
	for (i = 0; i < 50; i++)
	{
		ok = TG3PhyRead(tg3.phy_addr, TG3_MII_BMSR, &bmsr);
		ok = TG3PhyRead(tg3.phy_addr, TG3_MII_BMSR, &bmsr) && ok;
		if (ok && (bmsr & TG3_BMSR_LSTATUS))
		{
			tg3.link_up = TRUE;
			break;
		}
		Sleep(100);
	}

	TG3WriteFlush(TG3_MAC_MI_MODE, TG3_MI_MODE_BASE | TG3_MI_MODE_AUTO_POLL);
	Busy(80);

	if (tg3.link_up)
	{
		NetLog("TG3: link UP (BMSR=0x%X)", bmsr);
		"$$GREEN$$TG3: link UP$$FG$$\n";
	}
	else
	{
		NetWarn("TG3: link DOWN after PHY init (BMSR=0x%X) ΓÇö check cable", bmsr);
		"$$RED$$TG3: link DOWN (cable / switch?)$$FG$$\n";
	}
	return tg3.link_up;
}

U0 TG3LinkApply()
{/* Match MAC port mode to copper speed. AUX_STAT on this GPHY often returns
	garbage (saw 0xFF3C); prefer STAT1000 / sane AUX, else assume 1000/full. */
	U32 aux = 0, st1000 = 0, mac_mode, spd;
	Bool use_gmii = TRUE, full = TRUE;

	if (tg3.phy_addr < 0)
		return;
	TG3WriteFlush(TG3_MAC_MI_MODE, TG3_MI_MODE_BASE);
	Busy(40);
	TG3PhyRead(tg3.phy_addr, TG3_MII_AUX_STAT, &aux);
	TG3PhyRead(tg3.phy_addr, TG3_MII_STAT1000, &st1000);
	TG3WriteFlush(TG3_MAC_MI_MODE, TG3_MI_MODE_BASE | TG3_MI_MODE_AUTO_POLL);

	spd = aux & TG3_AUX_STAT_SPDMASK;
	if ((aux & TG3_AUX_STAT_LPASS) && spd >= TG3_AUX_STAT_10HALF &&
		spd <= TG3_AUX_STAT_1000FULL && (aux & 0xF000) != 0xF000)
	{
		use_gmii = (spd == TG3_AUX_STAT_1000FULL || spd == TG3_AUX_STAT_1000HALF);
		full = !!(aux & TG3_AUX_STAT_FULL) ||
			spd == TG3_AUX_STAT_10FULL || spd == TG3_AUX_STAT_100FULL ||
			spd == TG3_AUX_STAT_1000FULL;
	}
	else if (st1000 & (TG3_LPA_1000FULL | TG3_LPA_1000HALF))
	{
		use_gmii = TRUE;
		full = !!(st1000 & TG3_LPA_1000FULL);
	}
	else
	{/* Mac mini BCM57766 is gigabit; bogus AUX ΓåÆ stay GMII full. */
		use_gmii = TRUE;
		full = TRUE;
	}

	mac_mode = TG3_MAC_MODE_RXSTAT_ENABLE | TG3_MAC_MODE_TXSTAT_ENABLE |
		TG3_MAC_MODE_TDE_ENABLE | TG3_MAC_MODE_RDE_ENABLE |
		TG3_MAC_MODE_FHDE_ENABLE;
	if (use_gmii)
		mac_mode |= TG3_MAC_MODE_PORT_GMII;
	else
		mac_mode |= TG3_MAC_MODE_PORT_MII;
	if (!full)
		mac_mode |= TG3_MAC_MODE_HALF_DUPLEX;
	TG3WriteFlush(TG3_MAC_MODE, mac_mode);
	TG3WriteFlush(TG3_MAC_RX_MODE, TG3_RX_MODE_ENABLE | TG3_RX_MODE_PROMISC);
	TG3WriteFlush(TG3_MAC_TX_MODE,
		TG3_TX_MODE_ENABLE | TG3_TX_MODE_MBUF_LOCKUP_FIX);

	NetLog("TG3: AUX=0x%X STAT1000=0x%X MAC_MODE=0x%X gmii=%d",
		aux, st1000, mac_mode, use_gmii);
	"TG3: speed AUX=0x%X STAT1000=0x%X MAC_MODE=0x%X\n", aux, st1000, mac_mode;
}

U8 tg3_fw_57766[144] = {
	0x00,0x00,0x00,0x00,0x00,0x03,0x00,0x00,0xFF,0xFF,0xFF,0xFF,0xDE,0xCA,0xFB,0xAD,
	0x00,0x03,0x00,0x00,0x00,0x00,0x00,0x64,0x27,0x80,0x00,0x01,0xF7,0xF0,0x40,0x3E,
	0xCD,0x28,0x36,0x74,0x11,0x00,0x11,0x00,0xF7,0xFF,0x10,0x64,0x37,0x6E,0x00,0x01,
	0x27,0x60,0x00,0x00,0xF7,0xF0,0x7F,0xEA,0xF7,0xF0,0x00,0x04,0xF7,0xF0,0x00,0x18,
	0xCC,0x10,0x36,0x2C,0x00,0x18,0x00,0x18,0x17,0x80,0x00,0x00,0xF7,0xF0,0x00,0x08,
	0xC3,0x38,0x36,0xB0,0xF7,0xF0,0x00,0x04,0xC4,0x38,0x36,0xB0,0xC6,0x20,0x36,0xBC,
	0x00,0x00,0x00,0x09,0xCB,0x38,0x36,0xB0,0x17,0x80,0x00,0x01,0x17,0x60,0x00,0x0A,
	0xDE,0xCA,0xFB,0xAD,0x00,0x03,0xFD,0x00,0x00,0x00,0x00,0x10,0xD0,0x44,0xD8,0x16,
	0xDE,0xCA,0xFB,0xAD,0x00,0x03,0xFC,0xCC,0x00,0x00,0x00,0x10,0x02,0x30,0x02,0x02
};

Bool TG3FirmwareLoadFrom(U8 *fw, I64 size)
{
	U8 *ptr, *end;
	U32 base_addr, frag_len, i, nwords, *words;

	if (!fw || size < TG3_FW_HDR_LEN)
		return FALSE;
	words = fw(U32 *);
	base_addr = EndianU32(words[1]);
	frag_len = EndianU32(words[2]);
	if (base_addr != TG3_57766_FW_BASE_ADDR)
		return FALSE;

	if (frag_len == 0xFFFFFFFF)
	{
		ptr = fw + TG3_FW_HDR_LEN;
		end = fw + size;
		while (ptr + TG3_FW_HDR_LEN <= end)
		{
			words = ptr(U32 *);
			base_addr = EndianU32(words[1]);
			frag_len = EndianU32(words[2]);
			if (frag_len < TG3_FW_HDR_LEN || ptr + frag_len > end)
				break;
			nwords = (frag_len - TG3_FW_HDR_LEN) / 4;
			for (i = 0; i < nwords; i++)
				TG3MemWrite(TG3_57766_FW_BASE_ADDR + (base_addr & 0xFFFF) + i * 4,
					EndianU32(words[3 + i]));
			ptr += frag_len;
		}
	}
	else
	{
		nwords = (size - TG3_FW_HDR_LEN) / 4;
		for (i = 0; i < nwords; i++)
			TG3MemWrite(TG3_57766_FW_BASE_ADDR + i * 4, EndianU32(words[3 + i]));
	}
	return TRUE;
}

Bool TG3FirmwareLoad()
{/* EEE patch only when no NVRAM bootcode. Mac mini has bootcode ΓÇö skip. */
	U32 mbox = TG3MemRead(TG3_NIC_SRAM_FIRMWARE_MBOX);

	if (mbox == 0xB49A89AB)
	{
		NetLog("TG3: bootcode running (mbox=~MAGIC1), skip EEE patch");
		return FALSE;
	}
	if (TG3FirmwareLoadFrom(tg3_fw_57766, 144))
	{
		NetLog("TG3: loaded embedded tg357766.bin (144 bytes)");
		tg3.firmware_loaded = TRUE;
		return TRUE;
	}
	NetWarn("TG3: embedded firmware load failed");
	return FALSE;
}

U0 TG3PollFw()
{/* Wait for bootcode to signal ready after CORECLK_RESET. */
	I64 i;
	U32 val;

	for (i = 0; i < 10000; i++)
	{
		val = TG3MemRead(TG3_NIC_SRAM_FIRMWARE_MBOX);
		if (val == 0xB49A89AB) /* ~MAGIC1 */
			break;
		Busy(100);
	}
	NetLog("TG3: bootcode poll i=%d mbox=0x%X", i, val);
	"TG3: bootcode mbox=0x%X\n", val;
	if (val == TG3_NIC_SRAM_FIRMWARE_MBOX)
		NetErr("TG3: MEM_WIN echo (mbox==0xB50) ΓÇö enable MEMARB before SRAM access");

	TG3MemWrite(TG3_NIC_SRAM_FW_DRV_STATE_MBOX, TG3_DRV_STATE_START);
	Busy(100);
	TG3MemWrite(TG3_NIC_SRAM_FW_DRV_STATE_MBOX, TG3_DRV_STATE_START_DONE);
}

U0 TG3ChipReset()
{
	U16 cmd;
	I64 i;

	NetLog("TG3: chip reset begin");
	TG3MiscHostCtrl(TG3_MHC_MASK_PCI_INT);
	TG3MemArbEnable;
	/* Bootcode inverts MAGIC1 when init completes. */
	TG3MemWrite(TG3_NIC_SRAM_FIRMWARE_MBOX, TG3_FW_MBOX_MAGIC1);

	cmd = PCIReadU16(tg3.pci->bus, tg3.pci->dev, tg3.pci->fun, PCIR_COMMAND);

//CORECLK_RESET makes MMIO inaccessible. Do NOT TG3WriteFlush / MMIO-read here
//or the CPU can hang on PCI master abort (Linux flushes via config space).
//KEEP_GPHY_POWER so copper PHY is not powered off across the reset.
	TG3Write(TG3_GRC_MISC_CFG,
		TG3_GRC_MISC_CFG_CORECLK_RESET | TG3_GRC_MISC_CFG_KEEP_GPHY_POWER);
	PCIReadU16(tg3.pci->bus, tg3.pci->dev, tg3.pci->fun, PCIR_COMMAND);
	Sleep(120);

	PCIWriteU16(tg3.pci->bus, tg3.pci->dev, tg3.pci->fun, PCIR_COMMAND,
		cmd | TG3_CMDF_MEMEN | TG3_CMDF_BMEN);

	TG3MiscHostCtrl;
	for (i = 0; i < 100; i++)
	{
		if (TG3Read(TG3_MAC_MODE) != 0xFFFFFFFF)
			break;
		Sleep(10);
	}
	NetLog("TG3: chip reset done (MAC_MODE wait i=%d)", i);

	TG3MemArbEnable;
	TG3PollFw;
	if (!TG3MemWinSelfTest)
		NetErr("TG3: MEM_WIN selftest FAILED ΓÇö rings will not program");
	TG3PcieTxHangFix;
}

U0 TG3RingsAlloc()
{
	I64 i;
	CTG3RxDesc *rd;
	U32 buf_phys;

	tg3.tx_ring_phys = CAllocAligned(sizeof(CTG3TxDesc) * TG3_TX_RING_SIZE,
		16, Fs->code_heap);
	tg3.tx_ring = dev.uncached_alias + tg3.tx_ring_phys;

	tg3.rx_std_phys = CAllocAligned(sizeof(CTG3RxDesc) * TG3_RX_STD_RING_SIZE,
		16, Fs->code_heap);
	tg3.rx_std = dev.uncached_alias + tg3.rx_std_phys;

	tg3.rx_ret_phys = CAllocAligned(sizeof(CTG3RxDesc) * TG3_RX_RET_RING_SIZE,
		16, Fs->code_heap);
	tg3.rx_ret = dev.uncached_alias + tg3.rx_ret_phys;

	tg3.status_phys = CAllocAligned(TG3_HW_STATUS_SIZE, 16, Fs->code_heap);
	tg3.status = dev.uncached_alias + tg3.status_phys;
	MemSet(tg3.status, 0, TG3_HW_STATUS_SIZE);

	tg3.tx_bufs_phys = CAlloc(ETHERNET_FRAME_SIZE * TG3_TX_PENDING, Fs->code_heap);
	tg3.tx_bufs = dev.uncached_alias + tg3.tx_bufs_phys;

	tg3.rx_bufs_phys = CAlloc(ETHERNET_FRAME_SIZE * TG3_RX_PENDING, Fs->code_heap);
	tg3.rx_bufs = dev.uncached_alias + tg3.rx_bufs_phys;

	MemSet(tg3.tx_ring, 0, sizeof(CTG3TxDesc) * TG3_TX_RING_SIZE);
	MemSet(tg3.rx_std, 0, sizeof(CTG3RxDesc) * TG3_RX_STD_RING_SIZE);
	MemSet(tg3.rx_ret, 0, sizeof(CTG3RxDesc) * TG3_RX_RET_RING_SIZE);

	for (i = 0; i < TG3_RX_PENDING; i++)
	{
		rd = &tg3.rx_std[i];
		buf_phys = tg3.rx_bufs_phys + i * ETHERNET_FRAME_SIZE;
		rd->addr_hi = 0;
		rd->addr_lo = buf_phys;
		rd->idx_len = (i << 16) | TG3_RX_STD_DMA_SZ;
		rd->type_flags = 0;
		rd->opaque = TG3_RXD_OPAQUE_RING_STD | i;
	}

	tg3.tx_prod = 0;
	tg3.tx_cons = 0;
	tg3.rx_prod = 0;
	tg3.rx_cons = 0;
	tg3.rx_std_prod = TG3_RX_PENDING;
}

U0 TG3EnableBlocks()
{
	U32 val;
	I64 i;

	/* 57765-class (x86): keep HW defaults, set DIS_CACHE_ALIGNMENT.
	   Linux replaces dma_rwctrl with that bit alone then ORs into reg. */
	val = TG3Read(TG3PCI_DMA_RW_CTRL) & ~TG3_DMA_RWCTRL_DIS_CACHE_ALIGN;
	val |= TG3_DMA_RWCTRL_DIS_CACHE_ALIGN;
	TG3WriteFlush(TG3PCI_DMA_RW_CTRL, val);
	NetLog("TG3: DMA_RWCTRL=0x%X", TG3Read(TG3PCI_DMA_RW_CTRL));

	val = TG3_GRC_MODE_WSWAP_DATA | TG3_GRC_MODE_BSWAP_DATA |
		TG3_GRC_MODE_WSWAP_NONFRM |
		TG3_GRC_MODE_HOST_SENDBDS | TG3_GRC_MODE_HOST_STACKUP |
		TG3_GRC_MODE_NO_TX_PHDR_CSUM | TG3_GRC_MODE_NO_RX_PHDR_CSUM |
		TG3_GRC_MODE_IRQ_ON_MAC_ATTN;
	TG3WriteFlush(TG3_GRC_MODE, val);

	TG3Write(TG3_FTQ_RESET, 0xFFFFFFFF);
	TG3WriteFlush(TG3_FTQ_RESET, 0);

	/* 5750+/57766: firmware owns mbuf/DMA desc pools ΓÇö do not program
	   BUFMGR_*_POOL_ADDR/SIZE (Linux leaves them alone on 5750_PLUS). */
	TG3Write(TG3_BUFMGR_MB_RDMA_LOW_WATER, 0);	/* 5705+ default */
	TG3Write(TG3_BUFMGR_MB_MACRX_LOW_WATER, 0x2A);	/* 57765 */
	TG3Write(TG3_BUFMGR_MB_HIGH_WATER, 0xA0);	/* 57765 */
	TG3Write(TG3_BUFMGR_DMA_LOW_WATER, 5);
	TG3Write(TG3_BUFMGR_DMA_HIGH_WATER, 10);
	TG3WriteFlush(TG3_BUFMGR_MODE, TG3_BUFMGR_MODE_ENABLE);

	for (i = 0; i < 200; i++)
	{
		if (TG3Read(TG3_BUFMGR_MODE) & TG3_BUFMGR_MODE_ENABLE)
			break;
		Busy(10);
	}
	if (i >= 200)
		NetErr("TG3: BUFMGR enable failed");

	TG3Write(TG3_RCVBDI_STD_THRESH, TG3_RX_PENDING / 8);
	if (TG3_RX_PENDING / 8 < 1)
		TG3Write(TG3_RCVBDI_STD_THRESH, 1);
	/* 57765+: without STD_REPLENISH_LWM the chip may never fetch RX BDs. */
	TG3Write(TG3_STD_REPLENISH_LWM, TG3_RX_STD_BDCACHE_SIZE);

	/* 57765-class: maxlen = ring size; DMA sz in low bits << 2 */
	val = (TG3_RX_STD_RING_SIZE << TG3_BDINFO_MAXLEN_SHIFT) |
		(TG3_RX_STD_DMA_SZ << 2);
	TG3BDInfoWriteMMIO(TG3_RCVDBDI_STD_BD, tg3.rx_std_phys, val,
		TG3_NIC_SRAM_RX_BUFFER_DESC);
	TG3Write(TG3_RCVDBDI_JUMBO_BD + TG3_BDINFO_MAXLEN_FLAGS,
		TG3_BDINFO_FLAGS_DISABLED);

	TG3MboxWriteFlush(TG3_MAILBOX_RCV_STD_PROD_IDX, tg3.rx_std_prod);

	TG3BDInfoWriteSRAM(TG3_NIC_SRAM_SEND_RCB, tg3.tx_ring_phys,
		TG3_TX_RING_SIZE << TG3_BDINFO_MAXLEN_SHIFT);
	/* 57765_CLASS: disable 2nd TX RCB */
	TG3MemWrite(TG3_NIC_SRAM_SEND_RCB + TG3_BDINFO_SIZE + TG3_BDINFO_MAXLEN_FLAGS,
		TG3_BDINFO_FLAGS_DISABLED);

	TG3BDInfoWriteSRAM(TG3_NIC_SRAM_RCV_RET_RCB, tg3.rx_ret_phys,
		TG3_RX_RET_RING_SIZE << TG3_BDINFO_MAXLEN_SHIFT);
	/* 57765_CLASS: disable extra RX return RCBs (slots 1..3) */
	for (i = 1; i < 4; i++)
		TG3MemWrite(TG3_NIC_SRAM_RCV_RET_RCB + i * TG3_BDINFO_SIZE +
			TG3_BDINFO_MAXLEN_FLAGS, TG3_BDINFO_FLAGS_DISABLED);

	val = TG3MemRead(TG3_NIC_SRAM_SEND_RCB + TG3_BDINFO_HOST_ADDR + TG3_64BIT_LOW);
	NetLog("TG3: SEND_RCB host_lo readback=0x%X expect=0x%X", val, tg3.tx_ring_phys);
	"TG3: SEND_RCB readback=0x%X (tx_ring=0x%X)\n", val, tg3.tx_ring_phys;
	if (val != tg3.tx_ring_phys)
		NetErr("TG3: SRAM BDINFO write failed ΓÇö MEM_WIN/MEMARB broken");

	TG3Write(TG3_HOSTCC_STATUS_BLK_HOST_ADDR + TG3_64BIT_HIGH, 0);
	TG3Write(TG3_HOSTCC_STATUS_BLK_HOST_ADDR + TG3_64BIT_LOW, tg3.status_phys);

	TG3MboxWriteFlush(TG3_MAILBOX_SNDHOST_PROD_IDX_0, 0);
	TG3MboxWriteFlush(TG3_MAILBOX_RCVRET_CON_IDX_0, 0);
	TG3MboxWriteFlush(TG3_MAILBOX_INTERRUPT_0, 1);

	TG3Write(TG3_HOSTCC_RXCOL_TICKS, 0x48);
	TG3Write(TG3_HOSTCC_TXCOL_TICKS, 0x48);
	TG3Write(TG3_HOSTCC_RXMAX_FRAMES, 4);
	TG3Write(TG3_HOSTCC_TXMAX_FRAMES, 4);
	TG3Write(TG3_HOSTCC_RXCOAL_MAXF_INT, 4);
	TG3Write(TG3_HOSTCC_TXCOAL_MAXF_INT, 4);

	TG3Write(TG3_HOSTCC_MODE, 0);
	for (i = 0; i < 200; i++)
	{
		if (!(TG3Read(TG3_HOSTCC_MODE) & TG3_HOSTCC_MODE_ENABLE))
			break;
		Busy(10);
	}
	TG3Write(TG3_HOSTCC_MODE, TG3_HOSTCC_MODE_ENABLE | TG3_HOSTCC_MODE_ATTN);

	TG3Write(TG3_RCVCC_MODE, TG3_MODE_ENABLE | TG3_RCVCC_MODE_ATTN);
	TG3Write(TG3_RCVLPC_MODE, TG3_MODE_ENABLE);
	/* 5750+: leave DACK_FIX clear in stats enable. */
	TG3Write(TG3_RCVLPC_STATS_ENABLE, 0xFFFFFF & ~0x40000);
	TG3Write(TG3_RCVLPC_STATSCTRL, TG3_RCVLPC_STATSCTRL_ENABLE);
	TG3Write(TG3_RCVDBDI_MODE, TG3_MODE_ENABLE | TG3_RCVDBDI_MODE_INV_RING_SZ);
	TG3Write(TG3_RCVDCC_MODE, TG3_MODE_ENABLE);
	TG3Write(TG3_RCVBDI_MODE, TG3_MODE_ENABLE | TG3_RCVBDI_MODE_RCB_ATTN);
	TG3Write(TG3_SNDDATAI_MODE, TG3_MODE_ENABLE);
	TG3Write(TG3_SNDDATAC_MODE, TG3_MODE_ENABLE);
	TG3Write(TG3_SNDBDC_MODE, TG3_MODE_ENABLE | TG3_SNDBDC_MODE_ATTN);
	TG3Write(TG3_SNDBDS_MODE, TG3_MODE_ENABLE | TG3_SNDBDS_MODE_ATTN);
	TG3Write(TG3_SNDBDI_MODE, TG3_MODE_ENABLE | TG3_SNDBDI_MODE_ATTN);
	/* PCIe: LONG_BURST; 57766: JMB_2K_MMRR. Then RDMA FIFO overflow fix. */
	TG3WriteFlush(TG3_RDMAC_MODE,
		TG3_DMA_MODE_ENABLE | TG3_RDMAC_MODE_FIFO_LONG_BURST |
		TG3_RDMAC_MODE_JMB_2K_MMRR);
	val = TG3Read(TG3_RDMA_RSRVCTRL);
	TG3WriteFlush(TG3_RDMA_RSRVCTRL, val | TG3_RDMA_RSRVCTRL_FIFO_OFLW_FIX);
	/* 5755+/57766: STATUS_TAG_FIX required for host status block DMA. */
	TG3WriteFlush(TG3_WDMAC_MODE,
		TG3_DMA_MODE_ENABLE | TG3_WDMAC_MODE_STATUS_TAG_FIX);

	TG3MACWriteHW;

	TG3Write(TG3_MAC_RCV_RULE_CFG, TG3_RCV_RULE_CFG_DEFAULT);
	TG3Write(TG3_RCVLPC_CONFIG, 0x0181);
	TG3Write(TG3_MAC_LOW_WMARK_MAX_RX, 2);

	/* MTU + eth header + FCS + VLAN (Linux formula). */
	TG3Write(TG3_MAC_RX_MTU_SIZE, 1522);
	TG3Write(TG3_MAC_TX_LENGTHS, (2 << 12) | (6 << 8) | 0x20);
	TG3Write(TG3_MAC_HASH_REG_0, 0xFFFFFFFF);
	TG3Write(TG3_MAC_HASH_REG_1, 0xFFFFFFFF);
	TG3Write(TG3_MAC_HASH_REG_2, 0xFFFFFFFF);
	TG3Write(TG3_MAC_HASH_REG_3, 0xFFFFFFFF);

	/* Disable leftover ASF/rule filters (5705+ uses 8 rule slots). */
	TG3Write(TG3_MAC_RCV_RULE_0, 0xC2000000 & TG3_RCV_RULE_DISABLE_MASK);
	TG3Write(TG3_MAC_RCV_VALUE_0, 0xFFFFFFFF & TG3_RCV_RULE_DISABLE_MASK);
	TG3Write(TG3_MAC_RCV_RULE_0 + 8, 0x86000004 & TG3_RCV_RULE_DISABLE_MASK);
	TG3Write(TG3_MAC_RCV_VALUE_0 + 8, 0xFFFFFFFF & TG3_RCV_RULE_DISABLE_MASK);
	for (i = 2; i < 8; i++)
	{
		TG3Write(TG3_MAC_RCV_RULE_0 + i * 8, 0);
		TG3Write(TG3_MAC_RCV_VALUE_0 + i * 8, 0);
	}

	val = TG3_MAC_MODE_PORT_GMII | TG3_MAC_MODE_RXSTAT_ENABLE |
		TG3_MAC_MODE_TXSTAT_ENABLE | TG3_MAC_MODE_TDE_ENABLE |
		TG3_MAC_MODE_RDE_ENABLE | TG3_MAC_MODE_FHDE_ENABLE;
	TG3WriteFlush(TG3_MAC_MODE, val);

	TG3WriteFlush(TG3_MAC_RX_MODE, TG3_RX_MODE_ENABLE | TG3_RX_MODE_PROMISC);
	TG3WriteFlush(TG3_MAC_TX_MODE,
		TG3_TX_MODE_ENABLE | TG3_TX_MODE_MBUF_LOCKUP_FIX);

	/* Re-assert GRC_MODE after MAC bring-up (endian + host rings). */
	val = TG3_GRC_MODE_WSWAP_DATA | TG3_GRC_MODE_BSWAP_DATA |
		TG3_GRC_MODE_WSWAP_NONFRM |
		TG3_GRC_MODE_HOST_SENDBDS | TG3_GRC_MODE_HOST_STACKUP |
		TG3_GRC_MODE_NO_TX_PHDR_CSUM | TG3_GRC_MODE_NO_RX_PHDR_CSUM |
		TG3_GRC_MODE_IRQ_ON_MAC_ATTN;
	TG3Write(TG3_GRC_MODE, val);
}

U16 TG3StatusRxProducer()
{/* Return-ring producer: LE status.idx[0].rx_producer (low half of word4).
	NOT status.rx_consumer (word2) ΓÇö that tracks the std *buffer* ring. */
	U32 w = tg3.status[4];
	return w & 0xFFFF;
}

U16 TG3StatusTxConsumer()
{
	U32 w = tg3.status[4]; /* idx[0]: rx_prod | tx_cons */
	return w >> 16;
}

U0 TG3RxProcess()
{
	U16 hw_prod = TG3StatusRxProducer;
	I64 cons = tg3.rx_cons;
	CTG3RxDesc *rd;
	U16 pkt_len;
	U32 opaque;
	U8 *pkt;

	while (cons != hw_prod)
	{
		rd = &tg3.rx_ret[cons];
		pkt_len = rd->idx_len & TG3_RXD_LEN_MASK;
		opaque = rd->opaque & TG3_RXD_OPAQUE_INDEX_MASK;

		if (!(rd->type_flags & TG3_RXD_FLAG_ERROR) && pkt_len >= 14 &&
			opaque < TG3_RX_PENDING)
		{
			pkt = tg3.rx_bufs + opaque * ETHERNET_FRAME_SIZE;
			if (pkt_len > ETHERNET_FRAME_SIZE)
				pkt_len = ETHERNET_FRAME_SIZE;
			/* Strip Ethernet FCS if present in length. */
			if (pkt_len >= 4)
				pkt_len -= 4;
			NetQueuePush(pkt, pkt_len);
			if (!(tg3.rx_cons & 0x1F))
				NetLog("TG3: RX len=%d opaque=%d prod=%d cons=%d",
					pkt_len, opaque, hw_prod, cons);
		}

		/* Re-post producer descriptor for this buffer index. */
		if (opaque < TG3_RX_PENDING)
		{
			tg3.rx_std[tg3.rx_std_prod & (TG3_RX_STD_RING_SIZE - 1)].addr_hi = 0;
			tg3.rx_std[tg3.rx_std_prod & (TG3_RX_STD_RING_SIZE - 1)].addr_lo =
				tg3.rx_bufs_phys + opaque * ETHERNET_FRAME_SIZE;
			tg3.rx_std[tg3.rx_std_prod & (TG3_RX_STD_RING_SIZE - 1)].idx_len =
				(opaque << 16) | TG3_RX_STD_DMA_SZ;
			tg3.rx_std[tg3.rx_std_prod & (TG3_RX_STD_RING_SIZE - 1)].type_flags = 0;
			tg3.rx_std[tg3.rx_std_prod & (TG3_RX_STD_RING_SIZE - 1)].opaque =
				TG3_RXD_OPAQUE_RING_STD | opaque;
			tg3.rx_std_prod = (tg3.rx_std_prod + 1) & (TG3_RX_STD_RING_SIZE - 1);
			TG3MboxWriteFlush(TG3_MAILBOX_RCV_STD_PROD_IDX, tg3.rx_std_prod);
		}

		cons = (cons + 1) & (TG3_RX_RET_RING_SIZE - 1);
	}

	if (cons != tg3.rx_cons)
	{
		tg3.rx_cons = cons;
		TG3MboxWriteFlush(TG3_MAILBOX_RCVRET_CON_IDX_0, cons);
	}

	tg3.tx_cons = TG3StatusTxConsumer;
}

interrupt U0 TG3IRQ()
{
	U32 st;

	if (!tg3.init_ok)
	{
		*(dev.uncached_alias + LAPIC_EOI)(U32*) = 0;
		return;
	}

	st = tg3.status[0];
	TG3MiscHostCtrl;
	TG3MboxWrite(TG3_MAILBOX_INTERRUPT_0, 1);

	if (st & (TG3_SD_STATUS_UPDATED | TG3_SD_STATUS_LINK_CHG))
		TG3RxProcess;

	tg3.status[0] = 0;
	TG3MboxWrite(TG3_MAILBOX_INTERRUPT_0, 0);

	*(dev.uncached_alias + LAPIC_EOI)(U32*) = 0;
}

U0 TG3PCIInterruptsReroute(I64 base)
{
	I64 i;
	U8 *da = dev.uncached_alias + IOAPIC_REG;
	U32 *_d = dev.uncached_alias + IOAPIC_DATA;

	for (i = 0; i < 4; i++)
	{
		*da = IOREDTAB + i * 2 + 1;
		*_d = dev.mp_apic_ids[INT_DEST_CPU] << 24;
		*da = IOREDTAB + i * 2;
		*_d = 0x4000 + base + i;
	}
}

U0 TG3InterruptsSetup()
{
	I64 irq, i;

	for (i = 0; i < 4; i++)
		IntEntrySet((irq = IntEntryAlloc), &TG3IRQ);

	TG3PCIInterruptsReroute(irq);
	TG3MiscHostCtrl;
	TG3MboxWrite(TG3_MAILBOX_INTERRUPT_0, 0);
}

U0 TG3PollTask()
{/* Backup path if INTx delivery is slow/misrouted. Always scan rings ΓÇö
	UPDATED status bit alone is not reliable enough for DHCP RX. */
	I64 ticks = 0;
	U32 mac_stat, bmsr = 0;
	Bool was;

	while (tg3.init_ok)
	{
		TG3RxProcess;
		ticks++;
		if (!(ticks & 0x1F) && tg3.phy_addr >= 0)
		{
			TG3WriteFlush(TG3_MAC_MI_MODE, TG3_MI_MODE_BASE);
			Busy(40);
			if (TG3PhyRead(tg3.phy_addr, TG3_MII_BMSR, &bmsr) &&
				TG3PhyRead(tg3.phy_addr, TG3_MII_BMSR, &bmsr))
			{
				was = tg3.link_up;
				tg3.link_up = !!(bmsr & TG3_BMSR_LSTATUS);
				if (was != tg3.link_up)
				{
					mac_stat = TG3Read(TG3_MAC_STATUS);
					if (tg3.link_up)
					{
						NetLog("TG3: link UP BMSR=0x%X MAC_STATUS=0x%X", bmsr, mac_stat);
						TG3LinkApply;
					}
					else
						NetLog("TG3: link DOWN BMSR=0x%X MAC_STATUS=0x%X", bmsr, mac_stat);
				}
			}
			TG3WriteFlush(TG3_MAC_MI_MODE, TG3_MI_MODE_BASE | TG3_MI_MODE_AUTO_POLL);
		}
		Sleep(20);
	}
}

I64 TG3TransmitPacketAllocate(U8 **packet_buffer_out, I64 length)
{
	I64 idx = tg3.tx_prod;
	I64 slot = idx & (TG3_TX_PENDING - 1);
	CTG3TxDesc *td;

	if (((idx - tg3.tx_cons) & (TG3_TX_RING_SIZE - 1)) >= TG3_TX_PENDING)
	{
		NetErr("TG3: TX ring full");
		return -1;
	}

	td = &tg3.tx_ring[idx];
	td->addr_hi = 0;
	td->addr_lo = tg3.tx_bufs_phys + slot * ETHERNET_FRAME_SIZE;
	td->len_flags = (length << TG3_TXD_LEN_SHIFT) | TG3_TXD_FLAG_END;
	td->vlan_tag = 0;
	tg3.tx_length[slot] = length;

	*packet_buffer_out = tg3.tx_bufs_phys + slot * ETHERNET_FRAME_SIZE;
	return idx;
}

U0 TG3TransmitPacketFinish(I64 de_index)
{
	I64 next = (de_index + 1) & (TG3_TX_RING_SIZE - 1);
	U32 mbox, txm, wdm, bfm, rxm, st2, bcast, ucast;

	tg3.tx_prod = next;
	/* Write TX producer twice (TXD_MBOX_HWBUG style) then flush-read. */
	TG3MboxWrite(TG3_MAILBOX_SNDHOST_PROD_IDX_0, next);
	TG3MboxWriteFlush(TG3_MAILBOX_SNDHOST_PROD_IDX_0, next);
	if (next <= 4 || (next & 0xF) == 0)
	{
		mbox = TG3Read(TG3_MAILBOX_SNDHOST_PROD_IDX_0 + TG3_64BIT_LOW);
		txm = TG3Read(TG3_MAC_TX_MODE);
		rxm = TG3Read(TG3_MAC_RX_MODE);
		wdm = TG3Read(TG3_WDMAC_MODE);
		bfm = TG3Read(TG3_BUFMGR_MODE);
		st2 = tg3.status[2];
		bcast = TG3Read(TG3_MAC_RX_STATS_BCAST);
		ucast = TG3Read(TG3_MAC_RX_STATS_UCAST);
		NetLog("TG3: TX prod=%d mbox=%d status0=0x%X status2=0x%X status4=0x%X "
			"tx_cons=%d rx_prod=%d TX=0x%X RX=0x%X WDMAC=0x%X BUFMGR=0x%X "
			"rx_bcast=%d rx_ucast=%d",
			next, mbox, tg3.status[0], st2, tg3.status[4],
			TG3StatusTxConsumer, TG3StatusRxProducer, txm, rxm, wdm, bfm,
			bcast, ucast);
	}
}

U0 NetDriverTransmitPacketFinish(I64 de_index)
{
	TG3TransmitPacketFinish(de_index);
}

I64 NetDriverPacketBufferGet(I64 de_index)
{
	I64 slot = de_index & (TG3_TX_PENDING - 1);
	return tg3.tx_bufs_phys + slot * ETHERNET_FRAME_SIZE;
}

I64 NetDriverPacketLengthGet(I64 de_index)
{
	I64 slot = de_index & (TG3_TX_PENDING - 1);
	return tg3.tx_length[slot];
}

U8 *EthernetMACGet()
{
	return tg3.mac_address;
}

I64 EthernetFrameAllocate(U8 **packet_buffer_out,
	U8 *source_address,
	U8 *destination_address,
	U16 ethertype,
	I64 packet_length)
{
	U8 *ethernet_frame;
	I64 de_index;

	if (packet_length < ETHERNET_MIN_FRAME_SIZE)
		packet_length = ETHERNET_MIN_FRAME_SIZE;

	de_index = TG3TransmitPacketAllocate(&ethernet_frame,
		ETHERNET_MAC_HEADER_LENGTH + packet_length);
	if (de_index < 0)
	{
		NetErr("TG3: EthernetFrameAllocate failed");
		return -1;
	}

	ethernet_frame += dev.uncached_alias;
	MemSet(ethernet_frame, 0, ETHERNET_FRAME_SIZE);
	MemCopy(ethernet_frame, destination_address, MAC_ADDRESS_LENGTH);
	MemCopy(ethernet_frame + MAC_ADDRESS_LENGTH, source_address, MAC_ADDRESS_LENGTH);
	ethernet_frame[ETHERNET_ETHERTYPE_OFFSET] = ethertype >> 8;
	ethernet_frame[ETHERNET_ETHERTYPE_OFFSET + 1] = ethertype & 0xFF;
	*packet_buffer_out = ethernet_frame + ETHERNET_MAC_HEADER_LENGTH;
	return de_index;
}

U0 NetStop()
{
	TG3Write(TG3_MAC_RX_MODE, 0);
	TG3Write(TG3_MAC_TX_MODE, 0);
}

U0 NetStart()
{
	TG3WriteFlush(TG3_MAC_RX_MODE, TG3_RX_MODE_ENABLE | TG3_RX_MODE_PROMISC);
	TG3WriteFlush(TG3_MAC_TX_MODE,
		TG3_TX_MODE_ENABLE | TG3_TX_MODE_MBUF_LOCKUP_FIX);
}

U0 TG3Init()
{
	U32 mhc, mac_stat;

	MemSet(&tg3, 0, sizeof(CTG3));

	tg3.pci = TG3PCIDevFind;
	if (!tg3.pci)
	{
		NetErr("TG3: PCI 14e4:1686 not found");
		return;
	}

	ClassRep(tg3.pci);

	PCIWriteU16(tg3.pci->bus, tg3.pci->dev, tg3.pci->fun, PCIR_COMMAND,
		TG3_CMDF_MEMEN | TG3_CMDF_BMEN);

	tg3.mmio = dev.uncached_alias + (tg3.pci->base[0] & ~0xF);
	NetLog("TG3: MMIO at 0x%X (BAR0=0x%X)", tg3.mmio, tg3.pci->base[0]);

	TG3MiscHostCtrl;
	mhc = TG3Read(TG3PCI_MISC_HOST_CTRL);
	tg3.chip_rev = (mhc & TG3_MHC_CHIPREV_MASK) >> TG3_MHC_CHIPREV_SHIFT;
	/* 57766: ASIC rev lives at GEN15 PRODID (0xFC), not 0xBC. */
	tg3.asic_rev = PCIReadU32(tg3.pci->bus, tg3.pci->dev, tg3.pci->fun,
		TG3PCI_GEN15_PRODID_ASICREV);
	NetLog("TG3: chip_rev=0x%X asic/prodid=0x%X", tg3.chip_rev, tg3.asic_rev);

	TG3MACReadHW;
	NetLog("TG3: MAC %02X:%02X:%02X:%02X:%02X:%02X",
		tg3.mac_address[0], tg3.mac_address[1], tg3.mac_address[2],
		tg3.mac_address[3], tg3.mac_address[4], tg3.mac_address[5]);

	TG3ChipReset;
	NetLog("TG3: loading firmware...");
	TG3FirmwareLoad;
	NetLog("TG3: firmware_loaded=%d", tg3.firmware_loaded);
	TG3MACReadHW;
	if (!(tg3.mac_address[0] | tg3.mac_address[1] | tg3.mac_address[2] |
		tg3.mac_address[3] | tg3.mac_address[4] | tg3.mac_address[5]))
	{
		NetWarn("TG3: MAC still zero after reset; check NVRAM/firmware");
	}
	else
	{
		NetLog("TG3: MAC after reset %02X:%02X:%02X:%02X:%02X:%02X",
			tg3.mac_address[0], tg3.mac_address[1], tg3.mac_address[2],
			tg3.mac_address[3], tg3.mac_address[4], tg3.mac_address[5]);
	}

	TG3RingsAlloc;
	NetLog("TG3: DMA tx_bufs=0x%X rx_bufs=0x%X status=0x%X",
		tg3.tx_bufs_phys, tg3.rx_bufs_phys, tg3.status_phys);
	TG3EnableBlocks;
	TG3PhyInit;
	if (tg3.link_up)
		TG3LinkApply;

	mac_stat = TG3Read(TG3_MAC_STATUS);
	NetLog("TG3: MAC_STATUS=0x%X pcs=%d sig=%d", mac_stat,
		!!(mac_stat & TG3_MAC_STATUS_PCS_SYNCED),
		!!(mac_stat & TG3_MAC_STATUS_SIGNAL_DET));

	tg3.init_ok = TRUE;
	TG3InterruptsSetup;
	tg3.poll_task = Spawn(&TG3PollTask,, "TG3-poll");

	"\n$$GREEN$$TG3 BCM57766 ready  MAC "
	"%02X:%02X:%02X:%02X:%02X:%02X$$FG$$\n",
		tg3.mac_address[0], tg3.mac_address[1], tg3.mac_address[2],
		tg3.mac_address[3], tg3.mac_address[4], tg3.mac_address[5];
}

TG3Init;
