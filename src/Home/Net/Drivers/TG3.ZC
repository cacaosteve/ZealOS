#define  TG3_RX_MODE_IPV6_CSUM		0x01000000
/* The BCM57766 perfect-address filter is dropping every frame on this mini
	(MAC RX octets and all class counters stay zero even while ICMP replies are
	on the wire).  Accept everything in hardware and let TG3RxProcess discard
	our own TX echoes, IPv6 and mDNS.  The continuously-owned 200-buffer ring
	now recycles that background traffic instead of exhausting the old window. */
#define  TG3_RX_MODE_RUN		0x01000102 /* ENABLE|PROMISC|IPV6_CSUM */
