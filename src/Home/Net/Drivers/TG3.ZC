/* Scratch for MEM_WIN R/W test ΓÇö NOT status blk @0xB00 (hw-owned). */
#define TG3_NIC_SRAM_MEMWIN_TEST	0x00000B54
#define TG3PCI_GEN15_PRODID_ASICREV	0x000000FC

#define TG3_NIC_SRAM_SEND_RCB		0x00000100
