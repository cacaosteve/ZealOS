I64 BootKernelOnlyCompile(U8 *src)
{
	I64 errs = -1, was_srv;

	// Comp() expects the system-server run level even during early boot.
	was_srv = Bt(&sys_run_level, RLf_SYSTEM_SERVER);
	if (!was_srv)
		LBts(&sys_run_level, RLf_SYSTEM_SERVER);
	try
	{
		// MapFileWrite uses DolDoc, which is unavailable during this bootstrap.
		errs = Comp(src,,, ':');
	}
	catch
	{
		Fs->catch_except = TRUE;
		errs = -1;
	}
	if (!was_srv)
		LBtr(&sys_run_level, RLf_SYSTEM_SERVER);
	return errs;
}

U0 BootKernelOnlyFail(U8 *reason)
{
	FileWrite("C:/Home/BootInsStage.DD", "fail", 4);
	FileWrite("C:/Home/BootInsErrs.DD", reason, StrLen(reason));
	// StartOS consumes this marker before launching us. Restore it for retry.
	FileWrite("C:/Home/BootInsPending.DD", "1", 1);
	Cd("C:/Home");
}

public U0 BootKernelOnlyReboot()
{
	Bool stage2, stage3;
	I64 errs, size;
	U8 *st, *buf;

	Cd("C:/");
	Option(0, 1);
	stage2 = FileFind("C:/Home/AutoISORebuildStage2.DD");
	stage3 = FileFind("C:/Home/AutoISORebuildStage3.DD");
	Del("C:/Home/BootAutoKernelConfig.DD",, FALSE, FALSE);
	Del("C:/Home/BootInsErrs.DD",, FALSE, FALSE);
	Del("C:/Home/BootCompileLog.DD",, FALSE, FALSE);

	if (stage3)
	{
		FileWrite("C:/Home/BootInsStage.DD", "compiler", 8);
		"BootKernelOnly: compiling /Compiler/Compiler\n";
		errs = BootKernelOnlyCompile("C:/Compiler/Compiler");
		"BootKernelOnly: compiler errs=%d\n", errs;
		if (errs)
		{
			st = MStrPrint("compiler errs=%d\n", errs);
			BootKernelOnlyFail(st);
			Free(st);
			return;
		}
	}

	FileWrite("C:/Home/BootInsStage.DD", "kernel", 6);
	"BootKernelOnly: compiling /Kernel/Kernel\n";
	errs = BootKernelOnlyCompile("C:/Kernel/Kernel");
	"BootKernelOnly: kernel errs=%d\n", errs;
	if (errs)
	{
		st = MStrPrint("kernel errs=%d\n", errs);
		BootKernelOnlyFail(st);
		Free(st);
		return;
	}

	// AutoISO stage 4 replaces the kernel and updates the boot record together.
	// Keep the current boot kernel intact across stage 2 and stage 3 reboots.
	if (!stage2 && !stage3)
	{
		FileWrite("C:/Home/BootInsStage.DD", "copy", 4);
		buf = FileRead("C:/Kernel/Kernel.ZXE", &size);
		if (!buf)
		{
			BootKernelOnlyFail("kernel read failed\n");
			return;
		}
		Del("C:/Boot/Kernel.ZXE",, FALSE, FALSE);
		if (!FileWrite("C:/Boot/Kernel.ZXE", buf, size))
		{
			Free(buf);
			BootKernelOnlyFail("kernel write failed\n");
			return;
		}
		Free(buf);
	}

	if (stage2)
	{
		Del("C:/Home/AutoISORebuildStage2.DD",, FALSE, FALSE);
		Del("C:/Home/AutoISOStage2.DD",, FALSE, FALSE);
		FileWrite("C:/Home/AutoISOStage3.DD", "3", 1);
	}
	else if (stage3)
	{
		Del("C:/Home/AutoISORebuildStage3.DD",, FALSE, FALSE);
		Del("C:/Home/AutoISOStage3.DD",, FALSE, FALSE);
		FileWrite("C:/Home/AutoISOStage4.DD", "4", 1);
	}

	FileWrite("C:/Home/BootInsStage.DD", "reboot", 6);
	Reboot;
}

BootKernelOnlyReboot;
