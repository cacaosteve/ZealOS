				   usb_debug_ehci_stage, usb_debug_ehci_active, usb_debug_ehci_input, usb_debug_ehci_bdf,
				   usb_debug_ehci_ports, usb_debug_ehci_port, usb_debug_ehci_portsc, usb_debug_ehci_code,
				   usb.ehci_kbd_addr, usb.ehci_kbd_ep, usb.ehci_kbd_iface, usb.ehci_kbd_port, usb.ehci_kbd_speed,
				   usb.ehci_kbd_max_pkt, usb.ehci_kbd_pending,
				   usb.ehci_kbd_done_count, usb.ehci_kbd_err_count, usb.ehci_kbd_last_token, kbd.count,
				   usb.kbd_last_bytes[0], usb.kbd_last_bytes[1], usb.kbd_last_bytes[2], usb.kbd_last_bytes[3],
				   usb.kbd_last_bytes[4], usb.kbd_last_bytes[5], usb.kbd_last_bytes[6], usb.kbd_last_bytes[7],
				   usb.ehci_ms_addr, usb.ehci_ms_ep, usb.ehci_ms_iface, usb.ehci_ms_port, usb.ehci_ms_speed,
				   usb.ehci_ms_max_pkt, usb.ehci_ms_pending,
				   usb.ehci_ms_done_count, usb.ehci_ms_err_count, usb.ehci_ms_last_token, usb.ms_abs, usb.ms_abs_seen,
				   usb.ms_last_bytes[0], usb.ms_last_bytes[1], usb.ms_last_bytes[2], usb.ms_last_bytes[3],
				   usb.ms_last_bytes[4], usb.ms_last_bytes[5], usb.ms_last_bytes[6], usb.ms_last_bytes[7],
				   usb.ehci_tab_addr, usb.ehci_tab_ep, usb.ehci_tab_iface, usb.ehci_tab_port, usb.ehci_tab_speed, usb.ehci_tab_max_pkt,
				   usb.kbd_slot, usb.kbd_dci, usb.kbd_iface, usb.kbd_ep, usb.kbd_max_pkt, usb.kbd_ring, usb.kbd_ring_phys, usb.kbd_pending,
				   usb.kbd_submit_count, usb.kbd_evt_count, usb.kbd_report_count, usb.kbd_inject_count,
				   usb.kbd_last_len, usb.kbd_last_code, FifoI64Count(kbd.scan_code_fifo), kbd.count,
				   usb.kbd_last_bytes[0], usb.kbd_last_bytes[1], usb.kbd_last_bytes[2], usb.kbd_last_bytes[3],
				   usb.kbd_last_bytes[4], usb.kbd_last_bytes[5], usb.kbd_last_bytes[6], usb.kbd_last_bytes[7],
				   usb.ms_slot, usb.ms_dci, usb.ms_iface, usb.ms_ep, usb.ms_max_pkt, usb.ms_abs, usb.ms_abs_seen,
				   usb.ms_last_abs_x, usb.ms_last_abs_y, usb.ms_ring, usb.ms_ring_phys, usb.ms_pending,
				   usb.ms_xfer_done, usb.ms_xfer_code, usb.ms_xfer_len, usb.ms_acc_x, usb.ms_acc_y, usb.ms_acc_b,
				   usb.ms_last_bytes[0], usb.ms_last_bytes[1], usb.ms_last_bytes[2], usb.ms_last_bytes[3],
				   usb.ms_last_bytes[4], usb.ms_last_bytes[5], usb.ms_last_bytes[6], usb.ms_last_bytes[7]);
	drive = Letter2Drive('C', FALSE);
	if (drive && (drive->fs_type == FSt_FAT32 || drive->fs_type == FSt_REDSEA) &&
			drive->bd && !(drive->bd->flags & BDF_READ_ONLY))
	{
		try
		{
			FileWrite("C:/Home/UsbBootLast.DD", st, StrLen(st));
		}
		catch
		{
			Fs->catch_except = TRUE;
		}
	}
	Free(st);
