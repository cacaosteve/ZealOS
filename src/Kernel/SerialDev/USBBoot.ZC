				   usb.uhci_kbd_ctlr, usb.uhci_kbd_addr, usb.uhci_kbd_ep, usb.uhci_kbd_iface, usb.uhci_kbd_max_pkt,
				   usb.uhci_kbd_pending, usb.uhci_kbd_done_count, usb.uhci_kbd_err_count, usb.uhci_kbd_last_sts, kbd.count,
				   usb.kbd_last_bytes[0], usb.kbd_last_bytes[1], usb.kbd_last_bytes[2], usb.kbd_last_bytes[3],
				   usb.kbd_last_bytes[4], usb.kbd_last_bytes[5], usb.kbd_last_bytes[6], usb.kbd_last_bytes[7],
