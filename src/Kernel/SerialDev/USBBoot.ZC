// Boot-time USB orchestration. Included last in MakeSerialDev.ZC so EhciCoreInit
// and UsbCoreInit are both fully defined (no forward-decl stubs).
// Public $LK,"UsbBootInit",A="MN:UsbBootInit"$ lives in Kernel/Usb (dual-stack wrapper).

public U0 UsbInputCoreInit()
{//UHCI/EHCI HID only. SerialDev xHCI skipped ΓÇö Kernel USB owns xHCI.
	I64 uhci_active, ehci_active, best_score, best_backend;

	sys_usb_input_active = 0;
	MemSet(&usb, 0, sizeof(CUSBStateGlobals));
	usb_debug_stage = 199;
	UhciCoreInit;
	uhci_active = sys_usb_input_active;

	sys_usb_input_active = 0;
	MemSet(&usb, 0, sizeof(CUSBStateGlobals));
	usb_debug_stage = 200;
	usb.ehci_debug_code = 0xE0FF;
	EhciDebugSave;
	EhciCoreInit;
	ehci_active = sys_usb_input_active;

	// UTM/Q35 can let UHCI enumerate companion devices while EHCI owns the
	// usable UI path. Prefer EHCI when both claim the same input coverage.
	best_score = UsbActiveScore(ehci_active);
	best_backend = 1;
	if (UsbActiveScore(uhci_active) > best_score)
	{
		best_score = UsbActiveScore(uhci_active);
		best_backend = 0;
	}

	if (!best_score)
		return;
	sys_usb_input_active = 0;
	MemSet(&usb, 0, sizeof(CUSBStateGlobals));
	if (best_backend == 0)
		UhciCoreInit;
	else
		EhciCoreInit;
}

public U0 UsbInit()
{
	sys_usb_suppress_single_step = 1;
	UdSuspTitle("MouseRawWatcher");
	UdSuspTitle("MouseHardDriverInstall");
	UsbInputCoreInit;
	if (!(sys_usb_input_active & UM))
		UdResTitle("MouseRawWatcher");
	if (!(sys_usb_input_active & UM))
		UdResTitle("MouseHardDriverInstall");
	if (!sys_usb_input_active)
	{
		sys_usb_suppress_single_step = 0;
		DebugTrapsClear;
	}
	else
	{
		RFlagsSet(RFLAGG_NORMAL);
		UsbIntrEnable;
	}
}

U16 UsbBootUhciIn16(I64 ctlr, I64 off)
{
	if (ctlr < 0 || ctlr >= usb.uhci_ctlr_count)
		return 0;
	return UhciIn16(ctlr, off);
}

U32 UsbBootUhciIn32(I64 ctlr, I64 off)
{
	if (ctlr < 0 || ctlr >= usb.uhci_ctlr_count)
		return 0;
	return UhciIn32(ctlr, off);
}

U32 UsbBootMem32(U8 *p, I64 idx)
{
	if (!p)
		return 0;
	return *(p + idx * 4)(U32 *);
}

public U0 UsbBootLastWrite()
{
	U8 *st;
	CDrive *drive;

	st = MStrPrint("drv=usb-ui-uhci1 stage=%d active=0x%X irq=%d pci_srv=%d pci_bus=%d inst_att=%d cfg_len=%d iface_cls=%d ep0_mps=%d ep0_state=%d xfer_code=%d cmd_code=%d port=%d port_idx=%d speed=%d addr_code=%d deq_code=%d ehci=%d ehci_bdf=0x%X ehci_ports=%d ehci_port=%d ehci_portsc=0x%X ehci_code=0x%X ehci_dev_speed=%d ehci_dev_port=%d ehci_poll=%d poll=%d\n"
