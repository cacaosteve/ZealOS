public U0 UsbLegacyInputInit()
{//SerialDev UHCI/EHCI HID. Called from Kernel USB $LK,"UsbBootInit",A="MN:UsbBootInit"$.
	I64 i, prev_active;

	prev_active = sys_usb_input_active; //preserve Kernel USB HID bits (UK/UM)
	if ((prev_active & (UK | UM)) == (UK | UM))
		return;
	sys_usb_suppress_single_step = 1;
	usb_verbose = 0;
	UdSuspTitle("MouseRawWatcher");
	UdSuspTitle("MouseHardDriverInstall");
	usb_debug_stage = 900;
	UsbBootLastWrite;
	UsbInputCoreInit;
	sys_usb_input_active |= prev_active;
	UsbBootLastWrite;
	if (sys_usb_input_active & UK)
		XhkIntrSub;
	if (sys_usb_input_active & UM)
		XhmIntrSub;
	if ((usb.uhci_active || usb.ehci_active) && sys_usb_input_active)
	{
		for (i = 0; i < 100; i++)
		{
			UsbPollEvt;
			if (usb.uhci_kbd_done_count || usb.uhci_ms_done_count ||
					usb.ehci_kbd_done_count || usb.ehci_ms_done_count || kbd.count)
				break;
			Sleep(5);
		}
	}
	else
		UsbPollEvt;
	// Poll-only at boot for SerialDev path.
	if (!(sys_usb_input_active & UM))
		UdBgResume;
	else
		RFlagsSet(RFLAGG_NORMAL);
	UdTrapsRel;
	UsbBootLastWrite;
}

public U0 UsbPollBgTask()
{
	while (sys_usb_input_active)
	{
		UsbPollEvt;
		Yield;
	}
}

public U0 UdRun()
{
	sys_usb_suppress_single_step = 1;
	usb_verbose = 0;
	UdSuspTitle("MouseRawWatcher");
	UdSuspTitle("MouseHardDriverInstall");
	UsbInputCoreInit;
	UsbIntrEnable;
	"UdRun done: stage=%d active=0x%X cfg_len=%d iface_cls=%d ep0_mps=%d ep0_state=%d xfer_code=%d cmd_code=%d port=%d port_idx=%d speed=%d addr_code=%d deq_code=%d\n",
		usb_debug_stage, sys_usb_input_active, usb_debug_cfg_len, usb_debug_iface_cls,
		usb_debug_ep0_mps, usb_debug_ep0_state, usb_debug_xfer_code, usb_debug_cmd_code,
		usb_debug_root_port, usb_debug_port_idx, usb_debug_port_speed, usb_debug_addr_code, usb_debug_deq_code;
	UdBgResume;
}

public U0 UdWinResume()
{
	UdBgResume;
}
