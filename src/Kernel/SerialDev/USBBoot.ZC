				   "uhci_tab ctlr=%d addr=%d ep=%d iface=%d max=%d\n"
				   "ehci_last stage=%d active=%d input=0x%X bdf=0x%X ports=%d port=%d portsc=0x%X code=0x%X\n"
				   "ehci_kbd addr=%d ep=%d iface=%d port=%d speed=%d max=%d pend=%d done=%d err=%d token=0x%X kcnt=%d bytes=%02X %02X %02X %02X %02X %02X %02X %02X\n"
				   "ehci_ms addr=%d ep=%d iface=%d port=%d speed=%d max=%d pend=%d done=%d err=%d token=0x%X abs=%d seen=%d bytes=%02X %02X %02X %02X %02X %02X %02X %02X\n"
				   "ehci_tab addr=%d ep=%d iface=%d port=%d speed=%d max=%d\n"
				   "kbd slot=%d dci=%d iface=%d ep=0x%X max=%d ring=0x%X phys=0x%X pend=%d sub=%d evt=%d rep=%d inj=%d len=%d code=%d fifo=%d kcnt=%d bytes=%02X %02X %02X %02X %02X %02X %02X %02X\n"
				   "mouse slot=%d dci=%d iface=%d ep=0x%X max=%d abs=%d seen=%d last_abs=(%d,%d) ring=0x%X phys=0x%X pend=%d done=%d code=%d len=%d acc=(%d,%d,%d) bytes=%02X %02X %02X %02X %02X %02X %02X %02X\n",
				   usb_debug_stage, sys_usb_input_active, usb.irq, sys_pci_services, sys_pci_buses,
				   mouse_hard.install_attempts, usb_debug_cfg_len, usb_debug_iface_cls,
				   usb_debug_ep0_mps, usb_debug_ep0_state, usb_debug_xfer_code, usb_debug_cmd_code,
				   usb_debug_root_port, usb_debug_port_idx, usb_debug_port_speed, usb_debug_addr_code, usb_debug_deq_code,
				   usb.ehci_active, usb.ehci_bdf, usb.ehci_ports, usb.ehci_debug_port, usb.ehci_debug_portsc, usb.ehci_debug_code,
				   usb.ehci_dev_speed, usb.ehci_dev_port, usb.ehci_poll_count, usb_debug_poll_count,
				   usb.uhci_active, usb.uhci_ctlr_count, usb.uhci_debug_ctlr, usb.uhci_bdfs[usb.uhci_debug_ctlr],
				   usb.uhci_ios[usb.uhci_debug_ctlr], usb.uhci_debug_port, usb.uhci_debug_portsc, usb.uhci_debug_code,
				   usb.uhci_poll_count, usb.uhci_ctrl_poll, usb.uhci_ctrl_poll_count,
				   UsbBootUhciIn16(usb.uhci_debug_ctlr, UHCI_REG_USBCMD),
				   UsbBootUhciIn16(usb.uhci_debug_ctlr, UHCI_REG_USBSTS),
				   UsbBootUhciIn16(usb.uhci_debug_ctlr, UHCI_REG_FRNUM),
				   UsbBootUhciIn32(usb.uhci_debug_ctlr, UHCI_REG_FLBASEADD),
				   UsbBootMem32(usb.uhci_kbd_qh, 0), UsbBootMem32(usb.uhci_kbd_qh, 1),
				   UsbBootMem32(usb.uhci_kbd_td, 0), UsbBootMem32(usb.uhci_kbd_td, 1),
				   UsbBootMem32(usb.uhci_kbd_td, 2), UsbBootMem32(usb.uhci_kbd_td, 3),
