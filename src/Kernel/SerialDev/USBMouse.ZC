U0 XhmPktIns(I64 dx, I64 dy, I64 b, I64 dz)
{
	I64 ps2[4];

	ps2[0] = 0;
	if (b & 1)
		ps2[0] |= 1;
	if (b & 2)
		ps2[0] |= 2;
	if (b & 4)
		ps2[0] |= 4;
	if (dx < 0)
	{
		ps2[0] |= 0x10;
		ps2[1] = 256 + dx;
	}
	else
		ps2[1] = dx;
	if (dy > 0)
	{
		ps2[0] |= 0x20;
		ps2[2] = 256 - dy;
	}
	else
		ps2[2] = -dy;
	ps2[3] = 0;
	if (dz < 0)
	{
		ps2[3] = (-dz) & 7;
		ps2[3] |= 0x08;
	}
	else if (dz > 0)
		ps2[3] = dz & 7;

	mouse_hard.timestamp = TSCGet;
	FifoU8Insert(mouse_hard.fifo2, ps2[0]);
	FifoU8Insert(mouse_hard.fifo2, ps2[1]);
	FifoU8Insert(mouse_hard.fifo2, ps2[2]);
	FifoU8Insert(mouse_hard.fifo2, ps2[3]);
	mouse_hard.pkt_size = 4;
}

U0 XhmRptDbg(U8 *rpt, I64 len)
{
	I64 i;

	usb.ms_last_len = len;
	MemSet(usb.ms_last_bytes, 0, 16);
	i = 0;
	while (i < len)
	{
		if (i >= 16)
			break;
		usb.ms_last_bytes[i] = rpt[i];
		i++;
	}
}

Bool XhmAbsRptOk(U8 *rpt, I64 len, I64 *off, I64 report_id)
{
	I64 o = 0;

	// Absolute: [buttons][x_lo][x_hi][y_lo][y_hi] or leading report ID + 5 bytes.
	if (report_id)
	{
		if (len < 6)
			return FALSE;
		if (rpt[0] != report_id)
			return FALSE;
		o = 1;
	}
	else if (len >= 6)
	{
		if (rpt[0] >= 1 && rpt[0] <= 15)
		{
			if (!(rpt[1] & ~7))
				o = 1;
		}
	}
	if (len < o + 5)
		return FALSE;
	*off = o;
	return TRUE;
}

Bool XhmBootMsBound()
{
	if (usb.ehci_active)
	{
		if (usb.ehci_ms_addr)
			return TRUE;
		return FALSE;
	}
	if (usb.uhci_active)
	{
		if (usb.uhci_ms_addr)
			return TRUE;
		return FALSE;
	}
	if (usb.ms_slot)
		return TRUE;
	return FALSE;
}

I64 XhmS8(U8 b)
{
	if (b & 0x80)
		return b - 256;
	return b;
}

Bool XhmRptRelRead(U8 *rpt, I64 len, I64 off, I64 *_b, I64 *_dx, I64 *_dy, I64 *_dz)
{
	if (len <= off + 2)
		return FALSE;
	*_b = rpt[off] & 7;
	*_dx = XhmS8(rpt[off + 1]);
	*_dy = XhmS8(rpt[off + 2]);
	*_dz = 0;
	if (len > off + 3)
		*_dz = XhmS8(rpt[off + 3]);
	return TRUE;
}

U0 XhmAbsWarp(I64 px, I64 py, I64 b)
{
	I64 x, y, l, r, last_b;

	if (!(sys_usb_input_active & UM))
		return;
	last_b = usb.ms_last_btn & 7;
	if (px == mouse.pos.x && py == mouse.pos.y && (b & 7) == last_b)
		return;

	l = b & 1;
	r = (b & 2) >> 1;
	mouse.offset.x = 0;
	mouse.offset.y = 0;
	x = px / mouse.scale.x;
	y = py / mouse.scale.y;

	mouse.presnap.x = ToI64(mouse.scale.x * x);
	mouse.presnap.y = ToI64(mouse.scale.y * y);
	if (mouse_grid.snap)
	{
		mouse.pos.x = Trunc(mouse.presnap.x / mouse_grid.x) * mouse_grid.x + mouse_grid.x_offset;
		mouse.pos.y = Trunc(mouse.presnap.y / mouse_grid.y) * mouse_grid.y + mouse_grid.y_offset;
	}
	else
	{
		mouse.pos.x = mouse.presnap.x;
		mouse.pos.y = mouse.presnap.y;
	}
	mouse.pos.x = ClampI64(mouse.pos.x, 0, sys_framebuffer_width - 1);
	mouse.pos.y = ClampI64(mouse.pos.y, 0, sys_framebuffer_height - 1);
	mouse.pos_text.x = mouse.pos.x / FONT_WIDTH;
	if (mouse.pos_text.x >= text.cols)
	{
		mouse.pos_text.x = text.cols - 1;
		mouse.pos.x = text.cols * FONT_WIDTH - 1;
	}
	mouse.pos_text.y = mouse.pos.y / FONT_HEIGHT;
	if (mouse.pos_text.y >= text.rows)
	{
		mouse.pos_text.y = text.rows - 1;
		mouse.pos.y = text.rows * FONT_HEIGHT - 1;
	}
	mouse.lb = l;
	mouse.rb = r;
	mouse.show = TRUE;
	LBEqual(&kbd.scan_code, SCf_MS_L_DOWN, l);
	LBEqual(&kbd.scan_code, SCf_MS_R_DOWN, r);

	mouse_hard.timestamp = TSCGet;
	mouse_hard.bttns[0] = l;
	mouse_hard.bttns[1] = r;
	mouse_hard.bttns[2] = (b & 4) != 0;
	mouse_hard.prescale.x = x / mouse_hard.scale.x / mouse_grid.x_speed;
	mouse_hard.prescale.y = y / mouse_hard.scale.y / mouse_grid.y_speed;
	mouse_hard.pos.x = mouse.pos.x;
	mouse_hard.pos.y = mouse.pos.y;
	mouse_hard.event = TRUE;

	usb.ms_acc_x = 0;
	usb.ms_acc_y = 0;
	usb.ms_acc_z = 0;
	usb.ms_acc_b = b;
	usb.ms_last_btn = b;
}

U0 XhmAbsBttns(I64 b)
{
	I64 l, r, last_b;

	if (!(sys_usb_input_active & UM))
		return;
	last_b = usb.ms_last_btn & 7;
	if ((b & 7) == last_b)
		return;

	l = b & 1;
	r = (b & 2) >> 1;
	mouse.lb = l;
	mouse.rb = r;
	mouse.show = TRUE;
	LBEqual(&kbd.scan_code, SCf_MS_L_DOWN, l);
	LBEqual(&kbd.scan_code, SCf_MS_R_DOWN, r);

	mouse_hard.timestamp = TSCGet;
	mouse_hard.bttns[0] = l;
	mouse_hard.bttns[1] = r;
	mouse_hard.bttns[2] = (b & 4) != 0;
	mouse_hard.event = TRUE;

	usb.ms_acc_b = b;
	usb.ms_last_btn = b;
}

U0 XhmRptAbs(U8 *rpt, I64 len, I64 report_id=0)
{
	I64 off, b, x, y, sw, sh, npx, npy, adx, ady;

	if (!XhmAbsRptOk(rpt, len, &off, report_id))
		return;

	b = rpt[off] & 7;
	x = rpt[off + 1] | (rpt[off + 2] << 8);
	y = rpt[off + 3] | (rpt[off + 4] << 8);
	sw = sys_framebuffer_width;
	sh = sys_framebuffer_height;
	if (sw < 1)
		sw = 640;
	if (sh < 1)
		sh = 480;
	// QEMU usb-tablet: 0..32767 maps left->right, top->bottom.
	if (sw > 1)
		npx = x * (sw - 1) / 32767;
	else
		npx = 0;
	if (sh > 1)
		npy = y * (sh - 1) / 32767;
	else
		npy = 0;

	adx = npx - usb.ms_last_abs_x;
	if (adx < 0)
		adx = -adx;
	ady = npy - usb.ms_last_abs_y;
	if (ady < 0)
		ady = -ady;
	usb.ms_last_abs_x = npx;
	usb.ms_last_abs_y = npy;

	// Boot mouse + tablet are both bound.  Stay in relative mode while the
	// host is driving usb-mouse; only return to tablet after rel quiet and
	// the tablet position actually moves (UTM cursor off).
	if (XhmBootMsBound())
	{
		if (!usb.ms_use_tab)
		{
			if (tS - usb.ms_rel_last_t < 0.35)
				return;
			if (adx < 4 && ady < 4)
				return;
			usb.ms_use_tab = TRUE;
		}
	}
	if (!usb.ms_use_tab)
		return;

	adx = npx - mouse.pos.x;
	if (adx < 0)
		adx = -adx;
	ady = npy - mouse.pos.y;
	if (ady < 0)
		ady = -ady;

	usb.ms_rel_idle = 0;
	usb.ms_acc_x = 0;
	usb.ms_acc_y = 0;
	usb.ms_acc_z = 0;
	usb.ms_abs_seen = TRUE;

	// Drop tablet button noise while the absolute pointer is re-synchronizing.
	if ((b & 7) && (adx > 20 || ady > 20))
		return;
	XhmAbsWarp(npx, npy, b);
}

U0 XhmRptRel(U8 *rpt, I64 len, I64 report_id=0)
{
	I64 dx, dy, dz, b, off, id_b, id_dx, id_dy, id_dz;

	off = 0;
	// Boot mouse reports are [buttons][X][Y][wheel?].  A pressed button
	// makes byte 0 nonzero.  UTM's captured cursor can use
	// [report_id][buttons][X][Y], so learn that short form only after a
	// no-button movement report makes byte 1 unambiguously the button byte.
	if (report_id)
	{
		if (len < 4)
			return;
		if (rpt[0] != report_id)
			return;
		off = 1;
	}
	else if (usb.ms_rel_report_id)
		off = 1;
	else if (len >= 5)
	{
		if (rpt[0] >= 1)
		{
			if (rpt[0] <= 15)
				off = 1;
		}
	}
	else if (len == 4)
	{
		if (rpt[0] >= 1)
		{
			if (rpt[0] <= 15)
			{
				if (!(rpt[1] & ~7))
				{
					if (XhmRptRelRead(rpt, len, 1, &id_b, &id_dx, &id_dy, &id_dz))
					{
						if (!id_b)
						{
							if (id_dx || id_dy || id_dz)
							{
								usb.ms_rel_report_id = rpt[0];
								off = 1;
							}
						}
					}
				}
			}
		}
	}
	if (!XhmRptRelRead(rpt, len, off, &b, &dx, &dy, &dz))
		return;

	if (dx || dy || dz)
	{
		usb.ms_use_tab = FALSE;
		usb.ms_rel_idle = 0;
		usb.ms_rel_last_t = tS;
	}
	else if ((b & 7) != (usb.ms_last_btn & 7))
	{
		if (XhmBootMsBound())
		{
			usb.ms_use_tab = FALSE;
			usb.ms_rel_last_t = tS;
		}
	}
	else if (!usb.ms_use_tab)
		usb.ms_rel_idle++;

	if (usb.ms_use_tab)
		return;

	usb.ms_acc_x += dx;
	usb.ms_acc_y += dy;
	usb.ms_acc_b = b;
	usb.ms_acc_z += dz;
}

U0 XhmRptHandleMode(U8 *rpt, I64 len, Bool abs_mode, I64 report_id=0)
{
	if (len < 3)
		return;

	XhmRptDbg(rpt, len);
	if (abs_mode)
		XhmRptAbs(rpt, len, report_id);
	else
		XhmRptRel(rpt, len, report_id);
}

U0 XhmRptHandle(U8 *rpt, I64 len)
{
	XhmRptHandleMode(rpt, len, usb.ms_abs, usb.ms_report_id);
}

U0 XhmAccFlush()
{
	I64 dx, dy, dz, b, ox, oy, oz;

	if (!(sys_usb_input_active & UM))
		return;

	PUSHFD
	CLI
	dx = usb.ms_acc_x;
	dy = usb.ms_acc_y;
	dz = usb.ms_acc_z;
	b = usb.ms_acc_b;
	ox = dx;
	oy = dy;
	oz = dz;
	if (dx > 127)
	{
		usb.ms_acc_x = dx - 127;
		dx = 127;
	}
	else if (dx < -127)
	{
		usb.ms_acc_x = dx + 127;
		dx = -127;
	}
	else
		usb.ms_acc_x = 0;
	if (dy > 127)
	{
		usb.ms_acc_y = dy - 127;
		dy = 127;
	}
	else if (dy < -127)
	{
		usb.ms_acc_y = dy + 127;
		dy = -127;
	}
	else
		usb.ms_acc_y = 0;
	if (dz > 7)
	{
		usb.ms_acc_z = dz - 7;
		dz = 7;
	}
	else if (dz < -7)
	{
		usb.ms_acc_z = dz + 7;
		dz = -7;
	}
	else
		usb.ms_acc_z = 0;
	POPFD

	if (!dx)
	{
		if (!dy)
		{
			if (!dz)
			{
				if (b == usb.ms_last_btn)
				{
					if (!ox)
					{
						if (!oy)
						{
							if (!oz)
								return;
						}
					}
				}
			}
		}
	}
	usb.ms_last_btn = b;
	XhmPktIns(dx, dy, b, dz);
}



U0 XhmEvtHandle()
{
	U8 *buf;
	Bool done = FALSE;

	PUSHFD
	CLI
	if (usb.ms_ring && usb.ms_pending && usb.ms_xfer_done)
	{
		buf = usb.ctrl_buf + udma_ms;
		if (usb.ms_xfer_len && XhcXferOk(usb.ms_xfer_code))
			XhmRptHandleMode(buf, usb.ms_xfer_len, FALSE, usb.ms_report_id);
		usb.ms_pending = FALSE;
		usb.ms_xfer_done = FALSE;
		done = TRUE;
	}
	if (usb.tab_ring && usb.tab_pending && usb.tab_xfer_done)
	{
		buf = usb.ctrl_buf + udma_tab;
		if (usb.tab_xfer_len && XhcXferOk(usb.tab_xfer_code))
			XhmRptHandleMode(buf, usb.tab_xfer_len, TRUE, usb.tab_report_id);
		usb.tab_pending = FALSE;
		usb.tab_xfer_done = FALSE;
		done = TRUE;
	}
	POPFD
	if (done)
		XhmIntrSub;
}
