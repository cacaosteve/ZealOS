I64 ScFromUsage(U8 usage)
{
	switch (usage)
	{
		case 0x04: return 0x1E; // A
		case 0x05: return 0x30; // B
		case 0x06: return 0x2E; // C
		case 0x07: return 0x20; // D
		case 0x08: return 0x12; // E
		case 0x09: return 0x21; // F
		case 0x0A: return 0x22; // G
		case 0x0B: return 0x23; // H
		case 0x0C: return 0x17; // I
		case 0x0D: return 0x24; // J
		case 0x0E: return 0x25; // K
		case 0x0F: return 0x26; // L
		case 0x10: return 0x32; // M
		case 0x11: return 0x31; // N
		case 0x12: return 0x18; // O
		case 0x13: return 0x19; // P
		case 0x14: return 0x10; // Q
		case 0x15: return 0x13; // R
		case 0x16: return 0x1F; // S
		case 0x17: return 0x14; // T
		case 0x18: return 0x16; // U
		case 0x19: return 0x2F; // V
		case 0x1A: return 0x11; // W
		case 0x1B: return 0x2D; // X
		case 0x1C: return 0x15; // Y
		case 0x1D: return 0x2C; // Z
		case 0x1E: return 0x02; // 1
		case 0x1F: return 0x03; // 2
		case 0x20: return 0x04; // 3
		case 0x21: return 0x05; // 4
		case 0x22: return 0x06; // 5
		case 0x23: return 0x07; // 6
		case 0x24: return 0x08; // 7
		case 0x25: return 0x09; // 8
		case 0x26: return 0x0A; // 9
		case 0x27: return 0x0B; // 0
		case 0x28: return SC_ENTER;
		case 0x29: return SC_ESC;
		case 0x2A: return SC_BACKSPACE;
		case 0x2B: return SC_TAB;
		case 0x2C: return 0x39; // Space
		case 0x2D: return 0x0C; // -
		case 0x2E: return 0x0D; // =
		case 0x2F: return 0x1A; // [
		case 0x30: return 0x1B; // ]
		case 0x31: return 0x2B; // Backslash
		case 0x33: return 0x27; // ;
		case 0x34: return 0x28; // '
		case 0x35: return 0x29; // `
		case 0x36: return 0x33; // ,
		case 0x37: return 0x34; // .
		case 0x38: return 0x35; // /
		case 0x39: return SC_CAPS;
		case 0x3A: return SC_F1;
		case 0x3B: return SC_F2;
		case 0x3C: return SC_F3;
		case 0x3D: return SC_F4;
		case 0x3E: return SC_F5;
		case 0x3F: return SC_F6;
		case 0x40: return SC_F7;
		case 0x41: return SC_F8;
		case 0x42: return SC_F9;
		case 0x43: return SC_F10;
		case 0x44: return SC_F11;
		case 0x45: return SC_F12;
		case 0x49: return SC_INS;
		case 0x4A: return SC_HOME;
		case 0x4B: return SC_PAGE_UP;
		case 0x4C: return SC_DELETE;
		case 0x4D: return SC_END;
		case 0x4E: return SC_PAGE_DOWN;
		case 0x4F: return SC_CURSOR_RIGHT;
		case 0x50: return SC_CURSOR_LEFT;
		case 0x51: return SC_CURSOR_DOWN;
		case 0x52: return SC_CURSOR_UP;
	}
	return 0;
}

I64 ScfFromMod(U8 mod)
{
	I64 f = 0;

	if (mod & 1)
		f |= SCF_CTRL;
	else if (mod & 0x10)
		f |= SCF_CTRL;
	if (mod & 2)
		f |= SCF_SHIFT;
	else if (mod & 0x20)
		f |= SCF_SHIFT;
	if (mod & 4)
		f |= SCF_ALT;
	else if (mod & 0x40)
		f |= SCF_ALT;
	return f;
}

U0 XhkScanInj(I64 sc_in, Bool key_up)
{
	I64 sc, sc_raw, sc_flags, sc_byte, new_key_f, ch;
	Bool set_leds = FALSE;

	if (!sc_in)
		return;
	sc_byte = sc_in & 0xFF;
	if (key_up)
		sc_byte |= SCF_KEY_UP;
	sc_flags = kbd.scan_code.u32[0] & ~0x1FF;
	sc_raw = sc_byte & ~SCF_KEY_UP;
	new_key_f = SCF_NEW_KEY;
	if (sc_byte & SCF_KEY_UP)
		switch (sc_byte & ~SCF_KEY_UP)
		{
			case SC_SHIFT:	sc_flags &= ~SCF_SHIFT;					break;
			case SC_CTRL: 	sc_flags &= ~SCF_CTRL;					break;
			case SC_ALT:	sc_flags &= ~SCF_ALT;					break;
			case SC_DELETE: sc_flags &= ~SCF_DELETE;				break;
			case SC_INS:	sc_flags &= ~SCF_INS;					break;
			case SC_CAPS: 	sc_flags ^= SCF_CAPS;	set_leds=TRUE;	break;
			case SC_NUM:	sc_flags ^= SCF_NUM;	set_leds=TRUE;	break;
			case SC_SCROLL: sc_flags ^= SCF_SCROLL;	set_leds=TRUE;	break;
		}
	else
		switch (sc_byte)
		{
			case SC_SHIFT:
				if (Bts(&sc_flags, SCf_SHIFT))
					new_key_f = 0;
				break;

			case SC_CTRL:
				if (Bts(&sc_flags, SCf_CTRL))
					new_key_f = 0;
				break;

			case SC_ALT:
				if (Bts(&sc_flags, SCf_ALT))
					new_key_f = 0;
				break;

			case SC_DELETE:
				sc_flags |= SCF_DELETE;
				break;

			case SC_INS:
				sc_flags |= SCF_INS;
				break;
		}

	if (!new_key_f)
		return;
	sc_flags |= new_key_f;
	sc = sc_flags | sc_byte | (sc_flags | sc_raw) << 32;
	if (sc_flags & SCF_CTRL && sc_flags & SCF_ALT)
	{
		if (!(sc & SCF_KEY_UP))
		{
			if ((sc & 255) == SC_DELETE && !(sc_flags & SCF_SHIFT))
				CtrlAltDel(sc);
			else
			{
				if (ch = ScanCode2Char(sc & 255))
				if ('a' <= ch <= 'z')
				{
					sc &= ~(SCF_NEW_KEY | SCF_NEW_KEY << 32);
					ch -= 'a';
					kbd.last_down_scan_code = sc;
					if (keydev.fp_ctrl_alt_cbs[ch] &&
							!Bt(&keydev.ctrl_alt_in_irq_flags, ch) &&
							((!(sc_flags & SCF_SHIFT) && keydev.ctrl_alt_no_shift_descs[ch]) ||
							(sc_flags & SCF_SHIFT && keydev.ctrl_alt_shift_descs[ch])))
						(*keydev.fp_ctrl_alt_cbs[ch])(sc);
				}
			}
		}
	}
	if (set_leds)
	{
		// Caps/Num/Scroll LEDs are PS/2 controller commands; skip when USB owns the keyboard.
		if (!(sys_usb_input_active & LEGACY_USB_INPUT_KBD))
		{
			try
				KbdLEDsSet(sc);
			catch
				Fs->catch_except = TRUE;
		}
	}
	kbd.timestamp = TSCGet;
	kbd.scan_code = sc;
	kbd.new_key_timestamp = kbd.timestamp;
	FifoI64Ins(kbd.scan_code_fifo, sc);
	kbd.count++;
	legacy_usb.kbd_inject_count++;
	if (sc & SCF_KEY_UP)
	{
		Btr(kbd.down_bitmap, sc.u8[0]);
		Btr(kbd.down_bitmap2, sc.u8[4]);
	}
	else
	{
		kbd.last_down_scan_code = sc;
		Bts(kbd.down_bitmap, sc.u8[0]);
		Bts(kbd.down_bitmap2, sc.u8[4]);
	}
}

Bool XhkUsageIn(U8 usage, U8 *rpt)
{
	I64 i;

	for (i = 2; i < 8; i++)
	{
		if (rpt[i] == usage)
			return TRUE;
	}
	return FALSE;
}

U0 XhkRptDbg(U8 *rpt, I64 len)
{
	I64 i;

	legacy_usb.kbd_report_count++;
	legacy_usb.kbd_last_len = len;
	MemSet(legacy_usb.kbd_last_bytes, 0, 16);
	i = 0;
	while (i < len)
	{
		if (i >= 16)
			break;
		legacy_usb.kbd_last_bytes[i] = rpt[i];
		i++;
	}
}

Bool XhkRptNorm(U8 *dst, U8 *rpt, I64 len)
{
	I64 i, j;

	MemSet(dst, 0, 8);
	if (len >= 9)
	{
		if (rpt[0] >= 1)
		{
			if (rpt[0] <= 15)
			{
				MemCopy(dst, rpt + 1, 8);
				return TRUE;
			}
		}
	}
	if (len >= 8)
	{
		MemCopy(dst, rpt, 8);
		return TRUE;
	}

	// Conservative fallback for short/report-ID formats carrying usage bytes.
	j = 2;
	i = 0;
	while (i < len)
	{
		if (j >= 8)
			break;
		if (ScFromUsage(rpt[i]))
		{
			dst[j] = rpt[i];
			j++;
		}
		i++;
	}
	return j > 2;
}

U0 XhkModDiff(U8 mod, U8 last_mod)
{
	if ((mod & 1) && !(last_mod & 1))
		XhkScanInj(SC_CTRL, FALSE);
	if (!(mod & 1) && (last_mod & 1))
		XhkScanInj(SC_CTRL | SCF_KEY_UP, TRUE);
	if ((mod & 0x10) && !(last_mod & 0x10))
		XhkScanInj(SC_CTRL | SCF_CTRL, FALSE);
	if (!(mod & 0x10) && (last_mod & 0x10))
		XhkScanInj(SC_CTRL | SCF_CTRL | SCF_KEY_UP, TRUE);

	if ((mod & 2) && !(last_mod & 2))
		XhkScanInj(SC_SHIFT, FALSE);
	if (!(mod & 2) && (last_mod & 2))
		XhkScanInj(SC_SHIFT | SCF_KEY_UP, TRUE);
	if ((mod & 0x20) && !(last_mod & 0x20))
		XhkScanInj(SC_SHIFT | SCF_SHIFT, FALSE);
	if (!(mod & 0x20) && (last_mod & 0x20))
		XhkScanInj(SC_SHIFT | SCF_SHIFT | SCF_KEY_UP, TRUE);

	if ((mod & 4) && !(last_mod & 4))
		XhkScanInj(SC_ALT, FALSE);
	if (!(mod & 4) && (last_mod & 4))
		XhkScanInj(SC_ALT | SCF_KEY_UP, TRUE);
	if ((mod & 0x40) && !(last_mod & 0x40))
		XhkScanInj(SC_ALT | SCF_ALT, FALSE);
	if (!(mod & 0x40) && (last_mod & 0x40))
		XhkScanInj(SC_ALT | SCF_ALT | SCF_KEY_UP, TRUE);
}

U0 XhkRptHandle(U8 *rpt, I64 len)
{
	I64 i, sc, flags, usage, mod, last_mod;
	U8 norm[8];

	XhkRptDbg(rpt, len);
	if (!XhkRptNorm(norm, rpt, len))
		return;
	rpt = norm;
	mod = rpt[0];
	last_mod = legacy_usb.kbd_last_rpt[0];
	XhkModDiff(mod, last_mod);
	flags = ScfFromMod(mod);
	for (i = 2; i < 8; i++)
	{
		usage = rpt[i];
		if (usage)
		{
			if (!XhkUsageIn(usage, legacy_usb.kbd_last_rpt))
			{
				sc = ScFromUsage(usage);
				if (sc)
					XhkScanInj(sc | flags, FALSE);
			}
		}
	}
	for (i = 2; i < 8; i++)
	{
		usage = legacy_usb.kbd_last_rpt[i];
		if (usage)
		{
			if (!XhkUsageIn(usage, rpt))
			{
				sc = ScFromUsage(usage);
				if (sc)
					XhkScanInj(sc | flags, TRUE);
			}
		}
	}
	MemCopy(legacy_usb.kbd_last_rpt, rpt, 8);
}



U0 XhkEvtHandle()
{
	if (!legacy_usb.kbd_pending)
		return;
	if (!legacy_usb.kbd_xfer_done)
		return;
	if (!legacy_usb.kbd_ring)
		return;
	if (legacy_usb.kbd_xfer_len && XhcXferOk(legacy_usb.kbd_xfer_code))
		XhkRptHandle(legacy_usb.ctrl_buf + LEGACY_udma_kbd, legacy_usb.kbd_xfer_len);
	legacy_usb.kbd_pending = FALSE;
	legacy_usb.kbd_xfer_done = FALSE;
	XhkIntrSub;
}

public U0 XhkWatchTask()
{
	I64 i, j;

	for (i = 0; i < 90; i++)
	{
		"usbkbd %2d active=%X slot=%d dci=%d pend=%d sub=%d evt=%d rep=%d inj=%d len=%d code=%d kcnt=%d bytes=",
			i, sys_usb_input_active, legacy_usb.kbd_slot, legacy_usb.kbd_dci, legacy_usb.kbd_pending,
			legacy_usb.kbd_submit_count, legacy_usb.kbd_evt_count, legacy_usb.kbd_report_count,
			legacy_usb.kbd_inject_count, legacy_usb.kbd_last_len, legacy_usb.kbd_last_code, kbd.count;
		for (j = 0; j < 8; j++)
			"%02X", legacy_usb.kbd_last_bytes[j];
		"\n";
		Sleep(1000);
	}
}
