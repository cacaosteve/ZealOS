CUSBStateGlobals usb;
public I64 sys_usb_input_active;
public I64 usb_debug_stage;
public I64 usb_verbose;
public I64 usb_debug_cfg_len;
public I64 usb_debug_iface_cls;
public I64 usb_debug_ep0_mps;
public I64 usb_debug_xfer_code;
public I64 usb_debug_cmd_code;
public I64 usb_debug_port_speed;
public I64 usb_debug_root_port;
public I64 usb_debug_port_idx;
public I64 usb_debug_addr_code;
public I64 usb_debug_deq_code;
public I64 usb_debug_ep0_state;
public I64 usb_debug_ehci_stage;
public I64 usb_debug_ehci_active;
public I64 usb_debug_ehci_input;
public I64 usb_debug_ehci_bdf;
public I64 usb_debug_ehci_ports;
public I64 usb_debug_ehci_port;
public I64 usb_debug_ehci_portsc;
public I64 usb_debug_ehci_code;
public I64 usb_debug_poll_count;

public U0 EhciDebugSave()
{
	usb_debug_ehci_stage = usb_debug_stage;
	usb_debug_ehci_active = usb.ehci_active;
	usb_debug_ehci_input = sys_usb_input_active;
	usb_debug_ehci_bdf = usb.ehci_bdf;
	usb_debug_ehci_ports = usb.ehci_ports;
	usb_debug_ehci_port = usb.ehci_debug_port;
	usb_debug_ehci_portsc = usb.ehci_debug_portsc;
	usb_debug_ehci_code = usb.ehci_debug_code;
}

U0 XhcLog(U8 *format, ...)
{
	U8 *buf;

	if (!usb_verbose)
		return;
	buf = StrPrintJoin(NULL, format, argc, argv);
	"%s", buf;
	Free(buf);
}

U0 XhkEvtHandle();
U0 XhmEvtHandle();
U0 XhmAccFlush();

Bool XhcXferOk(I64 code)
{
	if (code == XHCI_CC_SUCCESS)
		return TRUE;
	if (code == XHCI_CC_SHORT_PACKET)
		return TRUE;
	return FALSE;
}

U32 XHCICapRead(I64 off)
{
	return *(usb.xhci_base + off)(U32 *);
}

U0 XHCICapWrite(I64 off, U32 val)
{
	*(usb.xhci_base + off)(U32 *) = val;
}

U32 XHCIOpRead(I64 off)
{
	return *(usb.xhci_base + usb.cap_length + off)(U32 *);
}

U0 XHCIOpWrite(I64 off, U32 val)
{
	*(usb.xhci_base + usb.cap_length + off)(U32 *) = val;
}

U32 XHCIRtRead(I64 off)
{
	return *(usb.xhci_base + usb.runtime_off + off)(U32 *);
}

U0 XHCIRtWrite(I64 off, U32 val)
{
	*(usb.xhci_base + usb.runtime_off + off)(U32 *) = val;
}

U32 XHCIPortRead(I64 port)
{
	return *(usb.xhci_base + usb.cap_length + XHCI_OP_PORTSC_BASE + port * 0x10)(U32 *);
}

U0 XHCIPortWrite(I64 port, U32 val)
{
	*(usb.xhci_base + usb.cap_length + XHCI_OP_PORTSC_BASE + port * 0x10)(U32 *) = val;
}

U0 XHCIDoorbell(I64 slot, I64 target=1)
{
	*(usb.xhci_base + usb.db_off + slot * 4)(U32 *) = target;
	XHCICapRead(0);
}

U64 XHCIPhys(U8 *virt)
{
	if (!virt)
		return 0;
	return virt;
}

U8 *XHCIAlloc(I64 size, I64 align, U64 *_phys=NULL)
{
	U8 *p;

	// Same as AHCI: sys_task heap pointers are valid bus/DMA addresses.
	p = CAllocAligned(size, align, sys_task->code_heap);
	if (_phys)
		*_phys = p;
	return p;
}

U0 XHCIOpWrite64(I64 off, U64 val)
{
	XHCIOpWrite(off, val);
	XHCIOpWrite(off + 4, val >> 32);
}

U64 XHCIOpRead64(I64 off)
{
	U64 res;

	res = XHCIOpRead(off + 4);
	res <<= 32;
	res |= XHCIOpRead(off);
	return res;
}

#define XHCI_EXTCAP_LEGACY		1
#define XHCI_LEGSUP_BIOS		0x00010000
#define XHCI_LEGSUP_OS			0x01000000
#define XHCI_LEGCTLSTS_OFF		4

#define XHCI_PCI_INTEL_VENDOR	0x8086
#define XHCI_PCI_INTEL_XUSB2PR	0xD0
#define XHCI_PCI_INTEL_XUSB2PRM	0xD4
#define XHCI_PCI_INTEL_USB3PSSEN	0xD8
#define XHCI_PCI_INTEL_USB3PRM	0xDC

U0 XHCILegacyHandoff(I64 hcc)
{
	I64 off, next, cap_id, i;
	U32 cap, legsup;

	off = hcc >> 16;
	off &= 0xFFFF;
	off <<= 2;
	while (off)
	{
		cap = XHCICapRead(off);
		cap_id = cap & 0xFF;
		next = cap >> 8;
		next &= 0xFF;
		if (cap_id == XHCI_EXTCAP_LEGACY)
		{
			legsup = cap | XHCI_LEGSUP_OS;
			XHCICapWrite(off, legsup);
			for (i = 0; i < 100; i++)
			{
				legsup = XHCICapRead(off);
				if (!(legsup & XHCI_LEGSUP_BIOS))
					break;
				Sleep(10);
			}
			XHCICapWrite(off + XHCI_LEGCTLSTS_OFF, 0);
			XhcLog("XHCILegacyHandoff: off=0x%X legsup=0x%X\n", off, XHCICapRead(off));
			return;
		}
		if (!next)
			break;
		off += next << 2;
		if (off > 4096)
			break;
	}
}

U0 XHCIIntelRoutePorts(I64 bdf)
{
	I64 bus, devn, fun, vendor;
	U32 usb2pr, usb2prm, usb3pssen, usb3prm;

	bus = bdf.u8[2];
	devn = bdf.u8[1];
	fun = bdf.u8[0];
	vendor = PCIReadU16(bus, devn, fun, PCIR_VENDOR_ID);
	if (vendor != XHCI_PCI_INTEL_VENDOR)
		return;

	usb3pssen = PCIReadU32(bus, devn, fun, XHCI_PCI_INTEL_USB3PSSEN);
	usb3prm = PCIReadU32(bus, devn, fun, XHCI_PCI_INTEL_USB3PRM);
	if (usb3prm && usb3prm != 0xFFFFFFFF)
	{
		usb3pssen |= usb3prm;
		PCIWriteU32(bus, devn, fun, XHCI_PCI_INTEL_USB3PSSEN, usb3pssen);
	}

	usb2pr = PCIReadU32(bus, devn, fun, XHCI_PCI_INTEL_XUSB2PR);
	usb2prm = PCIReadU32(bus, devn, fun, XHCI_PCI_INTEL_XUSB2PRM);
	if (usb2prm && usb2prm != 0xFFFFFFFF)
	{
		usb2pr |= usb2prm;
		PCIWriteU32(bus, devn, fun, XHCI_PCI_INTEL_XUSB2PR, usb2pr);
	}
	XhcLog("XHCIIntelRoutePorts: usb3=0x%X/0x%X usb2=0x%X/0x%X\n",
		PCIReadU32(bus, devn, fun, XHCI_PCI_INTEL_USB3PSSEN), usb3prm,
		PCIReadU32(bus, devn, fun, XHCI_PCI_INTEL_XUSB2PR), usb2prm);
}

I64 XHCITrbType(U32 control)
{
	I64 type;

	type = control >> 10;
	type &= 0x3F;
	return type;
}

U0 XHCICmdRingDoorbell(I64 idx, I64 cycle)
{
	U64 crcr;

	// Halted: program CRCR pointer+RCS. Running: ring host doorbell (slot 0 = 0).
	if (XHCIOpRead(XHCI_OP_USBSTS) & 1 << XHCISTS_HCH)
	{
		crcr = usb.cmd_ring_phys + idx * 16;
		crcr |= cycle;
		XHCIOpWrite64(XHCI_OP_CRCR, crcr);
	}
	else
	{
		*(usb.xhci_base + usb.db_off)(U32 *) = 0;
		XHCICapRead(0); // PCI post-write flush
	}
}

U0 XHCICmdRingReset()
{
	CXHCITrb *link;

	if (!usb.cmd_ring)
		return;
	MemSet(usb.cmd_ring, 0, XHCI_RING_SIZE * 16);
	usb.cmd_ring_idx = 0;
	usb.cmd_ring_cycle = 1;
	link = (usb.cmd_ring + XHCI_RING_LINK_IDX * sizeof(CXHCITrb))(CXHCITrb *);
	link->param = usb.cmd_ring_phys;
	link->control = XHCI_TRB_LINK << 10 | 2 | usb.cmd_ring_cycle;
}

U0 XHCIEvtRingReset()
{
	if (!usb.evt_ring)
		return;
	MemSet(usb.evt_ring, 0, XHCI_RING_SIZE * 16);
	usb.evt_ring_idx = 0;
	usb.evt_ring_cycle = 1;
}

U0 XHCICmdTrbPost(CXHCITrb *trb)
{
	CXHCITrb *link;
	I64 idx, cycle, ctl;

	idx = usb.cmd_ring_idx;
	if (idx >= XHCI_RING_LINK_IDX)
	{
		idx = 0;
		usb.cmd_ring_idx = 0;
	}
	cycle = usb.cmd_ring_cycle;
	MemCopy(usb.cmd_ring + idx * sizeof(CXHCITrb), trb, sizeof(CXHCITrb));
	ctl = *(usb.cmd_ring + idx * sizeof(CXHCITrb) + offset(CXHCITrb.control))(U32 *);
	*(usb.cmd_ring + idx * sizeof(CXHCITrb) + offset(CXHCITrb.control))(U32 *) = ctl | cycle;
	usb.cmd_ring_idx++;
	if (usb.cmd_ring_idx >= XHCI_RING_LINK_IDX)
	{
		link = (usb.cmd_ring + XHCI_RING_LINK_IDX * sizeof(CXHCITrb))(CXHCITrb *);
		ctl = link->control & ~1;
		if (cycle)
			ctl |= 1;
		link->control = ctl;
		usb.cmd_ring_idx = 0;
		usb.cmd_ring_cycle = !cycle;
	}
	XHCICmdRingDoorbell(idx, cycle);
}

U0 XHCIErdpUpdate()
{
	U64 erdp = usb.evt_ring_phys + usb.evt_ring_idx * 16;

	// ERDP low bits are DESI/EHB, not an event-cycle bit. Bit 3 clears EHB.
	erdp &= ~0xF;
	erdp |= 1 << 3;
	XHCIRtWrite(XHCI_RT_ERDP0, erdp);
	XHCIRtWrite(XHCI_RT_ERDP0 + 4, erdp >> 32);
}

U0 XHCIEventAdvance(I64 max_events=0)
{
	CXHCITrb *trb;
	I64 type, slot, dci, residual, actual, code, ccs, handled, evt_count = 0, cyc;

	while (TRUE)
		{
			trb = (usb.evt_ring + usb.evt_ring_idx * sizeof(CXHCITrb))(CXHCITrb *);
			ccs = trb->control & 1;
			if (ccs != usb.evt_ring_cycle)
				break;
		type = XHCITrbType(trb->control);
		if (type == XHCI_TRB_EVT_CMD_COMP)
		{
			usb.cmd_comp_slot = trb->control >> 24;
			usb.cmd_comp_code = trb->status >> 24;
			usb.cmd_comp_code &= 0xFF;
			usb.cmd_comp_done = TRUE;
		}
		else if (type == XHCI_TRB_EVT_TRANSFER)
		{
			slot = trb->control >> 24;
			dci = trb->control >> 16;
			dci &= 0x1F;
			residual = trb->status & 0xFFFFFF;
			code = trb->status >> 24;
			code &= 0xFF;
			handled = FALSE;
			if (slot == usb.ms_slot)
			{
				if (dci == usb.ms_dci)
				{
					if (usb.ms_pending)
					{
						actual = usb.ms_max_pkt - residual;
						if (actual < 0)
							actual = 0;
						if (actual > usb.ms_max_pkt)
							actual = usb.ms_max_pkt;
						usb.ms_xfer_code = code;
						usb.ms_xfer_done = TRUE;
						if (XhcXferOk(code))
							usb.ms_xfer_len = actual;
						else
							usb.ms_xfer_len = 0;
						handled = TRUE;
					}
				}
			}
			if (slot == usb.tab_slot)
			{
				if (dci == usb.tab_dci)
				{
					if (usb.tab_pending)
					{
						actual = usb.tab_max_pkt - residual;
						if (actual < 0)
							actual = 0;
						if (actual > usb.tab_max_pkt)
							actual = usb.tab_max_pkt;
						usb.tab_xfer_code = code;
						usb.tab_xfer_done = TRUE;
						if (XhcXferOk(code))
							usb.tab_xfer_len = actual;
						else
							usb.tab_xfer_len = 0;
						handled = TRUE;
					}
				}
			}
			if (slot == usb.kbd_slot)
			{
				if (dci == usb.kbd_dci)
				{
					if (usb.kbd_pending)
					{
						actual = usb.kbd_max_pkt - residual;
						if (actual < 0)
							actual = 0;
						if (actual > usb.kbd_max_pkt)
							actual = usb.kbd_max_pkt;
						usb.kbd_xfer_code = code;
						usb.kbd_xfer_done = TRUE;
						if (XhcXferOk(code))
							usb.kbd_xfer_len = actual;
						else
							usb.kbd_xfer_len = 0;
						usb.kbd_evt_count++;
						handled = TRUE;
					}
				}
			}
			if (!handled)
			{
				usb.xfer_done = TRUE;
				usb.xfer_len = residual;
				usb.xfer_code = code;
			}
		}
		else if (type == XHCI_TRB_EVT_PORT_STS)
		{
			usb.port_event = TRUE;
			code = XHCIRtRead(XHCI_RT_IMAN0) & ~1;
			code |= 1 << 1;
			XHCIRtWrite(XHCI_RT_IMAN0, code);
		}
		usb.evt_ring_idx++;
		if (usb.evt_ring_idx >= XHCI_RING_SIZE)
		{
			usb.evt_ring_idx = 0;
			cyc = usb.evt_ring_cycle;
			usb.evt_ring_cycle = !cyc;
		}
		XHCIErdpUpdate;
		if (max_events)
		{
			evt_count++;
			if (evt_count >= max_events)
				break;
		}
	}
}

Bool XHCIEventWaitCmd(I64 timeout_ms)
{
	F64 deadline = tS + timeout_ms / 1000.0;

	usb.cmd_comp_done = FALSE;
	while (tS < deadline)
	{
		XHCIEventAdvance;
		if (usb.cmd_comp_done)
		{
			usb_debug_cmd_code = usb.cmd_comp_code;
			return TRUE;
		}
	}
	return FALSE;
}

Bool XHCIEventWait(I64 timeout_ms)
{
	F64 deadline = tS + timeout_ms / 1000.0;

	usb.cmd_comp_done = FALSE;
	usb.xfer_done = FALSE;
	while (tS < deadline)
	{
		XHCIEventAdvance;
		if (usb.cmd_comp_done)
			return TRUE;
		if (usb.xfer_done)
			return TRUE;
	}
	return FALSE;
}

Bool XHCICmdNoop()
{
	CXHCITrb trb;
	U32 evt0;

	MemSet(&trb, 0, sizeof(trb));
	trb.control = XHCI_TRB_CMD_NOOP << 10;
	trb.control |= 1 << XHCI_TRB_IOC;
	XHCICmdTrbPost(&trb);
	if (!XHCIEventWait(500))
	{
		evt0 = *(usb.evt_ring)(U32 *);
		XhcLog("XHCICmdNoop: timeout crcr=0x%X:%X sts=0x%X cmd=0x%X iman=0x%X evt0=0x%X erdp=0x%X:%X\n",
			XHCIOpRead(XHCI_OP_CRCR + 4), XHCIOpRead(XHCI_OP_CRCR),
			XHCIOpRead(XHCI_OP_USBSTS), XHCIOpRead(XHCI_OP_USBCMD),
			XHCIRtRead(XHCI_RT_IMAN0), evt0,
			XHCIRtRead(XHCI_RT_ERDP0 + 4), XHCIRtRead(XHCI_RT_ERDP0));
		XhcLog("XHCICmdNoop: cmd_ring_phys=0x%X evt_ring_phys=0x%X erst_phys=0x%X db0=0x%X\n",
			usb.cmd_ring_phys, usb.evt_ring_phys, usb.evt_erst_phys,
			*(usb.xhci_base + usb.db_off)(U32 *));
		XhcLog("XHCICmdNoop: cmd_trb0=0x%X:%X evt_trb0=0x%X:%X evt_ccs=%d\n",
			*(usb.cmd_ring + offset(CXHCITrb.control))(U32 *),
			*(usb.cmd_ring + offset(CXHCITrb.status))(U32 *),
			*(usb.evt_ring + offset(CXHCITrb.control))(U32 *),
			*(usb.evt_ring + offset(CXHCITrb.status))(U32 *), usb.evt_ring_cycle);
		return FALSE;
	}
	XhcLog("XHCICmdNoop: ok code=%d\n", usb.cmd_comp_code);
	return TRUE;
}

Bool XHCIReset()
{
	I64 i;
	U32 cmd, sts, mask;

	cmd = XHCIOpRead(XHCI_OP_USBCMD);
	sts = XHCIOpRead(XHCI_OP_USBSTS);
	XhcLog("XHCIReset: start cmd=0x%X sts=0x%X\n", cmd, sts);
	mask = 1 << XHCICMD_RUN;
	cmd &= ~mask;
	XHCIOpWrite(XHCI_OP_USBCMD, cmd);
	for (i = 0; i < 1000; i++)
	{
		if (XHCIOpRead(XHCI_OP_USBSTS) & 1 << XHCISTS_HCH)
			break;
		Sleep(1);
	}
	cmd = XHCIOpRead(XHCI_OP_USBCMD);
	sts = XHCIOpRead(XHCI_OP_USBSTS);
	if (!(sts & 1 << XHCISTS_HCH))
	{
		usb_debug_stage = 120;
		XhcLog("XHCIReset: halt timeout i=%d cmd=0x%X sts=0x%X\n", i, cmd, sts);
		return FALSE;
	}
	XhcLog("XHCIReset: halted i=%d cmd=0x%X sts=0x%X\n", i, cmd, sts);
	XHCIOpWrite(XHCI_OP_USBCMD, 1 << XHCICMD_HCRST);
	for (i = 0; i < 1000; i++)
	{
		if (!(XHCIOpRead(XHCI_OP_USBCMD) & 1 << XHCICMD_HCRST))
			break;
		Sleep(1);
	}
	cmd = XHCIOpRead(XHCI_OP_USBCMD);
	sts = XHCIOpRead(XHCI_OP_USBSTS);
	if (cmd & 1 << XHCICMD_HCRST)
	{
		usb_debug_stage = 121;
		XhcLog("XHCIReset: hcrst stuck i=%d cmd=0x%X sts=0x%X\n", i, cmd, sts);
		return FALSE;
	}
	XhcLog("XHCIReset: hcrst done i=%d cmd=0x%X sts=0x%X\n", i, cmd, sts);
	for (i = 0; i < 1000; i++)
	{
		if (!(XHCIOpRead(XHCI_OP_USBSTS) & 1 << XHCISTS_CNR))
			break;
		Sleep(1);
	}
	cmd = XHCIOpRead(XHCI_OP_USBCMD);
	sts = XHCIOpRead(XHCI_OP_USBSTS);
	if (sts & 1 << XHCISTS_CNR)
	{
		usb_debug_stage = 122;
		XhcLog("XHCIReset: cnr stuck i=%d cmd=0x%X sts=0x%X\n", i, cmd, sts);
		return FALSE;
	}
	XhcLog("XHCIReset: done i=%d cmd=0x%X sts=0x%X\n", i, cmd, sts);
	return TRUE;
}

Bool XHCIRun()
{
	U32 cmd, mask;

	cmd = XHCIOpRead(XHCI_OP_USBCMD);
	cmd |= 1 << XHCICMD_RUN;
	mask = 1 << XHCICMD_IE;
	cmd &= ~mask;
	XHCIOpWrite(XHCI_OP_USBCMD, cmd);
	Sleep(10);
	return !(XHCIOpRead(XHCI_OP_USBSTS) & 1 << XHCISTS_HCH);
}

I64 UsbSlotSpd(I64 portsc_speed)
{
	if (!portsc_speed)
		return 1;
	return portsc_speed;
}

Bool XHCIPortReset(I64 port)
{
	U32 ps;
	I64 i, retry;

	for (retry = 0; retry < 3; retry++)
	{
		ps = XHCIPortRead(port);
		if (!(ps & 1 << XHCIPORT_CCS))
			return FALSE;
		if (ps & 1 << XHCIPORT_PED)
			return TRUE;
		ps |= 1 << XHCIPORT_PR;
		XHCIPortWrite(port, ps);
		for (i = 0; i < 1500; i++)
		{
			ps = XHCIPortRead(port);
			if (!(ps & 1 << XHCIPORT_PR))
				break;
			Sleep(2);
		}
		Sleep(150);
		ps = XHCIPortRead(port);
		if (!(ps & 1 << XHCIPORT_CCS))
			return FALSE;
		if (ps & 1 << XHCIPORT_PED)
			return TRUE;
	}
	ps = XHCIPortRead(port);
	if (ps & 1 << XHCIPORT_CCS)
		return TRUE;
	return FALSE;
}

I64 XHCIPortFind()
{
	I64 i;

	for (i = 0; i < usb.max_ports; i++)
	{
		if (XHCIPortReset(i))
			return i;
	}
	return -1;
}

Bool XHCIDisableSlot(I64 slot)
{
	CXHCITrb trb;

	MemSet(&trb, 0, sizeof(trb));
	trb.status = 0;
	trb.control = XHCI_TRB_CMD_DISABLE_SLOT << 10;
	trb.control |= 1 << XHCI_TRB_IOC;
	trb.control |= slot << 24;
	XHCICmdTrbPost(&trb);
	if (!XHCIEventWaitCmd(1000))
		return FALSE;
	if (usb.cmd_comp_code == 1)
		return TRUE;
	return FALSE;
}

I64 XHCIEnableSlot()
{
	CXHCITrb trb;

	MemSet(&trb, 0, sizeof(trb));
	trb.control = XHCI_TRB_CMD_ENABLE_SLOT << 10;
	trb.control |= 1 << XHCI_TRB_IOC;
	usb.cmd_comp_slot = 0;
	XHCICmdTrbPost(&trb);
	if (!XHCIEventWaitCmd(5000))
		return -1;
	return usb.cmd_comp_slot;
}

U0 EpDequeueSet(U32 *ep, U64 ring_phys, I64 cycle)
{
	U64 dq;

	if (!cycle)
		cycle = 1;
	dq = ring_phys | cycle;
	ep[2] = dq;
	ep[3] = dq >> 32;
}

U0 XHCIEp0RingReset()
{
	CXHCITrb *link;

	if (!usb.ep0_ring)
		return;
	MemSet(usb.ep0_ring, 0, XHCI_RING_SIZE * 16);
	usb.ep0_ring_idx = 0;
	usb.ep0_ring_cycle = 1;
	link = (usb.ep0_ring + XHCI_RING_LINK_IDX * sizeof(CXHCITrb))(CXHCITrb *);
	link->param = usb.ep0_ring_phys;
	link->control = XHCI_TRB_LINK << 10 | 2 | usb.ep0_ring_cycle;
}

U0 XHCIEp0RingSync(I64 slot)
{
	U32 *ep;
	U64 dq;
	I64 idx;

	ep = (usb.dev_ctx + slot * XHCI_CTX_SIZE + usb.ctx_size)(U32 *);
	dq = ep[3];
	dq <<= 32;
	dq |= ep[2];
	usb.ep0_ring_cycle = dq & 1;
	idx = dq & ~0xF;
	idx -= usb.ep0_ring_phys;
	if (idx < 0)
		idx = 0;
	usb.ep0_ring_idx = idx >> 4;
	usb_debug_ep0_state = ep[0] & 7;
}

I64 XHCIEp0MpsGuess(I64 speed)
{
	if (speed >= 4)
		return 512;
	if (speed == 3)
		return 64;
	return 8;
}

U0 XHCIEp0CtxInput(U32 *ep, I64 mps, U64 ring_phys, I64 cycle)
{
	if (!mps)
		mps = 8;
	if (mps > 512)
		mps = 512;
	ep[0] = 0;
	ep[1] = 4 << 3;
	ep[1] |= mps << 16;
	EpDequeueSet(ep, ring_phys, cycle);
	ep[4] = 8;
}

U0 XHCIInputCtxInitAddress(I64 port, I64 speed, U64 ep0_ring_phys, I64 ep0_cycle)
{
	U32 *in_ctrl, *in_slot, *in_ep;
	I64 mps;

	MemSet(usb.input_ctx, 0, XHCI_INPUT_CTX_SIZE);
	in_ctrl = (usb.input_ctx)(U32 *);
	in_ctrl[0] = 0;
	in_ctrl[1] = 3;
	in_slot = (usb.input_ctx + usb.ctx_size)(U32 *);
	in_slot[0] = speed << 20;
	in_slot[0] |= 1 << 27;
	in_slot[1] = port << 16;
	in_slot[2] = 0;
	in_slot[3] = 1 << 8;
	in_ep = (usb.input_ctx + usb.ctx_size * 2)(U32 *);
	mps = XHCIEp0MpsGuess(speed);
	XHCIEp0CtxInput(in_ep, mps, ep0_ring_phys, ep0_cycle);
	usb_debug_ep0_mps = mps;
}

Bool Ep0SetDequeue(I64 slot)
{
	CXHCITrb trb;
	U64 dq;

	dq = usb.ep0_ring_phys | usb.ep0_ring_cycle;
	MemSet(&trb, 0, sizeof(trb));
	trb.param = dq;
	trb.status = 0;
	trb.control = XHCI_TRB_CMD_SET_DEQ << 10;
	trb.control |= 1 << XHCI_TRB_IOC;
	trb.control |= slot << 24;
	trb.control |= 1 << 16;
	XHCICmdTrbPost(&trb);
	if (!XHCIEventWaitCmd(2000))
		return FALSE;
	usb_debug_deq_code = usb.cmd_comp_code;
	if (usb.cmd_comp_code == 1)
		return TRUE;
	return FALSE;
}

Bool XHCIAddressDevice(I64 slot, I64 port, I64 speed)
{
	CXHCITrb trb;

	usb_debug_root_port = port;
	usb_debug_port_speed = speed;
	usb_debug_addr_code = 0;
	usb_debug_deq_code = 0;
	XHCIInputCtxInitAddress(port, speed, usb.ep0_ring_phys, usb.ep0_ring_cycle);
	MemSet(&trb, 0, sizeof(trb));
	trb.param = usb.input_ctx_phys;
	trb.status = 0;
	trb.control = XHCI_TRB_CMD_ADDR_DEV << 10;
	trb.control |= 1 << XHCI_TRB_IOC;
	trb.control |= slot << 24;
	XHCICmdTrbPost(&trb);
	if (!XHCIEventWaitCmd(5000))
	{
		usb_debug_addr_code = usb.cmd_comp_code;
		return FALSE;
	}
	usb_debug_addr_code = usb.cmd_comp_code;
	if (usb.cmd_comp_code != 1)
		return FALSE;
	XHCIEp0RingSync(slot);
	return TRUE;
}

interrupt U0 UsbIrqH()
{
	U32 iman;

	CLD
	XHCIEventAdvance;
	XhkEvtHandle;
	XhmEvtHandle;
	if (sys_usb_input_active & UM)
		XhmAccFlush;
	XHCIOpWrite(XHCI_OP_USBSTS, 1 << XHCISTS_EINT);
	iman = XHCIRtRead(XHCI_RT_IMAN0);
	XHCIRtWrite(XHCI_RT_IMAN0, iman | 1);
	*(dev.uncached_alias + LAPIC_EOI)(U32 *) = 0;
}

U0 XHCIInterruptsSetup()
{
	I64 irq, io_line, io_entry;
	U32 cmd;
	U8 *da = dev.uncached_alias + IOAPIC_REG;
	U32 *io_data = dev.uncached_alias + IOAPIC_DATA;

	if (!usb.active)
		return;
	irq = IntEntryAlloc;
	IntEntrySet(irq, &UsbIrqH);
	// PCI interrupt pin (INTA..D) is not an IOAPIC entry index. Use the BIOS-
	// programmed interrupt line (GSI on APIC systems). Pin-based routing stole
	// IOAPIC entries 0-3 and broke timer/keyboard lines.
	io_line = PCIReadU8(usb.bdf.u8[2], usb.bdf.u8[1], usb.bdf.u8[0], PCIR_INTERRUPT_LINE);
	if (!io_line || io_line == 0xFF)
		io_line = 11;
	if (io_line > 23)
		io_line = 23;
	io_entry = IOREDTAB + io_line * 2;
	*da = io_entry + 1;
	*io_data = dev.mp_apic_ids[0] << 24;
	*da = io_entry;
	*io_data = 0x4000 + irq;
	usb.irq = irq;
	cmd = XHCIOpRead(XHCI_OP_USBCMD);
	cmd |= 1 << XHCICMD_IE;
	XHCIOpWrite(XHCI_OP_USBCMD, cmd);
}

I64 PciMmioBarSize(I64 bdf, I64 rg)
{
	I64 bus, devn, fun, cmd, bar0, bar1, size_mask, size;

	bus = bdf.u8[2];
	devn = bdf.u8[1];
	fun = bdf.u8[0];
	cmd = PCIReadU16(bus, devn, fun, PCIR_COMMAND);
	bar0 = PCIReadU32(bus, devn, fun, rg);
	bar1 = 0;
	if ((bar0 & 6) == 4)
		bar1 = PCIReadU32(bus, devn, fun, rg + 4);
	PCIWriteU16(bus, devn, fun, PCIR_COMMAND, cmd & ~6);
	PCIWriteU32(bus, devn, fun, rg, 0xFFFFFFFF);
	if ((bar0 & 6) == 4)
		PCIWriteU32(bus, devn, fun, rg + 4, 0xFFFFFFFF);
	size_mask = PCIReadU32(bus, devn, fun, rg) & ~0xF;
	PCIWriteU32(bus, devn, fun, rg, bar0);
	if ((bar0 & 6) == 4)
		PCIWriteU32(bus, devn, fun, rg + 4, bar1);
	PCIWriteU16(bus, devn, fun, PCIR_COMMAND, cmd);
	if (!size_mask || size_mask == 0xFFFFFFFF)
		return 0;
	size = (-size_mask) & 0xFFFFFFFF;
	return size;
}

I64 PciMmioBarUse32(I64 bdf, I64 rg)
{
	I64 bus, devn, fun, cmd, bar0, bar1, bar, bar_flags, bar_type, size;
	U8 *base;

	bus = bdf.u8[2];
	devn = bdf.u8[1];
	fun = bdf.u8[0];
	bar0 = PCIReadU32(bus, devn, fun, rg);
	if (bar0 & 1)
		return 0;
	bar1 = 0;
	bar_flags = bar0 & 0xF;
	bar_type = bar0 & 6;
	if (bar_type == 4)
		bar1 = PCIReadU32(bus, devn, fun, rg + 4);
	bar = bar0 & ~0xF;
	if (!bar1 && bar >= 0x100000)
		return bar;

	size = PciMmioBarSize(bdf, rg);
	if (!size)
		return 0;
	base = Mem32DevAlloc(size, size);
	if (!base)
		return 0;

	bar = base;
	cmd = PCIReadU16(bus, devn, fun, PCIR_COMMAND);
	PCIWriteU16(bus, devn, fun, PCIR_COMMAND, cmd & ~6);
	PCIWriteU32(bus, devn, fun, rg, bar | bar_flags);
	if (bar_type == 4)
		PCIWriteU32(bus, devn, fun, rg + 4, 0);
	PCIWriteU16(bus, devn, fun, PCIR_COMMAND, cmd | 6);

	bar0 = PCIReadU32(bus, devn, fun, rg);
	bar1 = 0;
	if (bar_type == 4)
		bar1 = PCIReadU32(bus, devn, fun, rg + 4);
	bar = bar0 & ~0xF;
	if (bar1 || bar < 0x100000)
	{
		Mem32DevFree(base);
		return 0;
	}
	return bar;
}

Bool XHCIControllerInitBdf(I64 bdf)
{
	I64 bar, bar0, bar1, bar2, bar3, bar4, bar5, cmd, hcc, hcs, hcs2, db_off, rt_off;
	I64 cap0, cap4, cap8, capc, cap10, max_sp, sp_pg_sz, i, j;
	U64 page_phys;
	U8 *page, *sp_array;
	U64 sp_array_phys;
	U32 *erst;

	if (bdf == -1)
		return FALSE;
	usb_debug_stage = 11;

	usb.bdf = bdf;
	bar0 = PCIReadU32(bdf.u8[2], bdf.u8[1], bdf.u8[0], PCIR_BASE0);
	bar1 = PCIReadU32(bdf.u8[2], bdf.u8[1], bdf.u8[0], PCIR_BASE1);
	bar2 = PCIReadU32(bdf.u8[2], bdf.u8[1], bdf.u8[0], PCIR_BASE2);
	bar3 = PCIReadU32(bdf.u8[2], bdf.u8[1], bdf.u8[0], PCIR_BASE3);
	bar4 = PCIReadU32(bdf.u8[2], bdf.u8[1], bdf.u8[0], PCIR_BASE4);
	bar5 = PCIReadU32(bdf.u8[2], bdf.u8[1], bdf.u8[0], PCIR_BASE5);
	cmd = PCIReadU16(bdf.u8[2], bdf.u8[1], bdf.u8[0], PCIR_COMMAND);
	XhcLog("XHCIControllerInit: bdf=0x%X cmd=0x%X bars=%X %X %X %X %X %X\n",
		bdf, cmd, bar0, bar1, bar2, bar3, bar4, bar5);
	if (bar0 & 1)
	{
		usb_debug_stage = 123;
		XhcLog("XHCIControllerInit: BAR0 is I/O, not MMIO\n");
		return FALSE;
	}

	bar = PciMmioBarUse32(bdf, PCIR_BASE0);
	if (!bar)
	{
		usb_debug_stage = 124;
		XhcLog("XHCIControllerInit: BAR0 not usable in 32-bit MMIO window\n");
		return FALSE;
	}
	usb_debug_stage = 12;
	XhcLog("XHCIControllerInit: using bar=0x%X\n", bar);
	cmd = PCIReadU16(bdf.u8[2], bdf.u8[1], bdf.u8[0], PCIR_COMMAND);
	PCIWriteU16(bdf.u8[2], bdf.u8[1], bdf.u8[0], PCIR_COMMAND, cmd | 6);
	cmd = PCIReadU16(bdf.u8[2], bdf.u8[1], bdf.u8[0], PCIR_COMMAND);
	XhcLog("XHCIControllerInit: command after enable=0x%X\n", cmd);
	usb.xhci_base = dev.uncached_alias + bar;
	cap0 = XHCICapRead(0x00);
	cap4 = XHCICapRead(0x04);
	cap8 = XHCICapRead(0x08);
	capc = XHCICapRead(0x0C);
	cap10 = XHCICapRead(0x10);
	XhcLog("XHCIControllerInit: cap raw %X %X %X %X %X\n", cap0, cap4, cap8, capc, cap10);
	usb.cap_length = XHCICapRead(XHCI_CAP_CAPLENGTH) & 0xFF;
	hcc = XHCICapRead(XHCI_CAP_HCCPARAMS1);
	XHCILegacyHandoff(hcc);
	XHCIIntelRoutePorts(bdf);
	hcs = XHCICapRead(XHCI_CAP_HCSPARAMS1);
	db_off = XHCICapRead(XHCI_CAP_DBOFF);
	rt_off = XHCICapRead(XHCI_CAP_RTSOFF);
	usb.runtime_off = rt_off & ~0x1F;
	usb.db_off = db_off & ~0x3;
	if (hcc & 4)
		usb.ctx_size = 64;
	else
		usb.ctx_size = 32;
	usb.max_ports = hcs >> 24;
	usb.max_slots = hcs & 0xFF;
	hcs2 = cap8;
	max_sp = (hcs2 >> 27) & 0x1F;
	max_sp <<= 5;
	max_sp |= (hcs2 >> 16) & 0x3F;
	if (max_sp > 64)
		max_sp = 64;
	sp_pg_sz = hcs2 >> 30;
	sp_pg_sz &= 3;
	sp_pg_sz = 4096 << sp_pg_sz;
	XhcLog("XHCIControllerInit: cap=%d hcs=0x%X hcs2=0x%X hcc=0x%X db=0x%X rt=0x%X runtime=0x%X slots=%d ports=%d ctx=%d max_sp=%d\n",
		usb.cap_length, hcs, hcs2, hcc, usb.db_off, rt_off, usb.runtime_off, usb.max_slots, usb.max_ports, usb.ctx_size, max_sp);

	if (!XHCIReset)
		return FALSE;
	usb_debug_stage = 13;

	usb.page_size = XHCIOpRead(XHCI_OP_PAGESIZE) << 12;
	if (!usb.page_size)
		usb.page_size = 4096;

	i = usb.max_slots + 1;
	i <<= 3;
	usb.dcbaa = XHCIAlloc(i, 64, &usb.dcbaa_phys);
	if (max_sp)
	{
		j = max_sp << 3;
		sp_array = XHCIAlloc(j, 64, &sp_array_phys);
		for (i = 0; i < max_sp; i++)
		{
			page = XHCIAlloc(sp_pg_sz, sp_pg_sz, &page_phys);
			*(sp_array + i * sizeof(U64))(U64 *) = page_phys;
		}
		*(usb.dcbaa)(U64 *) = sp_array_phys;
		XhcLog("XHCIControllerInit: scratchpad pages=%d array=0x%X\n", max_sp, sp_array_phys);
	}
	else
		*(usb.dcbaa)(U64 *) = 0;

	usb.cmd_ring = XHCIAlloc(XHCI_RING_SIZE * 16, 64, &usb.cmd_ring_phys);
	usb.evt_ring = XHCIAlloc(XHCI_RING_SIZE * 16, 64, &usb.evt_ring_phys);
	usb.evt_erst = XHCIAlloc(16, 64, &usb.evt_erst_phys);
	usb.dev_ctx = XHCIAlloc(XHCI_CTX_SIZE * (usb.max_slots + 1), 64, &usb.dev_ctx_phys);
	usb.input_ctx = XHCIAlloc(XHCI_INPUT_CTX_SIZE, 64, &usb.input_ctx_phys);
	usb.ctrl_buf = XHCIAlloc(USB_CTRL_BUF_SIZE, 64, &usb.ctrl_buf_phys);
	usb.ms_buf_phys = XHCIPhys(usb.ctrl_buf + udma_ms);
	usb.tab_buf_phys = XHCIPhys(usb.ctrl_buf + udma_tab);
	usb.kbd_buf_phys = XHCIPhys(usb.ctrl_buf + udma_kbd);

	XHCICmdRingReset;
	XHCIEvtRingReset;

	erst = (usb.evt_erst)(U32 *);
	erst[0] = usb.evt_ring_phys;
	erst[1] = usb.evt_ring_phys >> 32;
	*(usb.evt_erst + 8)(U32 *) = XHCI_RING_SIZE;

	XHCIOpWrite(XHCI_OP_DCBAAP, usb.dcbaa_phys);
	XHCIOpWrite(XHCI_OP_DCBAAP + 4, usb.dcbaa_phys >> 32);
	XHCIOpWrite(XHCI_OP_CONFIG, usb.max_slots);
	XHCIOpWrite64(XHCI_OP_CRCR, usb.cmd_ring_phys | 1);

	XHCIRtWrite(XHCI_RT_ERSTSZ0, 1);
	XHCIRtWrite(XHCI_RT_ERSTBA0, usb.evt_erst_phys);
	XHCIRtWrite(XHCI_RT_ERSTBA0 + 4, usb.evt_erst_phys >> 32);
	XHCIErdpUpdate;
	XHCIRtWrite(XHCI_RT_IMAN0, 1 << 1);
	XhcLog("XHCIControllerInit: erst=0x%X ring=0x%X erdp=0x%X\n",
		usb.evt_erst_phys, usb.evt_ring_phys, usb.evt_ring_phys | usb.evt_ring_cycle);

	if (!XHCIRun)
		return FALSE;
	usb_debug_stage = 14;

	if (!XHCICmdNoop)
	{
		usb_debug_stage = 125;
		XhcLog("XHCIControllerInit: command ring/event ring not working\n");
		return FALSE;
	}
	usb.active = TRUE;
	usb_debug_stage = 20;
	return TRUE;
}

Bool XHCIControllerInit()
{
	I64 class_code, bdf;

	class_code = PCIC_SERIAL << 16;
	class_code |= PCISC_USB << 8;
	class_code = class_code | PCIP_USB_XHCI;
	usb_debug_stage = 10;
	bdf = PCIClassFind(class_code, 0);
	return XHCIControllerInitBdf(bdf);
}
