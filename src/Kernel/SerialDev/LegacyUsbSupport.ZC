/* Legacy UHCI/EHCI HID compatibility state.

   This is deliberately separate from Kernel/Usb/KUsb: KUsb remains the sole
   xHCI owner.  These globals and helpers support only the frozen
   archive/utm-usb-ok UHCI/EHCI input path used by UTM's default USB UI
   devices. */

CLegacyUSBStateGlobals legacy_usb;
public I64 sys_usb_input_active;
public I64 usb_debug_stage;
public I64 usb_debug_cfg_len;
public I64 usb_debug_poll_count;

public U0 EhciDebugSave()
{
}

U64 UcSetupPack(U8 req_type, U8 request, U16 value, U16 index, U16 len)
{//USB setup packet shared by the isolated UHCI and EHCI control paths.
	U64 res = 0;
	U8 *p = &res;

	p[0] = req_type;
	p[1] = request;
	p[2] = value;
	p[3] = value >> 8;
	p[4] = index;
	p[5] = index >> 8;
	p[6] = len;
	p[7] = len >> 8;
	return res;
}

I64 LegacyPciMmioBarSize(I64 bdf, I64 rg)
{
	I64 bus, devn, fun, cmd, bar0, bar1, size_mask, size;

	bus = bdf.u8[2];
	devn = bdf.u8[1];
	fun = bdf.u8[0];
	cmd = PCIReadU16(bus, devn, fun, PCIR_COMMAND);
	bar0 = PCIReadU32(bus, devn, fun, rg);
	bar1 = 0;
	if ((bar0 & 6) == 4)
		bar1 = PCIReadU32(bus, devn, fun, rg + 4);
	PCIWriteU16(bus, devn, fun, PCIR_COMMAND, cmd & ~6);
	PCIWriteU32(bus, devn, fun, rg, 0xFFFFFFFF);
	if ((bar0 & 6) == 4)
		PCIWriteU32(bus, devn, fun, rg + 4, 0xFFFFFFFF);
	size_mask = PCIReadU32(bus, devn, fun, rg) & ~0xF;
	PCIWriteU32(bus, devn, fun, rg, bar0);
	if ((bar0 & 6) == 4)
		PCIWriteU32(bus, devn, fun, rg + 4, bar1);
	PCIWriteU16(bus, devn, fun, PCIR_COMMAND, cmd);
	if (!size_mask || size_mask == 0xFFFFFFFF)
		return 0;
	size = (-size_mask) & 0xFFFFFFFF;
	return size;
}

I64 LegacyPciMmioBarUse32(I64 bdf, I64 rg)
{
	I64 bus, devn, fun, cmd, bar0, bar1, bar, bar_flags, bar_type, size;
	U8 *base;

	bus = bdf.u8[2];
	devn = bdf.u8[1];
	fun = bdf.u8[0];
	bar0 = PCIReadU32(bus, devn, fun, rg);
	if (bar0 & 1)
		return 0;
	bar1 = 0;
	bar_flags = bar0 & 0xF;
	bar_type = bar0 & 6;
	if (bar_type == 4)
		bar1 = PCIReadU32(bus, devn, fun, rg + 4);
	bar = bar0 & ~0xF;
	if (!bar1 && bar >= 0x100000)
		return bar;

	size = LegacyPciMmioBarSize(bdf, rg);
	if (!size)
		return 0;
	base = Mem32DevAlloc(size, size);
	if (!base)
		return 0;

	bar = base;
	cmd = PCIReadU16(bus, devn, fun, PCIR_COMMAND);
	PCIWriteU16(bus, devn, fun, PCIR_COMMAND, cmd & ~6);
	PCIWriteU32(bus, devn, fun, rg, bar | bar_flags);
	if (bar_type == 4)
		PCIWriteU32(bus, devn, fun, rg + 4, 0);
	PCIWriteU16(bus, devn, fun, PCIR_COMMAND, cmd | 6);

	bar0 = PCIReadU32(bus, devn, fun, rg);
	bar1 = 0;
	if (bar_type == 4)
		bar1 = PCIReadU32(bus, devn, fun, rg + 4);
	bar = bar0 & ~0xF;
	if (bar1 || bar < 0x100000)
	{
		Mem32DevFree(base);
		return 0;
	}
	return bar;
}

Bool XhcXferOk(I64 code)
{
	return code == LEGACY_XHCI_CC_SUCCESS || code == LEGACY_XHCI_CC_SHORT_PACKET;
}

/* The imported report handlers retain their frozen xHCI callbacks for source
   fidelity.  Legacy compatibility never owns xHCI, so these are intentionally
   inert; UHCI/EHCI invoke XhkRptHandle/XhmRptHandle directly. */
U0 XHCIEventAdvance()
{
}

U0 XhkIntrSub()
{
}

U0 XhmIntrSub()
{
}

I64 HidRptKind(U8 *rpt, I64 len)
{
	I64 i = 0, b, sz, typ, tag, val, page = 0, kind = LEGACY_UHID_KIND_NONE;

	while (i < len)
	{
		b = rpt[i++];
		if (b == 0xFE)
		{
			if (i >= len)
				break;
			sz = rpt[i++];
			i++;
			i += sz;
		}
		else
		{
			sz = b & 3;
			if (sz == 3)
				sz = 4;
			typ = b >> 2 & 3;
			tag = b >> 4 & 15;
			if (i + sz > len)
				break;
			val = 0;
			if (sz >= 1)
				val |= rpt[i];
			if (sz >= 2)
				val |= rpt[i + 1] << 8;
			if (sz >= 4)
			{
				val |= rpt[i + 2] << 16;
				val |= rpt[i + 3] << 24;
			}
			if (typ == 1 && tag == 0)
				page = val;
			else if (typ == 2 && tag == 0)
			{
				if (page == 1)
				{
					if (val == 6)
						return LEGACY_UHID_KIND_KBD;
					if (val == 1 || val == 2)
						kind = LEGACY_UHID_KIND_MOUSE;
				}
				else if (page == 0x0D && (val == 4 || val == 5))
					kind = LEGACY_UHID_KIND_MOUSE;
			}
			i += sz;
		}
	}
	return kind;
}
