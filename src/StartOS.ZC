//This is executed by the System task at boot.
//See $LK,"System Start-up",A="FF:::/Kernel/KMain.ZC,\"StartOS"$.

#help_index "Compiler/Directive"
public extern I8i Option(I64i num, I8i val);
Option(0,0); //(0,0)=EchoOff	 (0,1)=EchoOn

#include "/Kernel/KernelA.HH"
#include "/Compiler/CompilerA.HH"
#include "/Kernel/KernelB.HH"
#include "/Kernel/KernelC.HH"
#include "/Compiler/CompilerB.HH"

Option(OPTf_WARN_PAREN, OFF);
Option(OPTf_WARN_DUP_TYPES, OFF);

#exe {
	Option(OPTf_WARN_PAREN, OFF);
	Option(OPTf_WARN_DUP_TYPES, OFF);
};
HashTablePurge(sys_task->hash_table);

U0 BootStatusType(U8 *filename)
{
	I64 size;
	U8 *buf;

	if (buf = FileRead(filename, &size))
	{
		"%s", buf;
		Free(buf);
	}
}

// Rebuild kernel before MakeSystem - loading System + WinMgr first exhausts RAM for Comp().
// See ::/Doc/USBBoot.DD
if (Letter2Drive('C', FALSE))
{
	U8 *start_os_after_system;

	Cd("C:/Home");
	Del("C:/Home/BootAutoKernelConfig.DD",, FALSE, FALSE);
	if (FileFind("BootInsPending.DD") || FileFind(".boot_ins_pending"))
	{
		Del("BootInsPending.DD",, FALSE, FALSE);
		Del(".boot_ins_pending",, FALSE, FALSE);
		Del("OnceRebuildKernel.DD",, FALSE, FALSE);
		Del(".once_rebuild_kernel",, FALSE, FALSE);
		"Rebuilding kernel (USB skipped this boot for RAM)...\n";
		ExeFile("/Home/BootKernelOnly");
		"\n$$RED$$Kernel rebuild did not finish.$$FG$$\n";
		if (FileFind("C:/Home/BootInsErrs.DD"))
		{
			"BootInsErrs.DD:\n";
			BootStatusType("C:/Home/BootInsErrs.DD");
		}
		if (FileFind("C:/Home/BootInsStage.DD"))
		{
			"BootInsStage.DD:\n";
			BootStatusType("C:/Home/BootInsStage.DD");
		}
		"\nFix sources, patch disk, click Rebuild Kernel again.\n";
		"\nOr force-quit VM and run REMOVE_BOOT_INS_PENDING=1 build/patch-utm-disk.sh\n";
		while (TRUE)
			Sleep(1000);
	}
	if (FileFind("AutoISOBuild.DD") || FileFind(".auto_iso_build"))
	{
		// Prefer staged OSBuild scripts when present so AUTO.ISO leftovers
		// (In(ata_port), old stage3) do not run after the host copies src/.
		if (FileFind("AutoISOStage5.DD"))
			start_os_after_system = "\"USB boot skipped for automated build.\\n\";\n"
					"\"Auto ISO build stage 5.\\n\";\n"
					"if (FileFind(\"/Tmp/OSBuild/Misc/Auto/AutoFullDistro5.ZC\"))\n"
					"\tExeFile(\"/Tmp/OSBuild/Misc/Auto/AutoFullDistro5.ZC\");\n"
					"else\n"
					"\tExeFile(\"/Misc/Auto/AutoFullDistro5.ZC\");\n"
					"while (TRUE)\n\tSleep(1000);\n";
		else if (FileFind("AutoISOStage4.DD"))
			start_os_after_system = "\"USB boot skipped for automated build.\\n\";\n"
					"\"Auto ISO build stage 4.\\n\";\n"
					"if (FileFind(\"/Tmp/OSBuild/Misc/Auto/AutoFullDistro4.ZC\"))\n"
					"\tExeFile(\"/Tmp/OSBuild/Misc/Auto/AutoFullDistro4.ZC\");\n"
					"else\n"
					"\tExeFile(\"/Misc/Auto/AutoFullDistro4.ZC\");\n"
					"while (TRUE)\n\tSleep(1000);\n";
		else if (FileFind("AutoISOStage3.DD"))
			start_os_after_system = "\"USB boot skipped for automated build.\\n\";\n"
					"\"Auto ISO build stage 3.\\n\";\n"
					"if (FileFind(\"/Tmp/OSBuild/Misc/Auto/AutoFullDistro3.ZC\"))\n"
					"\tExeFile(\"/Tmp/OSBuild/Misc/Auto/AutoFullDistro3.ZC\");\n"
					"else\n"
					"\tExeFile(\"/Misc/Auto/AutoFullDistro3.ZC\");\n"
					"while (TRUE)\n\tSleep(1000);\n";
		else if (FileFind("AutoISOStage2.DD"))
			start_os_after_system = "\"USB boot skipped for automated build.\\n\";\n"
					"\"Auto ISO build stage 2.\\n\";\n"
					"if (FileFind(\"/Tmp/OSBuild/Misc/Auto/AutoFullDistro2.ZC\"))\n"
					"\tExeFile(\"/Tmp/OSBuild/Misc/Auto/AutoFullDistro2.ZC\");\n"
					"else\n"
					"\tExeFile(\"/Misc/Auto/AutoFullDistro2.ZC\");\n"
					"while (TRUE)\n\tSleep(1000);\n";
		else if (FileFind("AutoISOStage1.DD"))
			start_os_after_system = "\"USB boot skipped for automated build.\\n\";\n"
					"\"Auto ISO build stage 1.\\n\";\n"
					"if (FileFind(\"/Tmp/OSBuild/Misc/Auto/AutoFullDistro1.ZC\"))\n"
					"\tExeFile(\"/Tmp/OSBuild/Misc/Auto/AutoFullDistro1.ZC\");\n"
					"else\n"
					"\tExeFile(\"/Misc/Auto/AutoFullDistro1.ZC\");\n"
					"while (TRUE)\n\tSleep(1000);\n";
		else
			start_os_after_system = "\"USB boot skipped for automated build.\\n\";\n"
					"\"Auto ISO build stage 0.\\n\";\n"
					"if (FileFind(\"/Tmp/OSBuild/Misc/Auto/AutoFullDistro0.ZC\"))\n"
					"\tExeFile(\"/Tmp/OSBuild/Misc/Auto/AutoFullDistro0.ZC\");\n"
					"else\n"
					"\tExeFile(\"/Misc/Auto/AutoFullDistro0.ZC\");\n"
					"while (TRUE)\n\tSleep(1000);\n";
	}
	else if (FileFind("NormalRebuildKernel.DD") || FileFind(".normal_rebuild_kernel") ||
			FileFind("OnceRebuildKernel.DD") || FileFind(".once_rebuild_kernel"))
	{
		start_os_after_system = "\"USB boot skipped for automated build.\\n\";\n";
	}
	else
	{
		start_os_after_system = "CHashFun *tmpf;\n"
				"if ((tmpf = HashFind(\"UsbBootInit\", Fs->hash_table, HTT_FUN)) &&\n"
				"\t\t!Bt(&tmpf->flags, Cf_EXTERN) && !Bt(&tmpf->flags, Ff__EXTERN))\n"
				"{\n"
				"\tExePrint(\"UsbBootInit;\");\n"
				"}\n";
	}
	FileWrite("StartOSAfterSystem.ZC", start_os_after_system, StrLen(start_os_after_system));
}

#include "/System/MakeSystem"

#exe {
	Option(OPTf_WARN_PAREN, OFF);
	Option(OPTf_WARN_DUP_TYPES, OFF);
};
Option(OPTf_WARN_PAREN, OFF);
Option(OPTf_WARN_DUP_TYPES, OFF);

// Native USB first. PS/2 fills anything USB misses.
// See ::/Doc/USBBoot.DD

//Debug("Type 'G;'");
DocTermNew;
WinVert(2, text.rows / 8);

sys_winmgr_task = Spawn(&WinMgrTask, NULL, "Window Manager");
Fs->win_inhibit = WIG_TASK_DEFAULT - WIF_SELF_BORDER - WIF_SELF_GRAB_SCROLL - WIF_SELF_CTRLS;
LBts(&Fs->display_flags, DISPLAYf_CHILDREN_NOT_ON_TOP);
LBts(&Fs->display_flags, DISPLAYf_SHOW);

ExeFile("/Home/StartOSAfterSystem.ZC");

RegInit;
ExeFile("/Home/MakeHome.ZC");

//After this file, the System task enters $LK,"server mode",A="HI:Job"$.
