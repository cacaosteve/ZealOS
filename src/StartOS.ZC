//This is executed by the System task at boot.
//See $LK,"System Start-up",A="FF:::/Kernel/KMain.ZC,\"StartOS"$.

#help_index "Compiler/Directive"
public extern I8i Option(I64i num, I8i val);
Option(0,0); //(0,0)=EchoOff	 (0,1)=EchoOn

#include "/Kernel/KernelA.HH"
#include "/Compiler/CompilerA.HH"
#include "/Kernel/KernelB.HH"
#include "/Kernel/KernelC.HH"
#include "/Compiler/CompilerB.HH"

Option(OPTf_WARN_PAREN, OFF);
Option(OPTf_WARN_DUP_TYPES, OFF);

#exe {
	Option(OPTf_WARN_PAREN, OFF);
	Option(OPTf_WARN_DUP_TYPES, OFF);
};
HashTablePurge(sys_task->hash_table);

Bool AutoISOStageWrite(U8 *filename)
{
	I64 size;
	U8 *buf;

	if (!(buf = FileRead(filename, &size)))
		return FALSE;
	FileWrite("C:/Home/StartOSAfterSystem.ZC", buf, size);
	Free(buf);
	return TRUE;
}

Bool boot_kernel_pending = FALSE;

// Stage a pending rebuild before MakeSystem, then execute it immediately after
// compiler services load and before WinMgr/USB consume the remaining RAM.
// See ::/Doc/USBBoot.DD
if (Letter2Drive('C', FALSE))
{
	Bool auto_iso_stage = FALSE;
	U8 *start_os_after_system;

	Cd("C:/Home");
	Del("C:/Home/BootAutoKernelConfig.DD",, FALSE, FALSE);
	if (FileFind("BootInsPending.DD") || FileFind(".boot_ins_pending"))
	{
		Del("BootInsPending.DD",, FALSE, FALSE);
		Del(".boot_ins_pending",, FALSE, FALSE);
		Del("OnceRebuildKernel.DD",, FALSE, FALSE);
		Del(".once_rebuild_kernel",, FALSE, FALSE);
		boot_kernel_pending = TRUE;
		start_os_after_system = "/Home/BootKernelOnly.ZC";
	}
	else if (FileFind("AutoISOBuild.DD") || FileFind(".auto_iso_build") ||
		FileFind("AutoISOStage0.DD") || FileFind("AutoISOStage1.DD") ||
		FileFind("AutoISOStage2.DD") || FileFind("AutoISOStage3.DD") ||
		FileFind("AutoISOStage4.DD") || FileFind("AutoISOStage5.DD"))
	{
		// Prefer staged OSBuild scripts when present so AUTO.ISO leftovers
		// (In(ata_port), old stage3) do not run after the host copies src/.
		// Any Stage*.DD means AutoISO - never UsbBootInit (xHCI hangs QEMU).
		auto_iso_stage = TRUE;
		if (FileFind("AutoISOStage5.DD"))
		{
			if (FileFind("/Tmp/OSBuild/Misc/Auto/AutoFullDistro5.ZC"))
				start_os_after_system = "/Tmp/OSBuild/Misc/Auto/AutoFullDistro5.ZC";
			else
				start_os_after_system = "/Misc/Auto/AutoFullDistro5.ZC";
		}
		else if (FileFind("AutoISOStage4.DD"))
		{
			if (FileFind("/Tmp/OSBuild/Misc/Auto/AutoFullDistro4.ZC"))
				start_os_after_system = "/Tmp/OSBuild/Misc/Auto/AutoFullDistro4.ZC";
			else
				start_os_after_system = "/Misc/Auto/AutoFullDistro4.ZC";
		}
		else if (FileFind("AutoISOStage3.DD"))
		{
			if (FileFind("/Tmp/OSBuild/Misc/Auto/AutoFullDistro3.ZC"))
				start_os_after_system = "/Tmp/OSBuild/Misc/Auto/AutoFullDistro3.ZC";
			else
				start_os_after_system = "/Misc/Auto/AutoFullDistro3.ZC";
		}
		else if (FileFind("AutoISOStage2.DD"))
		{
			if (FileFind("/Tmp/OSBuild/Misc/Auto/AutoFullDistro2.ZC"))
				start_os_after_system = "/Tmp/OSBuild/Misc/Auto/AutoFullDistro2.ZC";
			else
				start_os_after_system = "/Misc/Auto/AutoFullDistro2.ZC";
		}
		else if (FileFind("AutoISOStage1.DD"))
		{
			if (FileFind("/Tmp/OSBuild/Misc/Auto/AutoFullDistro1.ZC"))
				start_os_after_system = "/Tmp/OSBuild/Misc/Auto/AutoFullDistro1.ZC";
			else
				start_os_after_system = "/Misc/Auto/AutoFullDistro1.ZC";
		}
		else
		{
			if (FileFind("/Tmp/OSBuild/Misc/Auto/AutoFullDistro0.ZC"))
				start_os_after_system = "/Tmp/OSBuild/Misc/Auto/AutoFullDistro0.ZC";
			else
				start_os_after_system = "/Misc/Auto/AutoFullDistro0.ZC";
		}
	}
	else if (FileFind("NormalRebuildKernel.DD") || FileFind(".normal_rebuild_kernel") ||
			FileFind("OnceRebuildKernel.DD") || FileFind(".once_rebuild_kernel"))
	{
		start_os_after_system = "\"USB boot skipped for automated build.\\n\";\n";
	}
	else
	{
		start_os_after_system = "CHashFun *tmpf;\n"
				"if ((tmpf = HashFind(\"UsbBootInit\", Fs->hash_table, HTT_FUN)) &&\n"
				"\t\t!Bt(&tmpf->flags, Cf_EXTERN) && !Bt(&tmpf->flags, Ff__EXTERN))\n"
				"{\n"
				"\tExePrint(\"UsbBootInit;\");\n"
				"}\n";
	}
	if (auto_iso_stage || boot_kernel_pending)
	{
		// StartOS executes this file after MakeSystem. Copy the actual helper
		// or stage source here so it is compiled once without a nested JIT.
		if (!AutoISOStageWrite(start_os_after_system))
		{
			"$$RED$$AutoISO stage source missing: %s$$FG$$\n", start_os_after_system;
			start_os_after_system = "\"AutoISO stage source missing.\\n\";\n"
					"while (TRUE)\n\tSleep(1000);\n";
			FileWrite("StartOSAfterSystem.ZC", start_os_after_system,
					StrLen(start_os_after_system));
		}
	}
	else
		FileWrite("StartOSAfterSystem.ZC", start_os_after_system,
				StrLen(start_os_after_system));
}

#include "/System/MakeSystem"

#exe {
	Option(OPTf_WARN_PAREN, OFF);
	Option(OPTf_WARN_DUP_TYPES, OFF);
};
Option(OPTf_WARN_PAREN, OFF);
Option(OPTf_WARN_DUP_TYPES, OFF);

if (boot_kernel_pending)
{
	"Rebuilding kernel after MakeSystem (USB/WinMgr not started)...\n";
	ExeFile("/Home/StartOSAfterSystem.ZC");
}

// Native USB first. PS/2 fills anything USB misses.
// See ::/Doc/USBBoot.DD

//Debug("Type 'G;'");
DocTermNew;
WinVert(2, text.rows / 8);

sys_winmgr_task = Spawn(&WinMgrTask, NULL, "Window Manager");
Fs->win_inhibit = WIG_TASK_DEFAULT - WIF_SELF_BORDER - WIF_SELF_GRAB_SCROLL - WIF_SELF_CTRLS;
LBts(&Fs->display_flags, DISPLAYf_CHILDREN_NOT_ON_TOP);
LBts(&Fs->display_flags, DISPLAYf_SHOW);

if (!boot_kernel_pending)
	ExeFile("/Home/StartOSAfterSystem.ZC");

RegInit;
ExeFile("/Home/MakeHome.ZC");

//After this file, the System task enters $LK,"server mode",A="HI:Job"$.
