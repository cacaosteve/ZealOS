//See $LK,"Install Documentation",A="FI:::/Doc/Install.DD"$.
//Study the account examples: $LK,"Config Strs",A="FL:::/Demo/AcctExample/TOS/TOSConfig.ZC,1"$, $LK,"Update Funs",A="FL:::/Demo/AcctExample/TOS/TOSDistro.ZC,1"$

#exe {
	Option(OPTf_WARN_PAREN, OFF);
	Option(OPTf_WARN_DUP_TYPES, OFF);
};

#include "BootHD"

#help_index "Install"

#define KERNEL_ZXE			"Kernel.ZXE"
#define BOOT_DIR				"/Boot"
#define BOOT_DIR_KERNEL_ZXE	BOOT_DIR "/" KERNEL_ZXE

U0 CompComp()
{
	if (Comp("/Compiler/Compiler", "Compiler",, ':'))
		throw;
}

U0 MakeAll()
{
	CompComp;
	if (Comp("/Kernel/Kernel", "Kernel",, ':'))
		throw;
}

U0 BootHDInsKernelFinish(CDrive *drive, Bool move_kernel)
{
	CFAT32Boot	 br;
	CDirEntry	 de;
	I64			 i;

	switch (Letter2BlkDevType(drive->drv_let))
	{
		case BDT_RAM:
		case BDT_ATA:
		case BDT_USB:
			if (move_kernel)
				Move("/Kernel/Kernel.ZXE", BOOT_DIR_KERNEL_ZXE);
			else
				"Using existing %s.\n", BOOT_DIR_KERNEL_ZXE;

			if (!FileFind(BOOT_DIR_KERNEL_ZXE, &de, FUF_JUST_FILES))
				"No Kernel.ZXE\n";
			else
			{
				Free(de.full_name);
				"Modifying partition boot record.\n";
				BlkRead(drive, &br, drive->drv_offset, 1);

				br.jump_and_nop[0] = OC_JMP_REL8;
				br.jump_and_nop[1] = offset(CFAT32Boot.code) - 2;

#assert offset(CFAT32Boot.code) >= offset(CRedSeaBoot.code)

				br.jump_and_nop[2] = OC_NOP;
				*BHD_BLK_COUNT(U16 *) = (de.size + BLK_SIZE - 1) >> BLK_SIZE_BITS;
				*BHD_DAP_BLK(I64 *) = Clus2Blk(drive, de.clus);

				for (i = 0; i < BHD_END - BHD_CODE; i++)
					br.code[i] = BHD_CODE(U8 *)[i];

#assert sizeof(CFAT32Boot.code) >= BHD_END - BHD_CODE

				for (; i < sizeof(CFAT32Boot.code); i++)
					br.code[i] = 0;

				BlkWrite(drive, &br, drive->drv_offset, 1);
				"Partition boot record updated.\n";
			}
			break;

		default:
			throw;
	}
}

public U0 BootHDIns(U8 drv_let=0)
{//$LK,"MakeAll",A="MN:MakeAll"$ and install new boot-loader.
	CDrive *drive;

	try
	{
		if (!Drive(drv_let))
			throw;

		drive = Fs->cur_dv;
		MakeAll;
		BootHDInsKernelFinish(drive, TRUE);
	}
	catch
	{
		PutExcept;
		Beep;
		// Rethrow so AutoISO stages do not advance after a failed Comp and
		// reboot-loop on a half-updated tree / StartOS panic.
		throw;
	}
}

public U0 BootHDInsPrebuilt(U8 drv_let=0)
{//Install the kernel already copied from a live ISO without recompiling it.
	try
	{
		if (!Drive(drv_let))
			throw;
		BootHDInsKernelFinish(Fs->cur_dv, FALSE);
	}
	catch
	{
		PutExcept;
		Beep;
	}
}

public U0 BootHDInsAuto(U8 drv_let='C', I64 hd_port=0, I64 cd_port=1)
{//Recompile/install kernel using the noninteractive kernel config.
	no_warn hd_port, cd_port;
	BootHDIns(drv_let);
}

public U0 BootHDInsAutoReboot(U8 drv_let='C', I64 hd_port=0, I64 cd_port=1)
{
	BootHDInsAuto(drv_let, hd_port, cd_port);
	Reboot;
}

public U0 BootHDInsAutoKernelOnlyReboot(U8 drv_let='C', I64 hd_port=0, I64 cd_port=1)
{
	I64 errs;

	Cd("C:/");
	no_warn drv_let, hd_port, cd_port;
	FileWrite("C:/Home/BootInsStage.DD", "kernel", 6);
	errs = Comp("/Kernel/Kernel", "Kernel",, ':');
	if (errs)
	{
		FileWrite("C:/Home/BootInsErrs.DD", "errs", 4);
		throw;
	}

	FileWrite("C:/Home/BootInsStage.DD", "copy", 4);
	Del(BOOT_DIR_KERNEL_ZXE,, FALSE, FALSE);
	if (!Copy("/Kernel/Kernel.ZXE", BOOT_DIR_KERNEL_ZXE))
	{
		FileWrite("C:/Home/BootInsErrs.DD", "copy", 4);
		throw;
	}

	FileWrite("C:/Home/BootInsStage.DD", "reboot", 6);
	Reboot;
}

public U0 NormalRebuildKernel();

public U0 BootHDInsPendingReboot()
{//Legacy click target. Use the safer normal-boot rebuild path.
	NormalRebuildKernel;
}

public U0 NormalRebuildKernel()
{//Mouse-only: reboot normally, then /Home/Once.ZC rebuilds after system server starts.
	FileWrite("C:/Home/NormalRebuildKernel.DD", "1", 1);
	FileWrite("C:/Home/.normal_rebuild_kernel", "1", 1);
	Del("C:/Home/BootInsPending.DD",, FALSE, FALSE);
	Del("C:/Home/.boot_ins_pending",, FALSE, FALSE);
	Reboot;
}

public U0 RebuildKernel()
{//Safe command name (do not type BootInsAuto - HolyC misparses that as BootIns.Auto).
	NormalRebuildKernel;
}

public U0 UsbBootEnable()
{//Legacy no-op. StartOS always tries UsbBootInit now (see ::/Doc/USBBoot.DD).
}
