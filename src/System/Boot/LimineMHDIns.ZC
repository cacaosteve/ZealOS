
#ifndef binary_limine_hdd_bin_data
U8 binary_limine_hdd_bin_data[0];
#endif

Bool LimineRawRead(CBlkDev *bd, U8 *buf, I64 blk, I64 count)
{//Runtime-dispatched raw read for ATA or USB boot-loader installs.
	CHash	*h = HashFind("BlkDevRawBlksRead", Fs->hash_table, HTT_FUN | HTT_EXPORT_SYS_SYM);
	I64		 fp = 0;

	if (h)
		if (h->type & HTT_FUN)
			fp = h(CHashFun *)->exe_addr;
		else
			fp = h(CHashExport *)->val;
	if (fp)
		return CallInd(fp, bd, buf, blk, count);
	return AHCIAtaBlksRead(bd, buf, blk, count);
}

Bool LimineRawWrite(CBlkDev *bd, U8 *buf, I64 blk, I64 count)
{//Runtime-dispatched raw write for ATA or USB boot-loader installs.
	CHash	*h = HashFind("BlkDevRawBlksWrite", Fs->hash_table, HTT_FUN | HTT_EXPORT_SYS_SYM);
	I64		 fp = 0;

	if (h)
		if (h->type & HTT_FUN)
			fp = h(CHashFun *)->exe_addr;
		else
			fp = h(CHashExport *)->val;
	if (fp)
		return CallInd(fp, bd, buf, blk, count);
	return AHCIAtaBlksWrite(bd, buf, blk, count);
}

#define LIMINE_CFG_BUF_SIZE		8192

Bool LimineBootFilesFind(U8 drv_let)
{
	Bool old_silent, res;
	U8	*filename_sys = MStrPrint("%C:/Boot/Limine-BIOS.SYS", drv_let),
		*filename_elf = MStrPrint("%C:/Boot/ZealBooter.ELF", drv_let),
		*filename_zxe = MStrPrint("%C:/Boot/Kernel.ZXE", drv_let);

	old_silent = Silent;
	Silent;
	res = FileFind(filename_elf,, FUF_JUST_FILES) &&
			FileFind(filename_zxe,, FUF_JUST_FILES);
	if (res && !sys_is_uefi_booted)
		res = FileFind(filename_sys,, FUF_JUST_FILES);
	Silent(old_silent);

	Free(filename_sys);
	Free(filename_elf);
	Free(filename_zxe);

	return res;
}

Bool LimineCFGMake(U8 drv_let, Bool scan_all_drives=TRUE)
{
	U8		*filename_cfg = MStrPrint("%C:/Boot/Limine.CONF", drv_let);
	CDrive	*drive;
	I64		 i, cfg_len, entry_len;
	U8		*cfg = MAlloc(LIMINE_CFG_BUF_SIZE), *entry, *st;

	"\nGenerating Limine.CONF ...\n";

	cfg[0] = 0;
	if (sys_is_uefi_booted)
		CatPrint(cfg,
				"timeout: 2\n"
				"interface_resolution: 1024x768\n\n");
	else
		CatPrint(cfg,
				"timeout: 2\n"
				"interface_resolution: 640x480\n\n");

	"Searching drives for Limine bootloader files ...\n";
	if (!scan_all_drives)
		"VM install: limiting Limine configuration to %C:/.\n", drv_let;
	for (i = 0, drive = blkdev.drvs; i < DRIVES_NUM; i++, drive++)
	{
		if (drive->drive_signature == DRIVE_SIGNATURE_VAL && drive->fs_type == FSt_FAT32)
		{
			if ((scan_all_drives || Drive2Letter(drive) == drv_let) && DriveIsWritable(Drive2Letter(drive)))
			{
				if (LimineBootFilesFind(Drive2Letter(drive)))
				{
					if (sys_is_uefi_booted)
						entry = MStrPrint("/ZealOS %C:/\n"
							"protocol: limine\n"
							"resolution: 1024x768\n"
							"path: boot(%d):/Boot/ZealBooter.ELF\n"
							"module_path: boot(%d):/Boot/Kernel.ZXE\n"
							"\n", Drive2Letter(drive), drive->prt_num + 1, drive->prt_num + 1);
					else
						entry = MStrPrint("/ZealOS %C:/\n"
							"protocol: limine\n"
							"resolution: 640x480\n"
							"path: boot(%d):/Boot/ZealBooter.ELF\n"
							"module_path: boot(%d):/Boot/Kernel.ZXE\n"
							"\n", Drive2Letter(drive), drive->prt_num + 1, drive->prt_num + 1);
					cfg_len		= StrLen(cfg);
					entry_len	= StrLen(entry);
					if (cfg_len + entry_len < LIMINE_CFG_BUF_SIZE)
					{
						CatPrint(cfg, "%s", entry);
						"%C:/ drive added as a Limine.CONF menu entry.\n", Drive2Letter(drive);
					}
					else
						"%C:/ skipped; Limine.CONF buffer full.\n", Drive2Letter(drive);
					Free(entry);
				}
				else
					"%C:/ drive is missing Limine bootloader files.\n", Drive2Letter(drive);
			}
		}
	}
	cfg_len = StrLen(cfg);
	if (!FileWrite(filename_cfg, cfg, cfg_len))
	{
		PrintErr("Failed to write %s.\n", filename_cfg);
		Free(cfg);
		Free(filename_cfg);

		return FALSE;
	}

	"/Boot/Limine.CONF generated.\n";

	if (scan_all_drives)
	{
		"Copying Limine.CONF to all other drives ...\n";
		for (i = 0, drive = blkdev.drvs; i < DRIVES_NUM; i++, drive++)
		{
			if (drive->drive_signature == DRIVE_SIGNATURE_VAL && drive->fs_type == FSt_FAT32 && DriveIsWritable(drive->drv_let))
			{
				if (Drive2Letter(drive) != drv_let && LimineBootFilesFind(Drive2Letter(drive)))
				{
					st = MStrPrint("%C:/Boot/Limine.CONF", Drive2Letter(drive));
					if (FileWrite(st, cfg, cfg_len))
						"%C:/ Limine.CONF copied.\n", Drive2Letter(drive);
					else
						PrintErr("Failed to write %s.\n", st);
					Free(st);
				}
			}
		}
	}
	Free(cfg);
	Free(filename_cfg);

	return TRUE;
}

Bool LimineMHDIns(U8 drv_let, Bool scan_all_drives=TRUE)
{
	U8	*limine			= binary_limine_hdd_bin_data;
	U16  limine_size	= sizeof(binary_limine_hdd_bin_data);
	U64 *limine_stage2	= limine + 0x1A4;
	CBlkDev				*bd = Letter2BlkDev(drv_let);
	CMasterBoot			 old_mbr, *new_mbr = limine;

	if (limine_size == 0)
	{
		"\n" ST_ERR_ST "Limine HDD MBR binary bytes not found. Must first #include it, then recompile this file.\n";
		return FALSE;
	}

	'\n';

	*limine_stage2 = 0x200;

	BlkDevLock(bd);

	LimineRawRead(bd, &old_mbr, 0, 1); // read old MBR currently on disk
	MemCopy(new_mbr->p, old_mbr.p, sizeof(CMasterBoot.p)); // copy old MBR partition table to new Limine MBR

	// read the whole MBR + post-MBR-gap that Limine wants to overwrite, save all of that as an OldMBR.BIN
	BootMHDOldRead(drv_let, drv_let, 63);

	LimineRawWrite(bd, limine, 0, 63); // write Limine to MBR and post-MBR gap

	BlkDevUnlock(bd);

	LimineCFGMake(drv_let, scan_all_drives);

	"\nLimine BSD2-licensed HDD MBR Boot Loader installed.\n\n";

	return TRUE;

}
