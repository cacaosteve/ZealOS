U0 Auto()
{
	Bool old_silent, usb_paused = FALSE;
	I64 errs;

	WinMax;
	// Silent + DocClear avoid the DolDoc blow-up that GPFd the old overlay.
	"Auto ISO stage 3: overlaying C:/Tmp/OSBuild -> C:/\n";
	if (sys_usb_input_active)
	{
		try
		{
			UsbPollPause;
			usb_paused = TRUE;
		}
		catch
			Fs->catch_except = TRUE;
	}
	old_silent = Silent;
	CopyTree("C:/Tmp/OSBuild/", "C:/");
	Silent(old_silent);
	DocClear;
	DocBottom;
	"OSBuild overlay complete.\n";
	if (usb_paused)
	{
		try
			UsbPollPause(FALSE);
		catch
			Fs->catch_except = TRUE;
	}
	"AutoISO stage 3: Comp Compiler + Kernel...\n";
	errs = Comp("/Compiler/Compiler", "Compiler",, ':');
	if (errs)
	{
		"$$RED$$AutoISO stage 3 Comp Compiler failed errs=%d; stopping.$$FG$$\n", errs;
		while (TRUE)
			Sleep(1000);
	}
	errs = Comp("/Kernel/Kernel", "Kernel",, ':');
	if (errs)
	{
		"$$RED$$AutoISO stage 3 Comp Kernel failed errs=%d; stopping.$$FG$$\n", errs;
		while (TRUE)
			Sleep(1000);
	}
	BootHDIns;
	Del("C:/Home/AutoISOStage3.DD",, FALSE, FALSE);
	FileWrite("C:/Home/AutoISOStage4.DD", "4", 1);
	DelTree("C:/Tmp/OSBuild");
	"AutoISO stage 3 ok; BootRAM to stage 4.\n";
	BootRAM("C:/Boot/Kernel.ZXE");
}
Auto;
