#include "/System/Boot/MakeBoot"

U0 Auto()
{
	Bool old_silent;

	WinMax;
	// Overlay OSBuild then BootHDIns. No StdIn queue; no UsbPollPause.
	"Auto ISO stage 3: overlaying C:/Tmp/OSBuild -> C:/\n";
	old_silent = Silent;
	CopyTree("C:/Tmp/OSBuild/", "C:/");
	Silent(old_silent);
	DocClear;
	DocBottom;
	"OSBuild overlay complete.\n";
	BootHDIns('C');
	FileWrite("C:/Home/AutoISOStage4.DD", "4", 1);
	DelTree("C:/Tmp/OSBuild");
	"AutoISO stage 3 ok; Reboot to stage 4.\n";
	Reboot;
}
Auto;
