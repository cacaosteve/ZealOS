U0 Auto()
{
	Bool old_silent;

	WinMax;
	// Overlay OSBuild, then compile during the next early-boot pass.
	"Auto ISO stage 3: overlaying C:/Tmp/OSBuild -> C:/\n";
	old_silent = Silent;
	CopyTree("C:/Tmp/OSBuild/", "C:/");
	Silent(old_silent);
	DocClear;
	DocBottom;
	"OSBuild overlay complete.\n";
	FileWrite("C:/Home/AutoISORebuildStage3.DD", "3", 1);
	FileWrite("C:/Home/BootInsPending.DD", "1", 1);
	"AutoISO stage 3 staged; rebooting for early compile.\n";
	Reboot;
}
Auto;
