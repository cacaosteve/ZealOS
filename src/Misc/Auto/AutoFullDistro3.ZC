U0 AutoISOCopyDir(U8 *src_mask, U8 *dst)
{
	Silent(OFF);
	DocClear;
	"AutoISO stage 3: %s\n", dst;
	Silent(ON);
	DirMake(dst);
	Copy(src_mask, dst);
}

U0 Auto()
{
	Bool old_silent;

	WinMax;
	"Auto ISO stage 3: overlaying staged files one directory at a time...\n";
	old_silent = Silent(ON);

	// Avoid recursive FilesFind trees in the 1 GiB rebuild VM.
	Copy("C:/Tmp/OSBuild/*", "C:/");
	AutoISOCopyDir("C:/Tmp/OSBuild/Apps/*", "C:/Apps/");
	AutoISOCopyDir("C:/Tmp/OSBuild/Apps/Budget/*", "C:/Apps/Budget/");
