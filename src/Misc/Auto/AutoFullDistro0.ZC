U0 Auto()
{
	WinMax;
	if (FileFind("C:/Home/AutoISOStage0.DD"))
		Del("C:/Home/AutoISOStage0.DD");
	FileWrite("C:/Home/AutoISOStage1.DD", "1", 1);
	// First QEMU (AUTO.ISO): no OSBuild yet -> exit so the host can copy src/.
	// Second QEMU: host already staged Tmp/OSBuild -> must NOT OutU8 or the
	// rebuild aborts before Comp and MyDistro.ISO.C is never made.
	if (FileFind("/Tmp/OSBuild/Misc/Auto/AutoFullDistro1.ZC"))
	{
		"AutoISO stage 0: OSBuild present; rebooting to stage 1.\n";
		Reboot;
	}
	if (FileFind("/Tmp/OSBuild"))
	{
		"AutoISO stage 0: OSBuild dir present; Reboot to stage 1.\n";
		Reboot;
	}
	"AutoISO stage 0: exiting QEMU for host OSBuild copy.\n";
	OutU8(0x501,0x31);
}
Auto;
