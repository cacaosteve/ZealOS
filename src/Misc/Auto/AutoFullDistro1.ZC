U0 Auto()
{
	WinMax;
	// Stage1 must NOT BootHDIns. A half-updated Kernel tree (new KernelA /
	// DiskDrive / KConfig over AUTO.ISO sources) can leave Comp hung after
	// Compiler succeeds ΓÇö hours at 100% CPU with the same Errs:0 screen.
	// SYS_LIVE_* stubs in KernelB no longer require a Stage1 Kernel.ZXE grow.
	// Stage2 CopyTree + BootHDIns does the one full rebuild.
	Copy("C:/Tmp/OSBuild/Kernel/KStart16.ZC", "C:/Kernel/");
	Copy("C:/Tmp/OSBuild/Kernel/KernelA.HH", "C:/Kernel/");
	Copy("C:/Tmp/OSBuild/Kernel/KConfig.ZC", "C:/Kernel/");
	Copy("C:/Tmp/OSBuild/Kernel/BlkDev/DiskDrive.ZC", "C:/Kernel/BlkDev/");
	Copy("C:/Tmp/OSBuild/Kernel/KDefine.ZC", "C:/Kernel/");
	Del("C:/Home/AutoISOStage1.DD",, FALSE, FALSE);
	FileWrite("C:/Home/AutoISOStage2.DD", "2", 1);
	"AutoISO stage 1: staged Kernel headers; rebooting to stage 2.\n";
	Reboot;
}
Auto;
