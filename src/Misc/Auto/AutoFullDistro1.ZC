U0 Auto()
{
	I64			 i, ata_port = -1;
	CAHCIPort	*port;
	U8			*in_str;

	for (i = 0; i < AHCI_MAX_PORTS; i++)
	{
		if (PCIBt(&blkdev.ahci_hba->ports_implemented, i))
		{
			port = &blkdev.ahci_hba->ports[i];
			if (port->signature == AHCI_PxSIG_ATA)
			{
				ata_port = i;
				break;
			}
		}
	}

	WinMax;
	CopyTree("C:/Tmp/OSBuild/", "C:/");
	in_str = MStrPrint("CC\n%d\n\n\n\n", ata_port);
	Sleep(700);
	In(in_str);
	//BootHDIns catches compiler exceptions internally and would otherwise
	//reboot the AUTO disk with its old kernel, hiding the first incompatible
	//source location.  Compile once outside that catch so the host build stops
	//at the real bootstrap boundary instead of failing later in StartOS.
	"Bootstrap compile preflight...\n";
	MakeAll;
	"Bootstrap compile preflight complete.\n";
	BootHDIns;
	OnceFlush;
	Free(in_str);
	OnceDrive('C', "#include \"/Misc/Auto/AutoFullDistro4\";;Auto;;");
	//build-iso.sh removes OSBuild; FAT32 Del corrupts cluster chains.
	Reboot;
}
Auto;
