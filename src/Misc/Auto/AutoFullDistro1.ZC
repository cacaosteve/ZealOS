U0 Auto()
{
	WinMax;
	// Advance markers and Reboot. Do not ExeFile Stage2 in-process: nested
	// #include while Auto() is running has LexExcept'd inside Stage2 under
	// AUTO.ISO JIT. BootMHD2.BIN is host-patched to auto-select Drive C.
	if (FileFind("C:/Home/AutoISOStage1.DD"))
		Del("C:/Home/AutoISOStage1.DD");
	FileWrite("C:/Home/AutoISOStage2.DD", "2", 1);
	"AutoISO stage 1 ok; rebooting to stage 2.\n";
	Reboot;
}
Auto;
