U0 Auto()
{
	WinMax;
	// Advance to Stage2 and Reboot so StartOS re-reads stage markers.
	// Do not ExeFile Stage2 here: nested Comp under ExeFile + BootRAM made
	// failures hard to see and skipped a clean StartOS stage dispatch.
	Del("C:/Home/AutoISOStage1.DD",, FALSE, FALSE);
	FileWrite("C:/Home/AutoISOStage2.DD", "2", 1);
	"AutoISO stage 1 ok; rebooting to stage 2.\n";
	Reboot;
}
Auto;
