U0 Auto()
{
	I64 i, ata_port = 0;
	CAHCIPort *port;
	U8 *in_str;

	WinMax;
	// Match master: feed KConfig answers via In() before BootHDIns/MakeAll.
	// Bare Comp/BootHDIns without In() hangs headless on Kernel config prompts
	// (seen as multi-hour QEMU with no MyDistro.ISO.C).
	// No BootMHDIns ΓÇö host already patched Boot/BootMHD2.BIN to auto-pick C.
	"AutoISO stage 2: CopyTree Kernel + BootHDIns...\n";
	CopyTree("C:/Tmp/OSBuild/Kernel/", "C:/Kernel/");
	if (blkdev.ahci_hba)
	{
		for (i = 0; i < AHCI_MAX_PORTS; i++)
		{
			if (PCIBt(&blkdev.ahci_hba->ports_implemented, i))
			{
				port = &blkdev.ahci_hba->ports[i];
				if (port->signature == AHCI_PxSIG_ATA)
				{
					ata_port = i;
					break;
				}
			}
		}
	}
	in_str = MStrPrint("CC\n%d\n\n\n\n", ata_port);
	Sleep(700);
	In(in_str);
	BootHDIns;
	Free(in_str);
	FileWrite("C:/Home/AutoISOStage3.DD", "3", 1);
	"AutoISO stage 2 ok; Reboot to stage 3.\n";
	Reboot;
}
Auto;
