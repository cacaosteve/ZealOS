U0 Auto()
{
	I64 errs;

	WinMax;
	// Comp first and stop on failure. AUTO.ISO BootHDIns swallows Comp errors,
	// so a bare BootHDIns after a failed Comp would still advance the stage.
	// BootHDInsPrebuilt is WIP-only ΓÇö not in AUTO.ISO System (Undefined Extern).
	"AutoISO stage 2: CopyTree Kernel + Comp + BootHDIns...\n";
	CopyTree("C:/Tmp/OSBuild/Kernel/", "C:/Kernel/");
	errs = Comp("/Compiler/Compiler", "Compiler",, ':');
	if (errs)
	{
		"$$RED$$AutoISO stage 2 Comp Compiler failed errs=%d; stopping.$$FG$$\n", errs;
		while (TRUE)
			Sleep(1000);
	}
	errs = Comp("/Kernel/Kernel", "Kernel",, ':');
	if (errs)
	{
		"$$RED$$AutoISO stage 2 Comp Kernel failed errs=%d; stopping.$$FG$$\n", errs;
		while (TRUE)
			Sleep(1000);
	}
	// Install boot record + move Kernel.ZXE. MakeAll inside runs again (harmless).
	BootHDIns;
	Del("C:/Home/AutoISOStage2.DD",, FALSE, FALSE);
	FileWrite("C:/Home/AutoISOStage3.DD", "3", 1);
	"AutoISO stage 2 ok; rebooting to stage 3.\n";
	Reboot;
}
Auto;
