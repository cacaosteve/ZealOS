//Place this file in /Home and change
//anything you want.

Bool home_once_started = FALSE;

U0 UserStartUp()
{//Run each time a user a spawned
	DocTermNew;
	LBts(&Fs->display_flags, DISPLAYf_SHOW);
	WinToTop;
	WinZBufUpdate;
	if (sys_boot_src.u16[0] == BOOT_SRC_DVD)
	{
		Cd("::/Home");
		"Live ISO boot ready.\n";
		"USB boot: active=0x%X stage=%d\n", sys_usb_input_active, usb_debug_stage;
		"Run $$GREEN$$RunFile(\"::/Misc/OSInstall\");$$FG$$ to install.\n\n";
		return;
	}
	if (sys_boot_src.u16[0] == BOOT_SRC_RAM && SysLiveSizeGet())
	{
		Cd("::/Home");
		"Live USB (RAM) boot ready.\n";
		"USB boot: active=0x%X stage=%d live=%d MB\n",
				sys_usb_input_active, usb_debug_stage, SysLiveSizeGet() / 0x100000;
		"Run $$GREEN$$RunFile(\"::/Misc/OSInstall\");$$FG$$ to install.\n\n";
		return;
	}

	Type("::/Doc/Start.DD");
	Dir;
	if (!home_once_started)
	{
		home_once_started = TRUE;
		Cd("C:/Home");
		ExeFile("C:/Home/Once");
	}
}

U0 ServerStartUp()
{//Run each time a server task is spawned.
	DocTermNew;
	LBts(&Fs->display_flags, DISPLAYf_SHOW);
	WinToTop;
	WinZBufUpdate;
}

U0 StartUpTasks()
{
	CTask *user = User;

	if (sys_boot_src.u16[0] != BOOT_SRC_DVD &&
		!(sys_boot_src.u16[0] == BOOT_SRC_RAM && SysLiveSizeGet()))
		User;

	WinToTop(user);
	WinTileVert;
	"Boot Time:%7.3fs\n", tS;
	Silent; //no output to screen
	// ACInit disabled for USB bring-up (ACDWordsLoad was hitting Bad MAlloc at boot).
	// ACInit("/*;!*/Bible.TXT;!*/Clementine.TXT;!*/PCIDevices.DD;!*/HTML/*;!*/ChangeLog.DD");
	Silent(OFF); //no output to screen

	// ZSplash disabled (was PopUp after full boot; see ::/System/ZSplash.ZC)
}

StartUpTasks;

"\n%s\n\n", sys_os_version_nice;
